---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const mediaItems = [
  "/clone-ig.png",
  "/shopify-clon.png", 
  "/spotifu.png",
  "/alejandro-big.jpg",
  "/clone-ig.png",
  "/shopify-clon.png",
  "/spotifu.png",
  "/alejandro-big.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Ashesi Law and Humanities Newsletter
      </h1>
      <p class="text-lg text-neutral">
        Editorial Team Member - Writing articles and ensuring content quality for publication.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Role Overview</h2>
        <p class="text-neutral">As part of the editorial team for the Ashesi Law and Humanities Newsletter, I contribute to creating engaging content that explores legal and humanities topics relevant to the student community. My responsibilities include writing articles, editing submissions, and ensuring the overall quality of the publication.</p>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Newsletter media ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Contributions</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Research and write articles on legal and humanities topics</li>
          <li>Edit and proofread content from other contributors</li>
          <li>Ensure factual accuracy and academic integrity</li>
          <li>Collaborate with the editorial team on theme development</li>
          <li>Maintain consistent tone and style across publications</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href="#" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          Read Latest Issue
        </a>
        <a href="#contact" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Contribute Article
        </a>
      </div>
    </div>
  </article>
</Layout>