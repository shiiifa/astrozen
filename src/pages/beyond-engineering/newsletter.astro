---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Ashesi Law and Humanities Newsletter
      </h1>
    </header>

    <div class="prose prose-invert max-w-none text-center">
      <p class="text-neutral text-lg">
        As part of the editorial team for the Ashesi Law and Humanities Newsletter, I contribute to creating engaging content that explores legal and humanities topics relevant to the student community. My responsibilities include writing articles, editing submissions, and ensuring the overall quality of the publication.
      </p>
    </div>
  </article>
</Layout>