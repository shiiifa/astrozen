---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const mediaItems = [
  "/clone-ig.png",
  "/shopify-clon.png", 
  "/spotifu.png",
  "/alejandro-big.jpg",
  "/clone-ig.png",
  "/shopify-clon.png",
  "/spotifu.png",
  "/alejandro-big.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Sage Literacy Foundation
      </h1>
      <p class="text-lg text-neutral">
        Founder - Donating books and organizing educational workshops for schools.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Foundation Overview</h2>
        <p class="text-neutral">Sage Literacy Foundation is an initiative I founded to promote literacy and education in underserved communities. Through book donations and educational workshops, we aim to provide resources and opportunities for students to develop their reading and language skills.</p>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Sage Foundation media ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Initiatives & Impact</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Book donations to Nagie's Angels Educational Centre in Kumasi</li>
          <li>One-week English Language workshop at Labadi Presby/Emmause JHS</li>
          <li>Ongoing literacy programs in multiple schools</li>
          <li>Partnerships with local educational institutions</li>
          <li>Community engagement and volunteer coordination</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href="#contact" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          Donate Books
        </a>
        <a href="#contact" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Volunteer
        </a>
      </div>
    </div>
  </article>
</Layout>