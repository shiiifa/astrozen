---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

// Display photos for Sage Foundation
const displayPhotos = [
  "/sage1.jpg",
  "/sage2.jpg", 
  "/sage3.jpg",
  "/sage4.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Sage Literacy Foundation
      </h1>
      <p class="text-lg text-neutral">
        Founder - Donating books and organizing educational workshops for schools.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      {/* Display Photos Gallery */}
      <div class="mb-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {displayPhotos.map((photo, index) => (
            <div class="overflow-hidden rounded-lg border border-neutral/20">
              <Image
                src={photo}
                alt={`Sage Literacy Foundation initiative ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>

      <section class="mb-12 text-center">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Foundation Overview</h2>
        <p class="text-neutral">Sage Literacy Foundation is an initiative I founded at age 13, to promote literacy and education in underserved communities. Through book donations and educational workshops, we aim to provide resources and opportunities for students to develop their reading and language skills.</p>
      </section>

      <section class="mb-12 text-center">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Initiatives & Impact</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Book donations to Nagie's Angels Educational Centre in Kumasi</li>
          <li>One-week English Language workshop at Labadi Presby/Emmause JHS</li>
          <li>Community engagement and volunteer coordination</li>
        </ul>
      </section>

      <div class="flex justify-center">
        <a href="https://instagram.com/sageliteracyfoundation" target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          Follow on Instagram
        </a>
      </div>
    </div>
  </article>
</Layout>