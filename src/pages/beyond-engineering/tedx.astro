---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      {/* Cover Photo */}
      <div class="mb-8 rounded-2xl overflow-hidden">
        <Image
          src="/tedx1.jpg"
          alt="TEDxAshesiUniversity Curator"
          width={800}
          height={400}
          class="w-full h-64 object-cover"
        />
      </div>
      
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        TEDxAshesiUniversity Curator
      </h1>
      <p class="text-lg text-neutral">
        Guide speakers in composing and refining their speeches to ensure impactful and engaging presentations.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Role Overview</h2>
        <p class="text-neutral">As a curator for TEDxAshesiUniversity, I work closely with speakers to develop and refine their ideas into compelling TED-style talks. This involves guiding them through the process of storytelling, message structuring, and delivery techniques to create presentations that inspire and engage audiences.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Responsibilities</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Mentor speakers in speech composition and narrative development</li>
          <li>Provide feedback on content structure and delivery style</li>
          <li>Ensure talks align with TEDx standards and themes</li>
          <li>Coordinate rehearsal sessions and provide performance coaching</li>
          <li>Collaborate with the organizing team on event planning</li>
        </ul>
      </section>
    </div>
  </article>
</Layout>