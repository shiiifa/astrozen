---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <div class="mb-8">
      <a href="/" class="inline-flex items-center text-primary hover:text-white transition-colors">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Home
      </a>
    </div>

    <header class="mb-12 text-center">
      <div class="mb-8">
        <img
          src="/ieeeashesi.png"
          alt="IEEE Ashesi Social Media Manager"
          class="w-full max-w-4xl mx-auto h-64 object-cover rounded-2xl border border-neutral/20"
        />
      </div>
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        IEEE Ashesi Social Media Manager
      </h1>
      <p class="text-lg text-neutral">
        Managing communications, publicity, and digital presence for the student-led IEEE Ashesi chapter—producing promotional posts, editing videos, and driving engagement across chapter events.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Role Overview</h2>
        <p class="text-neutral leading-relaxed mb-4">
          As Social Media Manager for IEEE Ashesi, I manage the chapter's digital presence and day-to-day engagement. My work includes posting pictures, editing videos, and responding to community interaction across our social channels.
        </p>
        <p class="text-neutral leading-relaxed">
          I also manage communications and publicity for the student-led chapter, producing promotional posts that support multiple chapter events and help keep members and the wider campus informed.
        </p>
      </section>
    </div>
  </article>
</Layout>
