---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        comma, period.
      </h1>
      <p class="text-lg text-neutral">
        A blog where I share thinkpieces, thoughts, and personal experiences through writing.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      {/* Blog Photo Display Tile */}
      <div class="mb-12 text-center">
        <div class="inline-block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30 max-w-md">
          <Image
            src="/cmmprd2.jpg"
            alt="comma, period. - Personal Blog"
            width={400}
            height={300}
            class="w-full h-64 object-cover"
          />
        </div>
      </div>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Writing Journey</h2>
        <p class="text-neutral">As a lover of words and writing, "comma, period." is my favorite escape medium to explore and navigate various thoughts on my mind. This personal blog serves as a creative sanctuary where I delve into reflections, analyze ideas, and share perspectives through the art of written expression. Each piece represents a moment of introspection and discovery in my ongoing journey with words.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Writing Focus Areas</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Personal essays and reflections</li>
          <li>Social commentary and analysis</li>
          <li>Technology and innovation insights</li>
          <li>Educational and developmental topics</li>
          <li>Creative non-fiction and storytelling</li>
        </ul>
      </section>

      <div class="flex justify-center">
        <a href="https://shiiifa.substack.com" target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          Read Blog
        </a>
      </div>
    </div>
  </article>
</Layout>