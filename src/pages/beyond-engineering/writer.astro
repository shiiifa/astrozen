---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const mediaItems = [
  "/clone-ig.png",
  "/shopify-clon.png", 
  "/spotifu.png",
  "/alejandro-big.jpg",
  "/clone-ig.png",
  "/shopify-clon.png",
  "/spotifu.png",
  "/alejandro-big.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Writer, Comma Period
      </h1>
      <p class="text-lg text-neutral">
        A blog where I share thinkpieces, thoughts, and personal experiences through writing.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Writing Journey</h2>
        <p class="text-neutral">Comma Period is my personal blog where I explore various topics through writing. From personal reflections to analytical thinkpieces, this platform allows me to share my perspectives, experiences, and insights with a wider audience while honing my writing skills.</p>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Writing media ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Writing Focus Areas</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Personal essays and reflections</li>
          <li>Social commentary and analysis</li>
          <li>Technology and innovation insights</li>
          <li>Educational and developmental topics</li>
          <li>Creative non-fiction and storytelling</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href="#" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          Read Blog
        </a>
        <a href="#contact" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Guest Post
        </a>
      </div>
    </div>
  </article>
</Layout>