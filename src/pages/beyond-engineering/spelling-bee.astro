---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

// Media files for Spelling Bee
const mediaItems = [
  "/spelling1.jpg",
  "/spelling2.jpg", 
  "/spelling3.jpg",
  "/spelling4.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      {/* Cover Photo */}
      <div class="mb-8 rounded-2xl overflow-hidden">
        <Image
          src="/spelling1.jpg"
          alt="The Spelling Bee, Ghana - Volunteer"
          width={800}
          height={400}
          class="w-full h-64 object-cover"
        />
      </div>
      
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        The Spelling Bee, Ghana - Volunteer
      </h1>
      <p class="text-lg text-neutral">
        As a volunteer for The Spelling Bee Ghana, I serve on the judges' panel as a recorder during seasonal competitions. My role involves ensuring accurate documentation of spellers' words and minimizing scoring discrepancies.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Volunteer Role</h2>
        <p class="text-neutral">As a volunteer for The Spelling Bee Ghana, I serve on the judges' panel as a recorder during seasonal competitions. My role involves ensuring accurate documentation of spellers' words and minimizing scoring discrepancies, while also helping maintain a positive atmosphere for participants.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Responsibilities</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Accurate documentation of spelled words and scores</li>
          <li>Minimizing scoring discrepancies and errors</li>
          <li>Interacting with spellers before they step on-stage</li>
          <li>Maintaining orderly competition atmosphere</li>
          <li>Supporting judges with administrative tasks</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Spelling Bee event photo ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>