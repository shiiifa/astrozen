---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    {/* Back Arrow */}
    <div class="mb-8">
      <a href="/" class="inline-flex items-center text-primary hover:text-white transition-colors">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Home
      </a>
    </div>

    <header class="mb-12 text-center">
      <div class="mb-8">
        <img 
          src="/spelling1.jpg" 
          alt="The Spelling Bee, Ghana - Volunteer" 
          class="w-full max-w-4xl mx-auto h-64 object-cover rounded-2xl border border-neutral/20"
        />
      </div>
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        The Spelling Bee, Ghana - Volunteer
      </h1>
      <p class="text-lg text-neutral">
        As a past champion and volunteer for The National Spelling Bee Ghana, I've taken on a range of roles supporting the organisation, from serving on the judges' panel during seasonal competitions, to managing communications and coordinating training sessions, to contributing to the 20th Anniversary Steering Committee as part of the Alumni & Legacy Team.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">

      {/* Additional Gallery Photos */}
      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-primary">Media</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="relative overflow-hidden rounded-lg cursor-pointer" onclick="openImageModal('/spelling2.jpg', 'Spelling Bee event photo 2')">
            <img src="/spelling2.jpg" alt="Spelling Bee event photo 2" class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" />
          </div>
          <div class="relative overflow-hidden rounded-lg cursor-pointer" onclick="openImageModal('/spelling3.jpg', 'Spelling Bee event photo 3')">
            <img src="/spelling3.jpg" alt="Spelling Bee event photo 3" class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" />
          </div>
          <div class="relative overflow-hidden rounded-lg cursor-pointer" onclick="openImageModal('/spelling4.jpg', 'Spelling Bee event photo 4')">
            <img src="/spelling4.jpg" alt="Spelling Bee event photo 4" class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" />
          </div>
        </div>
      </section>

      {/* Relevant Links */}
      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-primary">Relevant Links</h2>
        <div class="flex gap-6 items-center justify-center">
          {/* Scripps Spelling Bee */}
          <a 
            href="https://www.spellingbee.com/node/1495" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg p-3 transition-all duration-300 hover:scale-110"
            aria-label="Scripps National Spelling Bee"
          >
            <svg class="w-16 h-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Bee icon on yellow background */}
              <circle cx="50" cy="50" r="45" fill="#E1AD01"/>
              {/* Bee body */}
              <ellipse cx="50" cy="50" rx="15" ry="20" fill="#000"/>
              {/* Bee stripes */}
              <ellipse cx="50" cy="45" rx="12" ry="4" fill="#E1AD01"/>
              <ellipse cx="50" cy="55" rx="12" ry="4" fill="#E1AD01"/>
              {/* Wings */}
              <ellipse cx="40" cy="45" rx="8" ry="12" fill="#fff" opacity="0.7"/>
              <ellipse cx="60" cy="45" rx="8" ry="12" fill="#fff" opacity="0.7"/>
              {/* Antenna */}
              <circle cx="45" cy="35" r="3" fill="#000"/>
              <circle cx="55" cy="35" r="3" fill="#000"/>
              <line x1="45" y1="35" x2="42" y2="28" stroke="#000" stroke-width="2" stroke-linecap="round"/>
              <line x1="55" y1="35" x2="58" y2="28" stroke="#000" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </a>

          {/* CNN */}
          <a 
            href="https://cnn.it/2mnhng1" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg p-3 transition-all duration-300 hover:scale-110"
            aria-label="CNN African Voices"
          >
            <svg class="w-16 h-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* CNN red box */}
              <rect x="10" y="30" width="80" height="40" rx="3" fill="#CC0000"/>
              {/* CNN text */}
              <text x="50" y="58" font-family="Arial Black, Arial, sans-serif" font-size="36" font-weight="900" fill="#fff" text-anchor="middle" letter-spacing="2">CNN</text>
            </svg>
          </a>

          {/* Wikipedia */}
          <a 
            href="https://en.wikipedia.org/wiki/The_Spelling_Bee#History-making_Spellers" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg p-3 transition-all duration-300 hover:scale-110"
            aria-label="Wikipedia"
          >
            <svg class="w-16 h-16" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Wikipedia globe - puzzle pieces */}
              <circle cx="50" cy="50" r="42" fill="#000" stroke="#fff" stroke-width="1"/>
              {/* Puzzle pieces representing globe */}
              <path d="M 25 30 Q 50 25 75 30 Q 75 50 65 65 Q 50 70 35 65 Q 25 50 25 30 Z" fill="#fff" opacity="0.3"/>
              <path d="M 75 30 Q 75 50 75 70 Q 65 75 50 75 Q 65 65 75 50 Z" fill="#fff" opacity="0.2"/>
              <path d="M 25 30 Q 35 20 50 20 Q 65 20 75 30" stroke="#fff" stroke-width="2" fill="none"/>
              {/* Wikipedia W */}
              <text x="50" y="70" font-family="Georgia, serif" font-size="50" font-weight="bold" fill="#fff" text-anchor="middle">W</text>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </article>

  <!-- Image Modal -->
  <div id="imageModal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="relative max-w-4xl max-h-[90vh]">
        <button 
          id="closeModal" 
          class="absolute -top-12 right-0 text-white hover:text-primary transition-colors text-2xl font-bold z-10"
          onclick="closeImageModal()"
        >
          ✕
        </button>
        <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
      </div>
    </div>
  </div>

  <script>
    function openImageModal(src: string, alt: string) {
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage') as HTMLImageElement;
      
      if (!modal || !modalImage) return;
      
      modalImage.src = src;
      modalImage.alt = alt;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeImageModal() {
      const modal = document.getElementById('imageModal');
      if (!modal) return;
      
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    // Close modal when clicking outside the image
    const modalElement = document.getElementById('imageModal');
    if (modalElement) {
      modalElement.addEventListener('click', (e: Event) => {
        const target = e.target as HTMLElement;
        if (target && target.id === 'imageModal') {
          closeImageModal();
        }
      });
    }

    // Close modal with Escape key
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeImageModal();
      }
    });
  </script>
</Layout>