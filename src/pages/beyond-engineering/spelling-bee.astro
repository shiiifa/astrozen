---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        The Spelling Bee, Ghana - Volunteer
      </h1>
      <p class="text-lg text-neutral">
        As a volunteer for The Spelling Bee Ghana, I serve on the judges' panel as a recorder during seasonal competitions. My role involves ensuring accurate documentation of spellers' words and minimizing scoring discrepancies.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      {/* Spelling Bee Photo Display Tile */}
      <div class="mb-12 text-center">
        <div class="inline-block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30 max-w-md">
          <Image
            src="/spelling1.jpg"
            alt="The Spelling Bee, Ghana - Volunteer"
            width={400}
            height={300}
            class="w-full h-64 object-cover"
          />
        </div>
      </div>
    </div>
  </article>
</Layout>