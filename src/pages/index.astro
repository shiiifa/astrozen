---
import Section from "@components/Section.astro";
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import About from "@components/About.astro";
import Connect from "@components/Connect.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

// Beyond Engineering data
const beyondEngineeringItems = [
  {
    name: "TEDxAshesiUniversity Curator",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/tedx"
  },
  {
    name: "Newsletter Editorial Team", 
    image: "/shopify-clon.png",
    linkPreview: "/beyond-engineering/newsletter"
  },
  {
    name: "Spelling Bee Volunteer",
    image: "/spotifu.png",
    linkPreview: "/beyond-engineering/spelling-bee"
  },
  {
    name: "Sage Literacy Foundation",
    image: "/alejandro-big.jpg",
    linkPreview: "/beyond-engineering/sage-foundation"
  },
  {
    name: "Writer, Comma Period",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/writer"
  }
];
---

<Layout>
  {/* PROFILE SECTION AT THE VERY TOP */}
  <Section text="Profile" href="profile">
    <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  </Section>
  
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <Skills skills={SITE_CONTENT.skills} />
  
  <!-- BEYOND ENGINEERING SECTION WITH ARROWS & TOUCH -->
  <Section text="Beyond Engineering" href="beyond-engineering">
    <div class="relative">
      {/* Navigation Arrows */}
      <button id="beyondPrevBtn" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button id="beyondNextBtn" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Beyond Engineering Container with touch support */}
      <div id="beyondContainer" class="flex overflow-x-hidden scroll-smooth space-x-6 py-4 cursor-grab active:cursor-grabbing">
        {
          beyondEngineeringItems.map(({ name, image, linkPreview }) => (
            <a
              href={linkPreview}
              class="group relative flex-shrink-0 w-64 h-64 overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
            >
              <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
              
              <div class="relative z-10 w-full h-full">
                <Image
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  src={image}
                  alt={name}
                  width={256}
                  height={256}
                  loading="lazy"
                />
              </div>
              
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
              
              <span class="sr-only">{name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </Section>
  
  <Connect socialLinks={SITE_CONFIG.socialLinks} />
</Layout>

<style>
  /* Hide scrollbar but keep functionality */
  #beyondContainer {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  #beyondContainer::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const beyondContainer = document.getElementById('beyondContainer');
    const beyondPrevBtn = document.getElementById('beyondPrevBtn');
    const beyondNextBtn = document.getElementById('beyondNextBtn');
    const beyondItemWidth = 256 + 24; // Width + gap

    if (!beyondContainer || !beyondPrevBtn || !beyondNextBtn) return;

    // Scroll to next item
    beyondNextBtn.addEventListener('click', () => {
      beyondContainer.scrollBy({ left: beyondItemWidth, behavior: 'smooth' });
    });

    // Scroll to previous item
    beyondPrevBtn.addEventListener('click', () => {
      beyondContainer.scrollBy({ left: -beyondItemWidth, behavior: 'smooth' });
    });

    // Hide arrows when at edges
    const checkBeyondArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = beyondContainer;
      beyondPrevBtn.style.opacity = scrollLeft > 0 ? '1' : '0.5';
      beyondNextBtn.style.opacity = scrollLeft < scrollWidth - clientWidth - 10 ? '1' : '0.5';
    };

    beyondContainer.addEventListener('scroll', checkBeyondArrows);
    checkBeyondArrows(); // Initial check

    // Touch swipe functionality
    let startX;
    let scrollLeft;

    beyondContainer.addEventListener('touchstart', (e) => {
      startX = e.touches[0].pageX - beyondContainer.offsetLeft;
      scrollLeft = beyondContainer.scrollLeft;
      beyondContainer.style.scrollBehavior = 'auto'; // Disable smooth scroll during swipe
    });

    beyondContainer.addEventListener('touchmove', (e) => {
      if (!startX) return;
      const x = e.touches[0].pageX - beyondContainer.offsetLeft;
      const walk = (x - startX) * 2; // Scroll-fast factor
      beyondContainer.scrollLeft = scrollLeft - walk;
    });

    beyondContainer.addEventListener('touchend', () => {
      startX = null;
      beyondContainer.style.scrollBehavior = 'smooth'; // Re-enable smooth scroll
    });

    // Mouse drag functionality for desktop
    let isDown = false;
    let startXMouse;
    let scrollLeftMouse;

    beyondContainer.addEventListener('mousedown', (e) => {
      isDown = true;
      beyondContainer.style.cursor = 'grabbing';
      startXMouse = e.pageX - beyondContainer.offsetLeft;
      scrollLeftMouse = beyondContainer.scrollLeft;
      beyondContainer.style.scrollBehavior = 'auto';
    });

    beyondContainer.addEventListener('mouseleave', () => {
      isDown = false;
      beyondContainer.style.cursor = 'grab';
    });

    beyondContainer.addEventListener('mouseup', () => {
      isDown = false;
      beyondContainer.style.cursor = 'grab';
      beyondContainer.style.scrollBehavior = 'smooth';
    });

    beyondContainer.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - beyondContainer.offsetLeft;
      const walk = (x - startXMouse) * 2;
      beyondContainer.scrollLeft = scrollLeftMouse - walk;
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        beyondContainer.scrollBy({ left: -beyondItemWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        beyondContainer.scrollBy({ left: beyondItemWidth, behavior: 'smooth' });
      }
    });
  });
</script>