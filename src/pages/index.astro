---
import Section from "@components/Section.astro";
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import About from "@components/About.astro";
import Connect from "@components/Connect.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

// Beyond Engineering data
const beyondEngineeringItems = [
  {
    name: "TEDxAshesiUniversity Curator",
    image: "/tedx5.jpg",
    linkPreview: "/beyond-engineering/tedx"
  },
  {
    name: "Leadership Speech Competition Finalist",
    image: "/speech2.jpg",
    linkPreview: "/beyond-engineering/leadership-speech-competition"
  },
  {
    name: "Spelling Bee Volunteer",
    image: "/spelling1.jpg",
    linkPreview: "/beyond-engineering/spelling-bee"
  },
  {
    name: "BGILD Summer Institute Speaker",
    image: "/BGILD.png",
    linkPreview: "/beyond-engineering/bgild-summer-institute"
  },
  {
    name: "IEEE Ashesi Social Media Manager",
    image: "/ieeeashesi.png",
    linkPreview: "/beyond-engineering/ieee-ashesi"
  },
  {
    name: "Sage Literacy Foundation",
    image: "/sage4.jpg",
    linkPreview: "/beyond-engineering/sage-foundation"
  },
  {
    name: "Newsletter Editorial Team", 
    image: "/newsletter1.jpg",
    linkPreview: "/beyond-engineering/newsletter"
  },
  {
    name: "Writer, Comma Period",
    image: "/cmmprd1.jpg",
    linkPreview: "/beyond-engineering/writer"
  }
];
---

<Layout>
  {/* THE ABOUT SECTION AT THE VERY TOP - NO HEADING BUT WITH ANCHOR */}
  <div id="profile" class="relative left-1/2 w-screen max-w-5xl -translate-x-1/2 px-5 pt-12">
    <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  </div>
  
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <Skills skills={SITE_CONTENT.skills} />
  
  <!-- BEYOND ENGINEERING SECTION -->
  <Section text="beyond engineering" href="beyond-engineering">
    <div class="relative">
      {/* Navigation Arrows */}
      <button type="button" id="beyondPrevBtn" aria-label="Previous items" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-opacity duration-200 touch-manipulation backdrop-blur-sm border border-primary/10 disabled:opacity-40 disabled:pointer-events-none max-sm:hidden" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button type="button" id="beyondNextBtn" aria-label="Next items" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-opacity duration-200 touch-manipulation backdrop-blur-sm border border-primary/10 disabled:opacity-40 disabled:pointer-events-none max-sm:hidden" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Beyond Engineering Container */}
      <div 
        id="beyondContainer" 
        class="flex overflow-x-auto space-x-3 sm:space-x-6 py-4 cursor-grab active:cursor-grabbing select-none snap-x snap-mandatory max-sm:-mx-4 max-sm:px-4"
        style="touch-action: pan-x; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none;"
      >
        {
          beyondEngineeringItems.map(({ name, image, linkPreview }) => (
            <div class="group relative flex-shrink-0 w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20 snap-center">
              <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
              
              <a href={linkPreview} class="relative z-20 block w-full h-full" draggable="false">
                <Image
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer"
                  src={image}
                  alt={name}
                  width={256}
                  height={256}
                  loading="lazy"
                  draggable="false"
                />
              </a>
              
              <div class="absolute inset-0 z-10 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100 pointer-events-none"></div>
              
              <span class="sr-only">{name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
  
  <Connect socialLinks={SITE_CONFIG.socialLinks} />

  <style>
    #beyondContainer::-webkit-scrollbar {
      display: none;
    }

    #beyondContainer.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }

    #beyondContainer.is-dragging a {
      pointer-events: none;
    }

    #beyondContainer > div:focus-within {
      outline: 2px solid #E1AD01;
      outline-offset: 2px;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const beyondContainer = document.getElementById('beyondContainer');
      const beyondPrevBtn = document.getElementById('beyondPrevBtn') as HTMLButtonElement | null;
      const beyondNextBtn = document.getElementById('beyondNextBtn') as HTMLButtonElement | null;

      if (!beyondContainer || !beyondPrevBtn || !beyondNextBtn) return;

      let animating = false;
      let unlockTimer: ReturnType<typeof setTimeout> | null = null;

      const getStep = () => {
        const item = beyondContainer.querySelector(':scope > *') as HTMLElement | null;
        if (!item) return 280;
        const styles = getComputedStyle(beyondContainer);
        const gap = parseFloat(styles.columnGap || styles.gap) || 24;
        return item.offsetWidth + gap;
      };

      const updateArrows = () => {
        const { scrollLeft, scrollWidth, clientWidth } = beyondContainer;
        const maxScroll = Math.max(0, scrollWidth - clientWidth);
        beyondPrevBtn.disabled = scrollLeft <= 2;
        beyondNextBtn.disabled = scrollLeft >= maxScroll - 2;
      };

      const scrollByStep = (direction: number) => {
        if (animating) return;
        const { scrollLeft, scrollWidth, clientWidth } = beyondContainer;
        const maxScroll = Math.max(0, scrollWidth - clientWidth);
        const step = getStep();
        const target = Math.max(0, Math.min(maxScroll, scrollLeft + direction * step));
        if (Math.abs(target - scrollLeft) < 1) return;

        animating = true;
        beyondContainer.scrollTo({ left: target, behavior: 'smooth' });

        const unlock = () => {
          animating = false;
          updateArrows();
          if (unlockTimer) clearTimeout(unlockTimer);
        };

        beyondContainer.addEventListener('scrollend', unlock, { once: true });
        if (unlockTimer) clearTimeout(unlockTimer);
        unlockTimer = setTimeout(unlock, 450);
      };

      beyondPrevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        scrollByStep(-1);
      });

      beyondNextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        scrollByStep(1);
      });

      let scrollRaf = 0;
      beyondContainer.addEventListener('scroll', () => {
        if (scrollRaf) return;
        scrollRaf = requestAnimationFrame(() => {
          scrollRaf = 0;
          updateArrows();
        });
      }, { passive: true });

      updateArrows();
      window.addEventListener('resize', updateArrows, { passive: true });

      // Mouse / pen drag-to-slide — only activates after a real drag threshold
      // so simple clicks on tiles still navigate.
      const DRAG_THRESHOLD = 8;
      let pointerActive = false;
      let dragging = false;
      let suppressClick = false;
      let startX = 0;
      let startScroll = 0;
      let pointerId: number | null = null;

      const snapToNearest = () => {
        const step = getStep();
        if (step <= 0) return;
        const index = Math.round(beyondContainer.scrollLeft / step);
        const maxScroll = Math.max(0, beyondContainer.scrollWidth - beyondContainer.clientWidth);
        const target = Math.max(0, Math.min(maxScroll, index * step));
        beyondContainer.scrollTo({ left: target, behavior: 'smooth' });
      };

      const beginDrag = (e: PointerEvent) => {
        dragging = true;
        suppressClick = true;
        beyondContainer.classList.add('is-dragging');
        try {
          beyondContainer.setPointerCapture(e.pointerId);
        } catch {
          // ignore capture failures
        }
      };

      const endPointer = () => {
        if (!pointerActive) return;
        const wasDragging = dragging;
        pointerActive = false;
        dragging = false;
        pointerId = null;
        beyondContainer.classList.remove('is-dragging');
        if (wasDragging) snapToNearest();
        updateArrows();
      };

      beyondContainer.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.pointerType === 'touch' || e.button !== 0) return;
        pointerActive = true;
        dragging = false;
        suppressClick = false;
        pointerId = e.pointerId;
        startX = e.clientX;
        startScroll = beyondContainer.scrollLeft;
      });

      beyondContainer.addEventListener('pointermove', (e: PointerEvent) => {
        if (!pointerActive || e.pointerId !== pointerId) return;
        const dx = e.clientX - startX;
        if (!dragging) {
          if (Math.abs(dx) < DRAG_THRESHOLD) return;
          beginDrag(e);
        }
        beyondContainer.scrollLeft = startScroll - dx;
      });

      beyondContainer.addEventListener('pointerup', endPointer);
      beyondContainer.addEventListener('pointercancel', endPointer);
      beyondContainer.addEventListener('lostpointercapture', () => {
        if (pointerActive) endPointer();
      });

      beyondContainer.addEventListener('click', (e: MouseEvent) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
      }, true);
    });
  </script>
</Layout>