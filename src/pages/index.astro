---
import Section from "@components/Section.astro";
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import About from "@components/About.astro";
import Connect from "@components/Connect.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

// Beyond Engineering data with circular tiles
const beyondEngineeringItems = [
  {
    name: "TEDx Curator",
    shortText: "TEDx",
    summary: "Guide speakers in composing and refining their speeches to ensure impactful and engaging presentations.",
    image: "/clone-ig.png",
    media: ["/clone-ig.png", "/shopify-clon.png", "/spotifu.png", "/alejandro-big.jpg"],
    link: "/beyond-engineering/tedx"
  },
  {
    name: "Newsletter Editor",
    shortText: "Editor",
    summary: "Editorial Team Member - Assist in preparing the official newsletter by writing articles and ensuring content quality before publication.",
    image: "/clone-ig.png",
    media: ["/clone-ig.png", "/shopify-clon.png", "/spotifu.png", "/alejandro-big.jpg"],
    link: "/beyond-engineering/newsletter"
  },
  {
    name: "Spelling Bee Volunteer",
    shortText: "Volunteer",
    summary: "Serve seasonally on the judges' panel as a recorder, ensuring accurate documentation and minimizing scoring discrepancies.",
    image: "/clone-ig.png",
    media: ["/clone-ig.png", "/shopify-clon.png", "/spotifu.png", "/alejandro-big.jpg"],
    link: "/beyond-engineering/spelling-bee"
  },
  {
    name: "Sage Foundation",
    shortText: "Founder",
    summary: "Donated books to schools and organized English Language workshops for educational development.",
    image: "/clone-ig.png",
    media: ["/clone-ig.png", "/shopify-clon.png", "/spotifu.png", "/alejandro-big.jpg"],
    link: "/beyond-engineering/sage-foundation"
  },
  {
    name: "Writer",
    shortText: "Writer",
    summary: "A blog where I share thinkpieces, thoughts, and personal experiences through writing.",
    image: "/clone-ig.png",
    media: ["/clone-ig.png", "/shopify-clon.png", "/spotifu.png", "/alejandro-big.jpg"],
    link: "/beyond-engineering/writer"
  }
];
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />
  
  <!-- PROFILE SECTION -->
  <Section text="Profile" href="profile">
    <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  </Section>
  
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <Skills skills={SITE_CONTENT.skills} />
  
  <!-- BEYOND ENGINEERING SECTION (Circular tiles with popups) -->
  <Section text="Beyond Engineering" href="beyond-engineering">
    <div class="flex flex-wrap justify-center gap-12 py-8">
      {
        beyondEngineeringItems.map((item, index) => (
          <div class="group relative flex flex-col items-center">
            {/* Circular Tile */}
            <div class="relative w-32 h-32 rounded-full overflow-hidden border-2 border-primary/20 transition-all duration-500 group-hover:border-primary/60 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-primary/20">
              <Image
                src={item.image}
                alt={item.name}
                width={128}
                height={128}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
            
            {/* Short Text Below Circle */}
            <p class="mt-4 text-sm font-medium text-white transition-colors duration-300 group-hover:text-primary">
              {item.shortText}
            </p>

            {/* Popup on Hover */}
            <div class="absolute top-full left-1/2 transform -translate-x-1/2 mt-6 w-80 bg-[#1c232d] border border-primary/30 rounded-2xl shadow-2xl shadow-primary/20 opacity-0 invisible transition-all duration-300 group-hover:opacity-100 group-hover:visible group-hover:translate-y-2 z-50">
              <div class="p-6">
                <h3 class="font-serif text-xl font-semibold text-primary mb-3">
                  {item.name}
                </h3>
                <p class="text-sm text-neutral mb-4">
                  {item.summary}
                </p>
                
                {/* Media Gallery Preview */}
                <div class="grid grid-cols-2 gap-2 mb-4">
                  {item.media.slice(0, 4).map((media, mediaIndex) => (
                    <Image
                      src={media}
                      alt={`${item.name} media ${mediaIndex + 1}`}
                      width={80}
                      height={80}
                      class="w-full h-20 object-cover rounded-lg border border-neutral/20"
                    />
                  ))}
                </div>
                
                {/* View More Link */}
                <a 
                  href={item.link}
                  class="inline-flex items-center gap-2 text-primary text-sm font-medium hover:text-white transition-colors"
                >
                  View Details
                  <span class="inline-block h-3 w-3 content-[url(/external.svg)]"></span>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>
  
  <Connect socialLinks={SITE_CONFIG.socialLinks} />
</Layout>

<style>
  /* Custom animations for circular tiles */
  .group:hover .rounded-full {
    transform: scale(1.1);
  }
  
  /* Ensure popup stays visible when hovering over it */
  .group .absolute {
    pointer-events: none;
  }
  
  .group:hover .absolute {
    pointer-events: auto;
  }
</style>