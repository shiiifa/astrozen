---
import Section from "@components/Section.astro";
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import About from "@components/About.astro";
import Connect from "@components/Connect.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

// Beyond Engineering data with tile layout
const beyondEngineeringItems = [
  {
    name: "CO-CURRICULAR ACTIVITIES",
    summary: "TEDxAshesiUniversity Curator • Ashesi Law and Humanities Newsletter Editorial Team • The Spelling Bee Volunteer • Sage Literacy Foundation Founder",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/co-curricular",
    linkSource: "#"
  },
  {
    name: "TEDxAshesiUniversity, Curator",
    summary: "Guide speakers in composing and refining their speeches to ensure impactful and engaging presentations.",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/tedx",
    linkSource: "#"
  },
  {
    name: "Ashesi Law and Humanities Newsletter",
    summary: "Editorial Team Member - Assist in preparing the official newsletter by writing articles and ensuring content quality before publication.",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/newsletter",
    linkSource: "#"
  },
  {
    name: "The Spelling Bee, Ghana",
    summary: "Volunteer - Serve seasonally on the judges' panel as a recorder, ensuring accurate documentation and minimizing scoring discrepancies.",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/spelling-bee",
    linkSource: "#"
  },
  {
    name: "Sage Literacy Foundation",
    summary: "Founder - Donated books to schools and organized English Language workshops for educational development.",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/sage-foundation",
    linkSource: "#"
  },
  {
    name: "Writer, Comma Period",
    summary: "A blog where I share thinkpieces, thoughts, and personal experiences through writing.",
    image: "/clone-ig.png",
    linkPreview: "/beyond-engineering/writer",
    linkSource: "#"
  }
];
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />
  
  <!-- PROFILE SECTION -->
  <Section text="Profile" href="profile">
    <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  </Section>
  
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <Skills skills={SITE_CONTENT.skills} />
  
  <!-- BEYOND ENGINEERING SECTION (Updated to tile layout) -->
  <Section text="Beyond Engineering" href="beyond-engineering">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        beyondEngineeringItems.map(({ name, summary, image, linkPreview, linkSource }) => (
          <a
            href={linkPreview}
            class="group relative block overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
          >
            {/* Background pattern */}
            <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
            
            {/* Content */}
            <div class="relative z-10 flex h-full flex-col p-6">
              {/* Image */}
              <div class="mb-6 overflow-hidden rounded-xl">
                <Image
                  class="h-48 w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  src={image}
                  alt={name}
                  width={400}
                  height={300}
                  loading="lazy"
                />
              </div>
              
              {/* Text Content */}
              <div class="flex flex-1 flex-col">
                <h3 class="mb-3 font-serif text-xl font-medium text-primary transition-colors duration-300 group-hover:text-white">
                  {name}
                </h3>
                <p class="mb-4 flex-1 text-sm text-neutral group-hover:text-white/80 transition-colors duration-300">
                  {summary}
                </p>
                
                {/* Links */}
                <div class="flex gap-4 pt-4 text-xs text-white/70">
                  <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                    <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                    View Details
                  </span>
                </div>
              </div>
            </div>
            
            {/* Hover overlay effect */}
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
          </a>
        ))
      }
    </div>
  </Section>
  
  <Connect socialLinks={SITE_CONFIG.socialLinks} />
</Layout>

<style>
  /* Custom animations for Beyond Engineering tiles */
  .group {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  
  .group:hover {
    transform: translateY(-4px) scale(1.02);
  }
  
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, var(--color-primary)/10, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 1rem;
  }
  
  .group:hover::before {
    opacity: 1;
  }
</style>