---
import Section from "@components/Section.astro";
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import About from "@components/About.astro";
import Connect from "@components/Connect.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

// Beyond Engineering data
const beyondEngineeringItems = [
  {
    name: "TEDxAshesiUniversity Curator",
    image: "/tedx5.jpg",
    linkPreview: "/beyond-engineering/tedx"
  },
  {
    name: "Leadership Speech Competition Finalist",
    image: "/speech2.jpg",
    linkPreview: "/beyond-engineering/leadership-speech-competition"
  },
  {
    name: "Spelling Bee Volunteer",
    image: "/spelling1.jpg",
    linkPreview: "/beyond-engineering/spelling-bee"
  },
  {
    name: "Sage Literacy Foundation",
    image: "/sage4.jpg",
    linkPreview: "/beyond-engineering/sage-foundation"
  },
  {
    name: "Newsletter Editorial Team", 
    image: "/newsletter1.jpg",
    linkPreview: "/beyond-engineering/newsletter"
  },
  {
    name: "Writer, Comma Period",
    image: "/cmmprd1.jpg",
    linkPreview: "/beyond-engineering/writer"
  }
];
---

<Layout>
  {/* THE ABOUT SECTION AT THE VERY TOP - NO HEADING BUT WITH ANCHOR */}
  <div id="profile" class="pt-12">
    <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  </div>
  
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <Skills skills={SITE_CONTENT.skills} />
  
  <!-- BEYOND ENGINEERING SECTION -->
  <Section text="beyond engineering" href="beyond-engineering">
    <div class="relative">
      {/* Navigation Arrows */}
      <button id="beyondPrevBtn" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-all duration-200 will-change-transform touch-manipulation" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button id="beyondNextBtn" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-all duration-200 will-change-transform touch-manipulation" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Beyond Engineering Container */}
      <div 
        id="beyondContainer" 
        class="flex overflow-x-hidden scroll-smooth space-x-3 sm:space-x-6 py-4 cursor-grab active:cursor-grabbing touch-pan-x select-none"
        style="touch-action: pan-x; -webkit-overflow-scrolling: touch;"
      >
        {
          beyondEngineeringItems.map(({ name, image, linkPreview }) => (
            <div class="group relative flex-shrink-0 w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20">
              <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
              
              <div class="relative z-10 w-full h-full">
                <a href={linkPreview} class="block w-full h-full">
                  <Image
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer"
                    src={image}
                    alt={name}
                    width={256}
                    height={256}
                    loading="lazy"
                  />
                </a>
              </div>
              
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
              
              <span class="sr-only">{name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
  
  <Connect socialLinks={SITE_CONFIG.socialLinks} />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const beyondContainer = document.getElementById('beyondContainer');
      const beyondPrevBtn = document.getElementById('beyondPrevBtn');
      const beyondNextBtn = document.getElementById('beyondNextBtn');
      
      if (!beyondContainer || !beyondPrevBtn || !beyondNextBtn) return;

      // Calculate responsive item width based on screen size
      const getItemWidth = () => {
        const screenWidth = window.innerWidth;
        if (screenWidth < 640) { // Mobile
          return 192 + 12; // w-48 (192px) + space-x-3 (12px)
        } else if (screenWidth < 768) { // Small tablet
          return 224 + 24; // w-56 (224px) + space-x-6 (24px)
        } else { // Desktop
          return 256 + 24; // w-64 (256px) + space-x-6 (24px)
        }
      };
      
      let itemWidth = getItemWidth();

      // Scroll to next item
      beyondNextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const { scrollLeft, scrollWidth, clientWidth } = beyondContainer;
        if (scrollLeft < scrollWidth - clientWidth - 5) {
          beyondContainer.scrollBy({ left: itemWidth, behavior: 'smooth' });
        }
      });

      // Scroll to previous item
      beyondPrevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const { scrollLeft } = beyondContainer;
        if (scrollLeft > 5) {
          beyondContainer.scrollBy({ left: -itemWidth, behavior: 'smooth' });
        }
      });

      // Hide arrows when at edges
      const checkBeyondArrows = () => {
        const { scrollLeft, scrollWidth, clientWidth } = beyondContainer;
        const isAtStart = scrollLeft <= 5;
        const isAtEnd = scrollLeft >= scrollWidth - clientWidth - 5;
        
        beyondPrevBtn.style.opacity = isAtStart ? '0.5' : '1';
        beyondNextBtn.style.opacity = isAtEnd ? '0.5' : '1';
        
        beyondPrevBtn.style.pointerEvents = isAtStart ? 'none' : 'auto';
        beyondNextBtn.style.pointerEvents = isAtEnd ? 'none' : 'auto';
      };

      beyondContainer.addEventListener('scroll', checkBeyondArrows);
      checkBeyondArrows(); // Initial check

      // Update item width on resize
      window.addEventListener('resize', () => {
        itemWidth = getItemWidth();
        checkBeyondArrows();
      });

      // Add keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          beyondContainer.scrollBy({ left: -getItemWidth(), behavior: 'smooth' });
        } else if (e.key === 'ArrowRight') {
          beyondContainer.scrollBy({ left: getItemWidth(), behavior: 'smooth' });
        }
      });

      // Enhanced touch and mouse sliding functionality for Beyond Engineering
      let beyondStartX: number;
      let beyondScrollLeft: number;
      let beyondIsDown = false;
      let beyondStartTime: number;
      let beyondVelocity = 0;
      let beyondLastX: number;
      let beyondLastTime: number;
      let beyondIsScrolling = false;

      const snapToBeyondItem = () => {
        const currentItemWidth = getItemWidth();
        const currentScroll = beyondContainer.scrollLeft;
        const targetIndex = Math.round(currentScroll / currentItemWidth);
        const targetScroll = targetIndex * currentItemWidth;
        
        beyondContainer.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      };

      const handleBeyondStart = (clientX: number) => {
        beyondIsDown = true;
        beyondIsScrolling = false;
        beyondStartX = clientX - beyondContainer.offsetLeft;
        beyondScrollLeft = beyondContainer.scrollLeft;
        beyondStartTime = Date.now();
        beyondLastX = clientX;
        beyondLastTime = beyondStartTime;
        beyondVelocity = 0;
        beyondContainer.classList.add('active');
        beyondContainer.style.scrollBehavior = 'auto';
      };

      const handleBeyondMove = (clientX: number) => {
        if (!beyondIsDown) return;
        
        beyondIsScrolling = true;
        const x = clientX - beyondContainer.offsetLeft;
        const walk = (x - beyondStartX) * 1.2;
        beyondContainer.scrollLeft = beyondScrollLeft - walk;
        
        // Calculate velocity for momentum
        const currentTime = Date.now();
        const deltaX = clientX - beyondLastX;
        const deltaTime = currentTime - beyondLastTime;
        
        if (deltaTime > 0) {
          beyondVelocity = deltaX / deltaTime;
        }
        
        beyondLastX = clientX;
        beyondLastTime = currentTime;
      };

      const handleBeyondEnd = () => {
        if (!beyondIsDown) return;
        
        beyondIsDown = false;
        beyondContainer.classList.remove('active');
        beyondContainer.style.scrollBehavior = 'smooth';
        
        // Only apply momentum if user was actually scrolling
        if (beyondIsScrolling && Math.abs(beyondVelocity) > 0.3) {
          const momentum = beyondVelocity * 150;
          const currentScroll = beyondContainer.scrollLeft;
          const targetScroll = currentScroll - momentum;
          
          beyondContainer.scrollTo({
            left: targetScroll,
            behavior: 'smooth'
          });
          
          // Snap to item after momentum
          setTimeout(snapToBeyondItem, 250);
        } else if (beyondIsScrolling) {
          // Snap to nearest item
          snapToBeyondItem();
        }
      };

      // Mouse events for Beyond Engineering
      beyondContainer.addEventListener('mousedown', (e: MouseEvent) => {
        // Only prevent default if not clicking on a link
        const element = e.target as Element;
        if (element && element.closest('a')) {
          return; // Let the link handle the click
        }
        e.preventDefault();
        handleBeyondStart(e.clientX);
      });

      beyondContainer.addEventListener('mouseleave', handleBeyondEnd);
      beyondContainer.addEventListener('mouseup', handleBeyondEnd);

      beyondContainer.addEventListener('mousemove', (e: MouseEvent) => {
        if (beyondIsDown) {
          e.preventDefault();
          handleBeyondMove(e.clientX);
        }
      });

      // Enhanced touch events for Beyond Engineering
      let beyondTouchStartTime: number;
      let beyondTouchStartX: number;
      let beyondTouchStartY: number;
      let beyondIsTouchScrolling = false;
      let beyondTouchMoved = false;

      beyondContainer.addEventListener('touchstart', (e: TouchEvent) => {
        if (e.touches.length === 1) {
          const touch = e.touches[0];
          const element = document.elementFromPoint(touch.clientX, touch.clientY);
          
          // If touching a link or button, don't interfere with the click
          if (element && (element.closest('a') || element.closest('button'))) {
            return;
          }
          
          beyondTouchStartTime = Date.now();
          beyondTouchStartX = touch.clientX;
          beyondTouchStartY = touch.clientY;
          beyondIsTouchScrolling = false;
          beyondTouchMoved = false;
          beyondContainer.style.scrollBehavior = 'auto';
          beyondContainer.style.cursor = 'grabbing';
        }
      }, { passive: true });

      beyondContainer.addEventListener('touchmove', (e: TouchEvent) => {
        if (e.touches.length === 1) {
          const touch = e.touches[0];
          const deltaX = Math.abs(touch.clientX - beyondTouchStartX);
          const deltaY = Math.abs(touch.clientY - beyondTouchStartY);
          
          // More sensitive touch detection for mobile
          if (deltaX > 5 && deltaX > deltaY) {
            beyondTouchMoved = true;
            beyondIsTouchScrolling = true;
            e.preventDefault();
            
            if (!beyondIsDown) {
              handleBeyondStart(touch.clientX);
            }
            handleBeyondMove(touch.clientX);
          }
        }
      }, { passive: false });

      beyondContainer.addEventListener('touchend', (e: TouchEvent) => {
        const touchDuration = Date.now() - beyondTouchStartTime;
        const deltaX = Math.abs(e.changedTouches[0].clientX - beyondTouchStartX);
        const deltaY = Math.abs(e.changedTouches[0].clientY - beyondTouchStartY);
        
        // Reset cursor
        beyondContainer.style.cursor = 'grab';
        
        // If it was a quick tap with minimal movement, allow link clicks
        if (touchDuration < 300 && deltaX < 15 && deltaY < 15 && !beyondTouchMoved) {
          const element = document.elementFromPoint(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
          if (element && (element.closest('a') || element.closest('button'))) {
            // Let the link/button handle the click
            return;
          }
        }
        
        if (beyondIsTouchScrolling || beyondTouchMoved) {
          e.preventDefault();
          beyondContainer.style.scrollBehavior = 'smooth';
          handleBeyondEnd();
        }
       }, { passive: false });

      // Add touch cancel event for better mobile handling
      beyondContainer.addEventListener('touchcancel', () => {
        beyondContainer.style.cursor = 'grab';
        beyondContainer.style.scrollBehavior = 'smooth';
        if (beyondIsDown) {
          handleBeyondEnd();
        }
      }, { passive: true });
    let startX: number;
    let scrollLeft: number;
    let isDown = false;
    let startTime: number;
    let velocity = 0;
    let lastX: number;
    let lastTime: number;
    let isScrolling = false;

    const snapToItem = () => {
      const currentItemWidth = getItemWidth();
      const currentScroll = beyondContainer.scrollLeft;
      const targetIndex = Math.round(currentScroll / currentItemWidth);
      const targetScroll = targetIndex * currentItemWidth;

      beyondContainer.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
    };

    const handleStart = (clientX: number) => {
      isDown = true;
      isScrolling = false;
      startX = clientX - beyondContainer.offsetLeft;
      scrollLeft = beyondContainer.scrollLeft;
      startTime = Date.now();
      lastX = clientX;
      lastTime = startTime;
      velocity = 0;
      beyondContainer.classList.add('active');
      beyondContainer.style.scrollBehavior = 'auto';
    };

    const handleMove = (clientX: number) => {
      if (!isDown) return;

      isScrolling = true;
      const x = clientX - beyondContainer.offsetLeft;
      const walk = (x - startX) * 1.2; // Reduced sensitivity for better control
      beyondContainer.scrollLeft = scrollLeft - walk;

      // Calculate velocity for momentum
      const currentTime = Date.now();
      const deltaX = clientX - lastX;
      const deltaTime = currentTime - lastTime;

      if (deltaTime > 0) {
        velocity = deltaX / deltaTime;
      }

      lastX = clientX;
      lastTime = currentTime;
    };

    const handleEnd = () => {
      if (!isDown) return;

      isDown = false;
      beyondContainer.classList.remove('active');
      beyondContainer.style.scrollBehavior = 'smooth';

      // Only apply momentum if user was actually scrolling
      if (isScrolling && Math.abs(velocity) > 0.3) {
        const momentum = velocity * 150; // Reduced momentum for better control
        const currentScroll = beyondContainer.scrollLeft;
        const targetScroll = currentScroll - momentum;

        beyondContainer.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });

        // Snap to item after momentum
        setTimeout(snapToItem, 250);
      } else if (isScrolling) {
        // Snap to nearest item
        snapToItem();
      }
    };

    // Mouse events
    beyondContainer.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      handleStart(e.clientX);
    });

    beyondContainer.addEventListener('mouseleave', handleEnd);
    beyondContainer.addEventListener('mouseup', handleEnd);

    beyondContainer.addEventListener('mousemove', (e: MouseEvent) => {
      e.preventDefault();
      handleMove(e.clientX);
    });

    // Touch events with improved mobile handling
    beyondContainer.addEventListener('touchstart', (e: TouchEvent) => {
      e.preventDefault();
      handleStart(e.touches[0].clientX);
    }, { passive: false });

    beyondContainer.addEventListener('touchend', (e: TouchEvent) => {
      e.preventDefault();
      handleEnd();
    }, { passive: false });

    beyondContainer.addEventListener('touchmove', (e: TouchEvent) => {
      e.preventDefault();
      handleMove(e.touches[0].clientX);
    }, { passive: false });

    // Prevent default touch behaviors that interfere with scrolling
    beyondContainer.addEventListener('touchstart', (e: TouchEvent) => {
      // Allow single taps to work normally
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const element = document.elementFromPoint(touch.clientX, touch.clientY);
        if (element && element.closest('a')) {
          // Don't prevent default for links
          return;
        }
      }
    }, { passive: true });
    });
  </script>

  <style>
    /* Hide scrollbar but keep functionality */
    #beyondContainer {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    
    #beyondContainer::-webkit-scrollbar {
      display: none;
    }
  </style>
</Layout>