---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Ashesi Multipurpose Reservation System"
);

// Null check
if (!project) {
  return Response.redirect('/404', 404);
}

// Updatedd media files with Java-related images
const mediaItems = [
  "/java2.jpg",
  "/java3.jpg", 
  "/java4.jpg",
  "/java5.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">Developed a centralised platform with a team of three to streamline student access to Ashesi's resources. The system validated logins and organised reservations into Human-Based Services (e.g., Career Services, Peer Tutoring) and Remote Services (e.g., Housing, Classroom Booking).</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li><strong>Programming language:</strong> Java</li>
          <li>Secure login validation and user authentication</li>
          <li>Dual reservation system for human and remote services</li>
          <li>Seamless URL redirection to appropriate resource portals</li>
          <li>User-friendly interface for easy navigation</li>
          <li>Centralised access to multiple campus resources</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {mediaItems.map((media, index) => (
            <div 
              class="relative overflow-hidden rounded-lg cursor-pointer" 
              onclick={`openImageModal('${media}', 'Java project screenshot ${index + 1}')`}
            >
              <img 
                src={media} 
                alt={`Java project screenshot ${index + 1}`} 
                class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" 
              />
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technical Implementation</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Frontend development with modern web technologies</li>
          <li>Database design for user and resource management</li>
          <li>Security protocols for user authentication</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          View Source Code
        </a>
        {/* Liiive Preview button removed as requested */}
      </div>
    </div>
  </article>

  <!-- Image Modal -->
  <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        id="closeModal" 
        class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10 bg-black bg-opacity-50 rounded-full p-2"
        onclick="closeImageModal()"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>
</Layout>

<script>
  function openImageModal(src: string, alt: string) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    
    if (!modal || !modalImage) return;
    
    modalImage.src = src;
    modalImage.alt = alt;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    if (!modal) return;
    
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside the image
  document.addEventListener('click', (e: Event) => {
    const modal = document.getElementById('imageModal');
    const modalElement = e.target as HTMLElement;
    
    if (modal && modalElement && modalElement.id === 'imageModal') {
      closeImageModal();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>