---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Ashesi Multipurpose Reservation System"
);
if (!project) {
  return Response.redirect('/404', 404);
}
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <!-- Add your detailed project content here -->
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">Detailed description of the project...</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technologies Used</h2>
        <p class="text-neutral">List of technologies and tools...</p>
      </section>

      <div class="flex gap-4">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90">
          View Source Code
        </a>
        <a href={project.linkPreview} target="_blank" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10">
          Live Preview
        </a>
      </div>
    </div>
  </article>
</Layout>