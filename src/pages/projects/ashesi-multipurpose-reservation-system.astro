---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Ashesi Multipurpose Reservation System"
);

// Null check
if (!project) {
  return Response.redirect('/404', 404);
}

// Updated media files with Java-related images
const mediaItems = [
  "/java2.jpg",
  "/java3.jpg", 
  "/java4.jpg",
  "/java5.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">Developed a centralised platform with a team of three to streamline student access to Ashesi's resources. The system validated logins and organized reservations into Human-Based Services (e.g., Career Services, Peer Tutoring) and Remote Services (e.g., Housing, Classroom Booking).</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li><strong>Programming language:</strong> Java</li>
          <li>Secure login validation and user authentication</li>
          <li>Dual reservation system for human and remote services</li>
          <li>Seamless URL redirection to appropriate resource portals</li>
          <li>User-friendly interface for easy navigation</li>
          <li>Centralised access to multiple campus resources</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Java project screenshot ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technical Implementation</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Frontend development with modern web technologies</li>
          <li>Database design for user and resource management</li>
          <li>Security protocols for user authentication</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          View Source Code
        </a>
        {/* Live Preview button removed as requested */}
      </div>
    </div>
  </article>
</Layout>