---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "ShellTrivia"
);
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Game Overview</h2>
        <p class="text-neutral">An engaging GUI-based trivia game with multiple difficulty levels, testing players across various knowledge domains including music, film, sports, and current affairs.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Game Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Four progressive difficulty levels</li>
          <li>Multiple categories: Music, Film, Sports, Current Affairs, General Knowledge</li>
          <li>Shell-based scoring system (points awarded/deducted)</li>
          <li>Interactive leaderboard tracking high scores</li>
          <li>Category selection and personalized gameplay</li>
        </ul>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technologies Used</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Tkinter (Python GUI)</li>
          <li>Python Data Structures</li>
          <li>File I/O for persistence</li>
          <li>Object-Oriented Programming</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          View Source Code
        </a>
        <a href={project.linkPreview} target="_blank" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Live Preview
        </a>
      </div>
    </div>
  </article>
</Layout>