---
import Layout from "../../../layouts/Layout.astro";
import SNNJotterEverydayStory from "../../../components/SNNJotterEverydayStory.astro";
import SNNJotterEngineeringPuzzle from "../../../components/SNNJotterEngineeringPuzzle.astro";
import SNNJotterGlossary from "../../../components/SNNJotterGlossary.astro";
import SNNJotterPipeline from "../../../components/SNNJotterPipeline.astro";
import SNNJotterDisplayLayer from "../../../components/SNNJotterDisplayLayer.astro";

export function getStaticPaths() {
  const sections = [
    {
      slug: "everyday-story",
      number: "01",
      title: "Why hearts and wearables care",
      description: "The everyday story behind ECG signals and event-driven computing.",
    },
    {
      slug: "engineering-puzzle",
      number: "02",
      title: "Engineering puzzle + my objective",
      description: "Fitting a useful model onto a small FPGA without losing the important details.",
    },
    {
      slug: "pipeline",
      number: "03",
      title: "How the pipeline works",
      description: "Follow the path from heartbeat recordings to a configurable chip.",
    },
    {
      slug: "glossary",
      number: "04",
      title: "What those words actually mean",
      description: "A pocket glossary for the signals, neurons, and hardware in this project.",
    },
    {
      slug: "display-layer",
      number: "05",
      title: "The display layer: translating technical outputs",
      description: "A planned prototype interface for translating AAMI heartbeat classes into readable Basys 3 alerts.",
    },
  ];

  return sections.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const sectionComponents = {
  "everyday-story": SNNJotterEverydayStory,
  "engineering-puzzle": SNNJotterEngineeringPuzzle,
  pipeline: SNNJotterPipeline,
  glossary: SNNJotterGlossary,
  "display-layer": SNNJotterDisplayLayer,
};
const SectionContent = sectionComponents[section.slug as keyof typeof sectionComponents];
---

<Layout
  title={`${section.title} | SNNJotter`}
  description={section.description}
  contentWidth={section.slug === "glossary" ? "wide" : "default"}
>
  <article class:list={[
    "mx-auto py-10 sm:py-14",
    section.slug === "glossary" ? "max-w-4xl" : "max-w-3xl",
  ]}>
    <a
      href="/projects/snnjotter"
      class="inline-flex items-center gap-2 text-sm font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <span aria-hidden="true">←</span> Table of contents
    </a>
    <header class="mt-6 rounded-[1.5rem] border border-primary/25 bg-surface p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Section {section.number} of 05</p>
      <h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-white sm:text-4xl">{section.title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-white/70">{section.description}</p>
    </header>

    <SectionContent />

    <footer class="mt-10 border-t border-white/10 pt-6">
      <a
        href="/projects/snnjotter"
        class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        <span aria-hidden="true">←</span> Back to all notes
      </a>
    </footer>
  </article>
</Layout>
