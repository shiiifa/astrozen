---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "LED-Based Countdown Timer"
);

// Fixed null check
if (!project) {
  return Astro.redirect('/404');
}

// Dummy media files
const mediaItems = [
  "/clone-ig.png",
  "/shopify-clon.png", 
  "/spotifu.png",
  "/alejandro-big.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">For our Circuits and Electronics course, Thandeka and I designed and built a sophisticated countdown timer using four-digit 7-segment displays constructed entirely from individual LEDs. The system was controlled by an Arduino Uno and featured a buzzer alarm along with a potentiometer for precise time control.</p>
        
        <p class="text-neutral mt-4">What made this project particularly exciting was that it served as our entry for the Engineering and CS Final Semester Hackathon - marking our first participation in such an event and creating an unforgettable learning experience that combined theoretical knowledge with practical implementation.</p>
      </section>

      <!-- Rest of your content remains the same -->
      <!-- ... -->
    </div>
  </article>
</Layout>