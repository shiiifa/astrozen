---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

// Media files for ASIS project
const mediaItems = [
  "/asis1.jpg",
  "/asis2.jpg", 
  "/asis3.jpg",
  "/asis4.jpg",
  "/asis5.jpg",
  "/asis6.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Ashesi Student Information System
      </h1>
      <p class="text-lg text-neutral">
        A propositional logic-based CAMU-inspired prototype for automated course enrollment decisions.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">Worked with a team of three to prototype a system modeled after Ashesi's CAMU Student Information System. The project applied propositional logic from discrete mathematics to guide course enrollment decisions by validating user inputs, checking prerequisites, GPA, and grades.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Propositional logic-based course enrollment validation</li>
          <li>Automated prerequisite checking and GPA requirements</li>
          <li>Robust error-handling for credential verification</li>
          <li>User-friendly interface for academic planning</li>
          <li>Decision automation for course registration</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Project Visualizations</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`ASIS system screenshot ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technical Implementation</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Discrete mathematics logic systems implementation</li>
          <li>Python programming for core functionality</li>
          <li>Data structures for course and student management</li>
          <li>User interface design for academic planning</li>
          <li>Error handling and validation systems</li>
        </ul>
      </section>

      <div class="flex justify-center">
        <a href="https://github.com/shiiifa/SystemSpecifications" target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          View Source Code
        </a>
      </div>
    </div>
  </article>
</Layout>