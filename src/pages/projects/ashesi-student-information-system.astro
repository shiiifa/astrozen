---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

// Media files for ASIS project
const mediaItems = [
  "/asis1.jpg",
  "/asis2.jpg", 
  "/asis3.jpg",
  "/asis4.jpg",
  "/asis5.jpg",
  "/asis6.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        Ashesi Student Information System
      </h1>
      <p class="text-lg text-neutral">
        A propositional logic-based CAMU-inspired prototype for automated course enrollment decisions.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">Worked with a team of three to prototype a system modeled after Ashesi's CAMU Student Information System. The project applied propositional logic from discrete mathematics to guide course enrollment decisions by validating user inputs, checking prerequisites, GPA, and grades.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Propositional logic-based course enrollment validation</li>
          <li>Automated prerequisite checking and GPA requirements</li>
          <li>Robust error-handling for credential verification</li>
          <li>User-friendly interface for academic planning</li>
          <li>Decision automation for course registration</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-primary">Project Visualizations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {mediaItems.map((media, index) => (
            <div 
              class="relative overflow-hidden rounded-lg cursor-pointer" 
              onclick={`openImageModal('${media}', 'ASIS system screenshot ${index + 1}')`}
            >
              <img 
                src={media} 
                alt={`ASIS system screenshot ${index + 1}`} 
                class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" 
              />
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technical Implementation</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Discrete mathematics logic systems implementation</li>
          <li>Python programming for core functionality</li>
          <li>Data structures for course and student management</li>
          <li>User interface design for academic planning</li>
          <li>Error handling and validation systems</li>
        </ul>
      </section>

      <div class="flex justify-center">
        <a href="https://github.com/shiiifa/SystemSpecifications" target="_blank" class="rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]">
          View Source Code
        </a>
      </div>
    </div>
  </article>

  <!-- Image Modal -->
  <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        id="closeModal" 
        class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10 bg-black bg-opacity-50 rounded-full p-2"
        onclick="closeImageModal()"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>
</Layout>

<script>
  function openImageModal(src: string, alt: string) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    
    if (!modal || !modalImage) return;
    
    modalImage.src = src;
    modalImage.alt = alt;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    if (!modal) return;
    
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside the image
  document.addEventListener('click', (e: Event) => {
    const modal = document.getElementById('imageModal');
    const modalElement = e.target as HTMLElement;
    
    if (modal && modalElement && modalElement.id === 'imageModal') {
      closeImageModal();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>