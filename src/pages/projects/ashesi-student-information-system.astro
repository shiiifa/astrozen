---
import "../../styles/global.css"; 
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout>
  <div class="max-w-4xl mx-auto px-5 py-24">
    <!-- Back button -->
    <a href="/#projects" class="inline-flex items-center text-primary hover:text-white mb-8 transition-colors">
      ← Back to Projects
    </a>
    
    <!-- Project header -->
    <header class="mb-12">
      <h1 class="mb-6 font-serif text-5xl font-bold text-white md:text-6xl">
        Ashesi Student Information System
      </h1>
      <p class="text-lg text-neutral leading-relaxed">
        Worked with a team of three to prototype a system modeled after Ashesi's CAMU Student Information System. The project applied propositional logic from discrete mathematics to guide course enrollment decisions.
      </p>
    </header>

    <!-- Project image -->
    <div class="mb-12 rounded-2xl overflow-hidden bg-[#1c232d]/85 p-8">
      <Image
        class="w-full h-auto rounded-xl"
        src="/shopify-clon.png"
        alt="Ashesi Student Information System"
        width="800"
        height="600"
      />
    </div>

    <!-- Project details section -->
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Project Overview
      </h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-base text-neutral leading-relaxed mb-6">
          This project represents a sophisticated application of discrete mathematics principles to real-world software development. By incorporating propositional logic into the system architecture, we created an intelligent enrollment validation system that automates complex decision-making processes.
        </p>
        <p class="text-base text-neutral leading-relaxed mb-6">
          The system validates multiple criteria simultaneously - checking prerequisites, analyzing GPA requirements, evaluating previous grades, and ensuring students meet all necessary conditions before allowing course enrollment. This reduces errors and streamlines the registration process.
        </p>
        <p class="text-base text-neutral leading-relaxed">
          Working collaboratively in a team environment, we emphasized robust error-handling and credential validation to ensure system reliability and data integrity throughout the user experience.
        </p>
      </div>
    </section>

    <!-- Technologies used -->
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Technologies & Tools
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">Python</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">SQL</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">Logic Programming</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">Database Design</span>
        </div>
      </div>
    </section>

    <!-- Key features -->
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Key Features
      </h2>
      <ul class="space-y-4">
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Propositional logic implementation for automated enrollment validation</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Comprehensive prerequisite and GPA requirement checking</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Robust error-handling for credential validation and system reliability</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Automated decision-making system reducing manual processing time</p>
        </li>
      </ul>
    </section>

    <!-- Links section -->
    <section class="border-t border-neutral/20 pt-8">
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://github.com/shiiifa?tab=repositories"
          target="_blank"
          class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]"
        >
          View Source Code
        </a>
        <a
          href="/"
          target="_blank"
          class="inline-flex items-center justify-center rounded-full border border-primary text-primary px-8 py-4 font-medium hover:bg-primary hover:text-white transition-colors after:ml-2 after:content-[url(/external.svg)]"
        >
          Live Preview
        </a>
      </div>
    </section>
  </div>
</Layout>