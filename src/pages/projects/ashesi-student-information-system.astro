---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Ashesi Student Information System"
);
if (!project) {
  return Response.redirect('/404', 404);
}
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Project Overview</h2>
        <p class="text-neutral">A comprehensive student information system prototype modeled after Ashesi's CAMU platform, designed to streamline course enrollment and academic management.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Features</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Propositional logic-based course enrollment validation</li>
          <li>Automated prerequisite checking and GPA requirements</li>
          <li>Robust error handling for credential verification</li>
          <li>User-friendly interface for academic planning</li>
        </ul>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Technologies Used</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Python</li>
          <li>Discrete Mathematics Logic Systems</li>
          <li>Data Structures & Algorithms</li>
          <li>User Interface Design</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          View Source Code
        </a>
        <a href={project.linkPreview} target="_blank" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Live Preview
        </a>
      </div>
    </div>
  </article>
</Layout>