---
import Layout from "@layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  return SITE_CONTENT.projects.map((project) => {
    // Create a proper slug that matches your file structure
    const slug = project.name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    return {
      params: { slug },
      props: { project }
    };
  });
}

const { project } = Astro.props;
if (!project) {
  // Handle missing project gracefully
  return;
}
---

<Layout>
  <div class="max-w-4xl mx-auto px-5 py-24">
    {/* Back button */}
    <a href="/#projects" class="inline-flex items-center text-primary hover:text-white mb-8 transition-colors">
      ← Back to Projects
    </a>
    
    {/* Project header */}
    <header class="mb-12">
      <h1 class="mb-6 font-serif text-5xl font-bold text-white md:text-6xl">
        {project.name}
      </h1>
      <p class="text-lg text-neutral leading-relaxed">
        {project.summary}
      </p>
    </header>

    {/* Project image */}
    {project.image && (
      <div class="mb-12 rounded-2xl overflow-hidden bg-[#1c232d]/85 p-8">
        <Image
          class="w-full h-auto rounded-xl"
          src={project.image}
          alt={project.name}
          width="800"
          height="600"
        />
      </div>
    )}

    {/* Project details section */}
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Project Overview
      </h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-base text-neutral leading-relaxed mb-6">
          This project represents a significant milestone in my development journey. Through careful planning, 
          iterative design, and robust implementation, I was able to create a solution that addresses real-world 
          challenges while maintaining high standards for user experience and code quality.
        </p>
        <p class="text-base text-neutral leading-relaxed mb-6">
          The development process involved extensive research, prototyping, and testing to ensure the final 
          product met both functional requirements and design standards. Key considerations included performance 
          optimization, responsive design, and accessibility compliance.
        </p>
        <p class="text-base text-neutral leading-relaxed">
          This experience strengthened my skills in problem-solving, project management, and technical 
          implementation while providing valuable insights into industry best practices and user-centered design.
        </p>
      </div>
    </section>

    {/* Technologies used */}
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Technologies & Tools
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">React</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">JavaScript</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">CSS</span>
        </div>
        <div class="bg-[#1c232d]/50 rounded-lg p-4 text-center">
          <span class="text-white font-medium">Git</span>
        </div>
      </div>
    </section>

    {/* Key features */}
    <section class="mb-12">
      <h2 class="mb-6 font-serif text-3xl font-medium text-primary">
        Key Features
      </h2>
      <ul class="space-y-4">
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Responsive design that works seamlessly across all device sizes</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Intuitive user interface with smooth animations and transitions</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Optimized performance with fast loading times and efficient resource usage</p>
        </li>
        <li class="flex items-start">
          <div class="w-2 h-2 bg-primary rounded-full mt-2 mr-4 flex-shrink-0"></div>
          <p class="text-neutral">Accessible design following WCAG guidelines for inclusive user experience</p>
        </li>
      </ul>
    </section>

    {/* Links section */}
    <section class="border-t border-neutral/20 pt-8">
      <div class="flex flex-col sm:flex-row gap-4">
        {project.linkSource && (
          <a
            href={project.linkSource}
            target="_blank"
            class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-white font-medium hover:bg-primary/90 transition-colors after:ml-2 after:content-[url(/external.svg)]"
          >
            View Source Code
          </a>
        )}
        {project.linkPreview && (
          <a
            href={project.linkPreview}
            target="_blank"
            class="inline-flex items-center justify-center rounded-full border border-primary text-primary px-8 py-4 font-medium hover:bg-primary hover:text-white transition-colors after:ml-2 after:content-[url(/external.svg)]"
          >
            Live Preview
          </a>
        )}
      </div>
    </section>
  </div>
</Layout>