---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Cyber Threat Dynamics in VANETs"
);

// Null check
if (!project) {
  return Response.redirect('/404', 404);
}

// Dummy media files
const mediaItems = [
  "/clone-ig.png",
  "/shopify-clon.png", 
  "/spotifu.png",
  "/alejandro-big.jpg",
  "/clone-ig.png",
  "/shopify-clon.png",
  "/spotifu.png",
  "/alejandro-big.jpg"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Research Overview</h2>
        <p class="text-neutral">Modeled malware spread in Vehicular Ad-Hoc Networks (VANETs) using an SEIR-S framework, analyzing key parameters and wireless modes (Wi-Fi, Bluetooth, Cellular). Findings highlighted vulnerabilities in connected cars like Tesla and pointed to strategies for stronger vehicular cybersecurity.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Findings</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>SEIR-S framework for malware spread modeling</li>
          <li>Analysis of wireless transmission modes: Wi-Fi, Bluetooth, Cellular</li>
          <li>Identification of critical vulnerabilities in connected vehicles</li>
          <li>Development of enhanced cybersecurity strategies</li>
          <li>Risk assessment for modern vehicular networks</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-8 font-serif text-2xl font-semibold text-primary">Media Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaItems.map((media, index) => (
            <a 
              href={media} 
              target="_blank" 
              class="group relative block overflow-hidden rounded-lg border border-neutral/20 transition-all duration-300 hover:scale-105 hover:border-primary/30"
            >
              <Image
                src={media}
                alt={`Project media ${index + 1}`}
                width={200}
                height={200}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center">
                <span class="text-white text-sm font-medium">View Full Size</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Methodology & Tools</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>Mathematical Modeling (SEIR-S Framework)</li>
          <li>MATLAB Simulations for network analysis</li>
          <li>Network Security Analysis techniques</li>
          <li>Wireless Communication Protocols study</li>
          <li>Cybersecurity Threat Assessment methodologies</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          View Research Code
        </a>
        <a href={project.linkPreview} target="_blank" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Research Paper
        </a>
      </div>
    </div>
  </article>
</Layout>