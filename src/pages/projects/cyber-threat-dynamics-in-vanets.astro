---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";
import { Image } from "astro:assets";

const project = SITE_CONTENT.projects.find(p => 
  p.name === "Cyber Threat Dynamics in VANETs"
);

// Fixed null check
if (!project) {
  return Astro.redirect('/404');
}

// Dummmy media files
const mediaItems = [
  "/vanet1.png",
  "/vanet2.png", 
  "/vanet3.png",
  "/vanet4.png",
  "/vanet5.png"
];
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <header class="mb-12 text-center">
      <h1 class="mb-6 font-serif text-4xl font-bold text-white">
        {project.name}
      </h1>
      <p class="text-lg text-neutral">
        {project.summary}
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Research Overview</h2>
        <p class="text-neutral">Modeled malware spread in Vehicular Ad-Hoc Networks (VANETs) using an SEIR-S framework, analyzing key parameters and wireless transmission modes (Wi-Fi, Bluetooth, Cellular). The research identified critical vulnerabilities in connected vehicle systems like Tesla and developed strategies for enhanced vehicular cybersecurity.</p>
        <p class="text-neutral mt-4">Through comprehensive analysis of differential equations, ODE solvers, and precise figure replications, the project provided actionable insights into network security vulnerabilities and mitigation approaches for modern intelligent transportation systems.</p>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Key Findings</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li>SEIR-S epidemiological framework for accurate malware spread modeling</li>
          <li>Comparative analysis of wireless transmission vulnerabilities across Wi-Fi, Bluetooth, and Cellular networks</li>
          <li>Identification of critical security flaws in connected vehicle architectures</li>
          <li>Development of proactive cybersecurity defense strategies</li>
          <li>Comprehensive risk assessment framework for modern vehicular networks</li>
        </ul>
      </section>

      <!-- MEDIA GALLERY SECTION -->
      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-primary">Research Visualizations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {mediaItems.map((media, index) => (
            <div 
              class="relative overflow-hidden rounded-lg cursor-pointer" 
              onclick={`openImageModal('${media}', 'Research visualization ${index + 1}')`}
            >
              <img 
                src={media} 
                alt={`Research visualization ${index + 1}`} 
                class="w-full h-auto object-cover transition-transform duration-300 hover:scale-105" 
              />
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-primary">Methodology & Technical Approach</h2>
        <ul class="text-neutral list-disc list-inside space-y-2">
          <li><strong>Mathematical Modeling:</strong> SEIR-S compartmental framework for epidemic spread analysis</li>
          <li><strong>Computational Simulations:</strong> MATLAB-based network analysis and precise figure replication</li>
          <li><strong>Numerical Methods:</strong> Advanced ODE solvers for differential equation systems</li>
          <li><strong>Security Analysis:</strong> Comprehensive vulnerability assessment techniques</li>
          <li><strong>Wireless Protocol Analysis:</strong> Multi-mode transmission vulnerability mapping</li>
        </ul>
      </section>

      <div class="flex gap-4 justify-center">
        <a href={project.linkSource} target="_blank" class="rounded-full bg-primary px-6 py-3 text-white hover:bg-primary/90 transition-colors">
          View Research Code
        </a>
        <a href="https://kofusakyi.wixsite.com/numericodes" target="_blank" class="rounded-full border border-primary px-6 py-3 text-primary hover:bg-primary/10 transition-colors">
          Visit Research Website
        </a>
      </div>
    </div>
  </article>

  <!-- Image Modal -->
  <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        id="closeModal" 
        class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10 bg-black bg-opacity-50 rounded-full p-2"
        onclick="closeImageModal()"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>
</Layout>

<script>
  function openImageModal(src: string, alt: string) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    
    if (!modal || !modalImage) return;
    
    modalImage.src = src;
    modalImage.alt = alt;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    if (!modal) return;
    
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside the image
  document.addEventListener('click', (e: Event) => {
    const modal = document.getElementById('imageModal');
    const modalElement = e.target as HTMLElement;
    
    if (modal && modalElement && modalElement.id === 'imageModal') {
      closeImageModal();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>