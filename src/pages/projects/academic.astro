---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import { Image } from "astro:assets";
import { SITE_CONTENT } from "@config";
---

<Layout>
  <div class="min-h-screen bg-gradient-to-br from-background via-background to-primary/5">
    <div class="container mx-auto px-6 py-16">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="mb-6">
          <a href="/projects" class="inline-flex items-center gap-2 text-primary hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Projects
          </a>
        </div>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-primary mb-6">
          Academic Projects
        </h1>
        <p class="text-lg text-neutral max-w-2xl mx-auto">
          University coursework, research projects, and academic collaborations that demonstrate technical skills and engineering principles.
        </p>
      </div>

      <!-- Projects Grid -->
      <Section text="academic projects" href="#academic">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {SITE_CONTENT.projects.map(({ name, summary, image, linkPreview, linkSource }) => (
            <a
              href={linkPreview}
              class="group relative overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
            >
              <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
              
              <div class="relative z-10 p-6">
                <div class="mb-6 overflow-hidden rounded-xl -mt-8">
                  <Image
                    class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-110"
                    src={image}
                    alt={name}
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                </div>
                
                <div class="flex flex-1 flex-col">
                  <h3 class="font-serif text-xl font-medium text-primary mb-3 group-hover:text-white transition-colors">
                    {name}
                  </h3>
                  <p class="text-sm text-neutral group-hover:text-white/80 transition-colors mb-4 flex-1">
                    {summary}
                  </p>
                  
                  <div class="flex gap-4 pt-4 text-xs text-white/70">
                    <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                      <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                      View Details
                    </span>
                    {linkSource && linkSource !== "#" && (
                      <a 
                        href={linkSource} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="flex items-center gap-1 transition-all duration-300 hover:text-primary"
                        onclick="event.stopPropagation()"
                      >
                        <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 hover:opacity-100 transition-opacity"></span>
                        Source Code
                      </a>
                    )}
                  </div>
                </div>
              </div>
              
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
            </a>
          ))}
        </div>
      </Section>
    </div>
  </div>
</Layout>
