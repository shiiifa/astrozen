---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";

const completedProjects = SITE_CONTENT.freelanceProjects.filter((project) => project.status === "Completed");
const testimonials = [
  {
    author: "Obed Allotey Babington, Ashesi C'2025",
    quote: "Shifa is a dynamic blend of intelligence, professionalism, and creativity. At a time when I was dissatisfied with my own portfolio site but lacked the time to improve it, I was relieved to discover her skill. Despite still being a student, she worked with the pace and quality of a full-time professional. The site speaks for itself.",
  },
  {
    author: "Obed Allotey Babington, Ashesi C'2025",
    quote: "She transformed my site from merely informative to genuinely classy. It achieved the goal of being a digital encapsulation of what I do – and in that regard, expectations were exceeded! Her ability to understand my vision, preferences, and feedback for the site, even with limited interaction, and to deliver quick, high-quality revisions was impressive.",
  },
  {
    author: "Elmir Mohammed, Ashesi C'2024",
    quote: "Shifa is an exceptionally professional and reliable individual. She consistently met deadlines and communicated through channels that fit my schedule, making the entire collaboration seamless. Her time consciousness and commitment to maintaining a high standard of work were truly impressive.",
  },
  {
    author: "Elmir Mohammed, Ashesi C'2024",
    quote: "What stood out most was her flexibility; she was always willing to make adjustments to ensure the final result perfectly matched my vision. I would highly recommend Shifa for any project requiring strong web design skills and a professional touch. I loved how clean and well-structured the website was. The design was simple, elegant, and perfectly aligned with what I needed. The responsiveness was top-notch across all devices, and I encountered no issues with timelines or delivery. Everything was handled with a high level of professionalism from start to finish.",
  },
  {
    author: "Selasi Nukpe, Assistant Director of Career Services",
    quote: "It has been an amazing experience working with Shifa. In fact, she challenges me to sit it up and be focused.",
    paragraphs: [
      "I reached out to her because I was impressed with the portfolio she built for herself.",
      "The process was smooth and easy to understand.",
      "Her communication was very professional and I liked how she followed up to ensure I stayed on track.",
    ],
  },
];
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <section class="px-6 py-16">
      <div class="text-center">
        <h1 class="fade-in-element mb-6 text-4xl font-serif font-bold text-white md:text-5xl">
          freelance projects
        </h1>
        <p class="fade-in-element mb-12 text-lg text-neutral/80">
          Freelancing is my window to bringing creative visions to life through custom design solutions
        </p>

        <div class="fade-in-element">
          <div class="mb-6 flex items-center justify-center">
            <a href="https://github.com/shiiifa" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 transition-colors hover:text-primary">
              <svg class="h-6 w-6 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span class="text-lg font-medium text-white">@shiiifa</span>
            </a>
          </div>
          <img
            src="https://ghchart.rshah.org/5b1760/shiiifa"
            alt="GitHub contribution graph for shiiifa"
            class="h-auto w-full max-w-full"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="freelance-carousel-section py-10">
      <h2 class="fade-in-element mb-6 text-center text-2xl font-serif font-bold text-primary">recent work</h2>
      <div class="freelance-marquee rounded-lg" data-draggable-carousel aria-label="Recent freelance projects">
        <div class="freelance-marquee__track">
          {[0, 1, 2].map((copy) => (
            <div class="freelance-marquee__group" data-copy={copy} aria-hidden={copy > 0 ? "true" : undefined}>
              {completedProjects.map((project) => (
                <a
                  href={project.linkSource}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={copy > 0 ? -1 : undefined}
                  class="freelance-project-card"
                  aria-label={`Open ${project.name} website in a new tab`}
                >
                  <iframe
                    src={project.linkSource}
                    title={`${project.name} desktop website preview`}
                    loading="lazy"
                    tabindex="-1"
                    aria-hidden="true"
                    sandbox="allow-scripts allow-same-origin"
                    class="freelance-project-card__preview pointer-events-none"
                  />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="freelance-carousel-section py-10">
      <h2 class="fade-in-element mb-6 text-center text-2xl font-serif font-bold text-primary">in their words</h2>
      <div class="freelance-marquee freelance-marquee--testimonials rounded-lg" data-draggable-carousel role="region" aria-label="Client testimonials" tabindex="0">
        <div class="freelance-marquee__track">
          {[0, 1, 2].map((copy) => (
            <div class="freelance-marquee__group" data-copy={copy} aria-hidden={copy > 0 ? "true" : undefined}>
              {testimonials.map((testimonial) => (
                <article class="freelance-testimonial-card">
                  <svg class="mb-4 h-6 w-6 text-primary/60" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z" />
                  </svg>
                  <blockquote class="mb-6 text-xs leading-relaxed text-neutral/80">
                    <p>{testimonial.quote}</p>
                    {testimonial.paragraphs?.map((paragraph) => <p class="mt-3">{paragraph}</p>)}
                  </blockquote>
                  <div class="border-t border-neutral/20 pt-4 text-xs font-medium text-white">{testimonial.author}</div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-8">
      <div class="mx-auto max-w-5xl text-center">
        <h2 class="fade-in-element mb-4 text-xl font-serif font-bold text-primary">wanna collab?</h2>
        <p class="fade-in-element mb-6 text-base text-neutral/80">
          Let's work together to bring your portfolio vision to life. I specialise in creating modern, responsive portfolio websites that showcase your work effectively.
        </p>
        <a
          href="https://forms.gle/sqDJL1oFx2auLvkm9"
          target="_blank"
          rel="noopener noreferrer"
          class="fade-in-element inline-flex rounded-full bg-primary px-6 py-3 text-xs font-medium text-black transition-colors hover:bg-primary/90"
        >
          Get In Touch
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-draggable-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".freelance-marquee__track");
    if (!track) return;

    carousel.querySelectorAll<HTMLElement>(".freelance-project-card").forEach((card) => {
      const preview = card.querySelector<HTMLIFrameElement>(".freelance-project-card__preview");
      if (!preview) return;

      const resizePreview = () => {
        preview.style.setProperty("--preview-scale", `${card.clientWidth / 1440}`);
      };

      new ResizeObserver(resizePreview).observe(card);
      resizePreview();
    });

    const getGroupWidth = () => track.querySelector<HTMLElement>(".freelance-marquee__group")?.offsetWidth ?? carousel.clientWidth;
    const wrapOffset = (offset: number) => {
      const width = getGroupWidth();
      return ((offset + width / 2) % width + width) % width - width / 2;
    };
    let pointerStart = 0;
    let offsetStart = 0;
    let dragged = false;

    carousel.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.button !== 0 || (carousel.matches(".freelance-marquee--testimonials") && window.matchMedia("(max-width: 767px)").matches)) return;
      pointerStart = event.clientX;
      offsetStart = Number.parseFloat(track.style.getPropertyValue("--drag-offset")) || 0;
      dragged = false;
      carousel.setPointerCapture(event.pointerId);
      track.style.animationPlayState = "paused";
    });

    carousel.addEventListener("pointermove", (event) => {
      if (!carousel.hasPointerCapture(event.pointerId)) return;
      const distance = event.clientX - pointerStart;
      if (Math.abs(distance) > 5) dragged = true;
      if (dragged) track.style.setProperty("--drag-offset", `${wrapOffset(offsetStart + distance)}px`);
    });

    const finishDrag = (event: PointerEvent) => {
      if (carousel.hasPointerCapture(event.pointerId)) carousel.releasePointerCapture(event.pointerId);
      track.style.animationPlayState = "";
    };

    carousel.addEventListener("pointerup", finishDrag);
    carousel.addEventListener("pointercancel", finishDrag);
    carousel.addEventListener("click", (event) => {
      if (!dragged) return;
      event.preventDefault();
      event.stopPropagation();
      dragged = false;
    }, true);
  });
</script>

<style>
  .freelance-carousel-section {
    --carousel-gutter: clamp(1rem, 4vw, 3.5rem);
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--carousel-gutter);
  }

  .freelance-carousel-section h2 {
    max-width: 48rem;
    margin-inline: auto;
  }

  .freelance-marquee {
    --marquee-gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .freelance-marquee::-webkit-scrollbar {
    display: none;
  }

  .freelance-marquee:active {
    cursor: grabbing;
  }

  .freelance-marquee__track {
    display: flex;
    width: max-content;
    translate: var(--drag-offset, 0px) 0;
    animation: freelance-marquee-scroll 55s linear infinite;
    will-change: transform;
  }

  .freelance-marquee__group {
    display: flex;
    flex: none;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }

  .freelance-project-card,
  .freelance-testimonial-card {
    flex: 0 0 34rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 1rem;
    background: rgb(28 35 45 / 88%);
  }

  .freelance-testimonial-card {
    flex-basis: 28rem;
    border-color: rgb(255 255 255 / 24%);
    background: transparent;
  }

  .freelance-project-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .freelance-project-card:hover,
  .freelance-project-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .freelance-project-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .freelance-project-card__preview {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 1440px;
    max-width: none;
    height: 900px;
    border: 0;
    background: white;
    pointer-events: none;
    transform: scale(var(--preview-scale, 0.5));
    transform-origin: top left;
  }

  .freelance-marquee--testimonials .freelance-marquee__track {
    animation: none;
  }

  .freelance-testimonial-card {
    display: flex;
    height: 22rem;
    flex-direction: column;
    padding: 1.75rem;
    white-space: normal;
  }

  .freelance-testimonial-card blockquote {
    flex: 1;
  }

  .freelance-marquee:hover .freelance-marquee__track,
  .freelance-marquee:focus-within .freelance-marquee__track {
    animation-play-state: paused;
  }

  @keyframes freelance-marquee-scroll {
    from { transform: translateX(-33.333333%); }
    to { transform: translateX(-66.666667%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .freelance-marquee__track {
      animation: none;
    }

    .freelance-marquee {
      mask-image: none;
    }
  }

  @media (max-width: 767px) {
    .freelance-marquee {
      mask-image: none;
      touch-action: pan-x pan-y;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .freelance-marquee:not(.freelance-marquee--testimonials) .freelance-marquee__group:nth-child(n + 2) {
      display: none;
    }

    .freelance-project-card {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .freelance-marquee__track {
      animation: none;
    }

    .freelance-project-card {
      flex-basis: min(88vw, 28rem);
    }

    .freelance-marquee--testimonials {
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      touch-action: pan-x pan-y;
    }

    .freelance-marquee--testimonials .freelance-marquee__group[data-copy="1"],
    .freelance-marquee--testimonials .freelance-marquee__group[data-copy="2"] {
      display: none;
    }

    .freelance-marquee--testimonials .freelance-marquee__group {
      align-items: flex-start;
    }

    .freelance-testimonial-card {
      flex-basis: calc(100vw - 2 * var(--carousel-gutter));
      height: auto;
      min-height: 18rem;
      padding: 1.25rem;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .freelance-testimonial-card blockquote {
      flex: 0 1 auto;
    }
  }
</style>
