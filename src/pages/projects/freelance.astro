---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <!-- Hero Section -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="fade-in-element text-4xl md:text-5xl font-serif font-bold text-white mb-6">
          Freelance Projects
        </h1>
        <p class="fade-in-element text-lg text-neutral/80 max-w-2xl mx-auto mb-12">
          Freelancing is my window to bringing creative visions to life through custom design solutions
        </p>
        
        {/* GitHub Contribution Graph */}
        <div class="fade-in-element max-w-4xl mx-auto">
          <div class="flex items-center justify-center mb-6">
            <a href="https://github.com/shiiifa" target="_blank" class="flex items-center gap-3 hover:text-primary transition-colors">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium text-lg">@shiiifa</span>
            </a>
          </div>
          
          <div class="overflow-x-auto">
            <img 
              src="https://ghchart.rshah.org/E1AD01/shiiifa" 
              alt="GitHub contribution graph for shiiifa"
              class="w-full h-auto max-w-full"
              loading="lazy"
              onerror="this.src='https://ghchart.rshah.org/shiiifa'"
            />
          </div>
          
          <div class="text-center mt-4">
            <p class="text-sm text-neutral/60">Development activity and contributions</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Project -->
    <section class="py-8 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          {/* Left Column - Heading and Description */}
          <div class="lg:col-span-1">
            <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">recent work</h2>
            
            <div class="fade-in-element text-xs text-neutral/70 leading-relaxed mb-6">
              <p class="mb-4">
                Currently building a modern and responsive portfolio website with Next.js and Tailwind CSS for a graduate student. 
                Features include optimised performance, smooth animations, and a clean, academia and research-oriented design that showcases work effectively.
              </p>
              
              <div class="mb-4">
                <h4 class="text-xs font-medium text-neutral/60 mb-2">technologies used:</h4>
                <div class="flex flex-wrap gap-1">
                  <span class="px-2 py-1 bg-primary/20 text-primary rounded text-xs">Next.js</span>
                  <span class="px-2 py-1 bg-primary/20 text-primary rounded text-xs">Tailwind CSS</span>
                  <span class="px-2 py-1 bg-primary/20 text-primary rounded text-xs">TypeScript</span>
                  <span class="px-2 py-1 bg-primary/20 text-primary rounded text-xs">Vercel</span>
                </div>
              </div>
              
              <a 
                href="https://obedbabington.vercel.app" 
                target="_blank"
                class="inline-flex items-center gap-1 bg-primary text-black px-3 py-1 rounded text-xs font-medium hover:bg-primary/90 transition-colors"
              >
                Visit Live Site
                <svg class="w-2 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          </div>
          
          {/* Right Column - Website Preview */}
          <div class="lg:col-span-2">
            <div class="fade-in-element overflow-hidden rounded-2xl border border-neutral/20 shadow-2xl">
              <iframe 
                src="https://obedbabington.vercel.app" 
                class="w-full h-[500px]"
                loading="lazy"
                title="Obed Babington Portfolio Preview"
                sandbox="allow-scripts allow-same-origin"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-8 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          {/* Left Column - Heading */}
          <div class="lg:col-span-1">
            <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">in their words</h2>
          </div>
          
          {/* Right Column - Testimonial Content */}
          <div class="lg:col-span-2">
            <div class="fade-in-element bg-[#1c232d]/85 border border-neutral/20 rounded-2xl p-6 relative overflow-hidden">
              {/* Background pattern */}
              <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
              
              {/* Quote icon */}
              <div class="relative z-10 mb-4">
                <svg class="w-6 h-6 text-primary/60" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                </svg>
              </div>
              
              {/* Testimonial content */}
              <div class="relative z-10">
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-4 italic">
                  "Shifa is a dynamic blend of intelligence, professionalism, and creativity. At a time when I was dissatisfied with my own portfolio site but lacked the time to improve it, I was relieved to discover her skill. Despite still being a student, she worked with the pace and quality of a full-time professional. The site speaks for itself."
                </blockquote>
                
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-4 italic">
                  "She transformed my site from merely informative to genuinely classy. It achieved the goal of being a digital encapsulation of what I do – and in that regard, expectations were exceeded!"
                </blockquote>
                
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-6 italic">
                  "Her ability to understand my vision, preferences, and feedback for the site, even with limited interaction, and to deliver quick, high-quality revisions was impressive."
                </blockquote>
                
                {/* Client info */}
                <div class="border-t border-neutral/20 pt-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center">
                      <span class="text-primary font-bold text-sm">OA</span>
                    </div>
                    <div>
                      <div class="font-medium text-white text-xs">Obed Allotey Babington</div>
                      <div class="text-xs text-neutral/60">Portfolio Website Client</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="py-8 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-4">wanna collab?</h2>
        <p class="fade-in-element text-lg text-neutral/80 mb-6 max-w-2xl mx-auto">
          Let's work together to bring your portfolio vision to life. I specialise in creating modern, responsive portfolio websites that showcase your work effectively.
        </p>
        
        <a 
          href="mailto:shifa.gabbey@ashesi.edu.gh" 
          class="fade-in-element bg-primary text-black px-6 py-3 rounded-full text-sm font-medium hover:bg-primary/90 transition-colors flex items-center gap-2 inline-flex"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Get In Touch
        </a>
      </div>
    </section>
  </main>
</Layout>
