---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <!-- Hero Section -->
    <section class="py-20 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-serif font-bold text-primary mb-6">
          Freelance Work
        </h1>
        <p class="text-xl text-neutral/80 max-w-2xl mx-auto">
          Bringing creative visions to life through custom web development and design solutions
        </p>
      </div>
    </section>

    <!-- Featured Project -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-serif font-bold text-primary mb-4">Portfolio Optimization</h2>
          <p class="text-neutral/70">Custom portfolio website development and optimization</p>
        </div>
        
        {/* Horizontal Project Card */}
        <div class="bg-[#1c232d]/85 rounded-2xl p-8 border border-neutral/20 hover:border-primary/30 transition-all duration-500">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            {/* Project Info */}
            <div>
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"/>
                </svg>
                <span class="text-white font-medium text-lg">obedbabington.vercel.app</span>
              </div>
              
              <h3 class="text-2xl font-serif font-bold text-primary mb-4">Portfolio Website Development</h3>
              <p class="text-neutral/80 mb-6">
                A modern, responsive portfolio website built with Next.js and Tailwind CSS. Features include optimized performance, 
                smooth animations, and a clean, professional design that showcases work effectively.
              </p>
              
              {/* Technologies Used */}
              <div class="mb-6">
                <h4 class="text-sm font-medium text-neutral/60 mb-3">Technologies Used:</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Next.js</span>
                  <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Tailwind CSS</span>
                  <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">TypeScript</span>
                  <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Vercel</span>
                </div>
              </div>
              
              <a 
                href="https://obedbabington.vercel.app" 
                target="_blank"
                class="inline-flex items-center gap-2 bg-primary text-black px-6 py-3 rounded-full font-medium hover:bg-primary/90 transition-colors"
              >
                Visit Live Site
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
            
            {/* Project Preview */}
            <div class="overflow-hidden rounded-lg border border-neutral/20">
              <iframe 
                src="https://obedbabington.vercel.app" 
                class="w-full h-96"
                loading="lazy"
                title="Obed Babington Portfolio Preview"
                sandbox="allow-scripts allow-same-origin"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GitHub Activity -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-serif font-bold text-primary mb-4">Development Activity</h2>
          <p class="text-neutral/70">My GitHub contributions and coding activity</p>
        </div>
        
        <div class="bg-[#1c232d]/85 rounded-2xl p-8 border border-neutral/20">
          <div class="flex items-center justify-center mb-6">
            <a href="https://github.com/shiiifa" target="_blank" class="flex items-center gap-3 hover:text-primary transition-colors">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium text-lg">@shiiifa</span>
            </a>
          </div>
          
          {/* Contribution Activity */}
          <div class="mb-8">
            <h3 class="text-lg font-medium text-white mb-4 text-center">Contribution Activity</h3>
            <div class="overflow-hidden rounded-lg">
              <img 
                src="https://ghchart.rshah.org/E1AD01/shiiifa" 
                alt="GitHub contribution graph for shiiifa"
                class="w-full h-auto"
                loading="lazy"
                onerror="this.src='https://ghchart.rshah.org/shiiifa'"
              />
            </div>
          </div>
          
          {/* Legend */}
          <div class="flex items-center justify-between text-sm text-neutral/60">
            <span>Less</span>
            <div class="flex gap-2">
              <div class="w-4 h-4 bg-neutral/20 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/20 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/40 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/60 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary rounded-sm"></div>
            </div>
            <span>More</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="py-16 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-[#1c232d]/85 rounded-2xl p-12 border border-neutral/20">
          <h2 class="text-4xl font-serif font-bold text-primary mb-6">Wanna Collab?</h2>
          <p class="text-xl text-neutral/80 mb-8 max-w-2xl mx-auto">
            Let's work together to bring your ideas to life. Whether it's a portfolio, business website, or custom web application, I'm here to help.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a 
              href="mailto:shifa.gabbey@ashesi.edu.gh" 
              class="bg-primary text-black px-8 py-4 rounded-full font-medium hover:bg-primary/90 transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Get In Touch
            </a>
            
            <a 
              href="https://github.com/shiiifa" 
              target="_blank"
              class="border border-primary text-primary px-8 py-4 rounded-full font-medium hover:bg-primary/10 transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
