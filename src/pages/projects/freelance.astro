---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONTENT } from "@config";

// Get completed freelance projects
const completedProjects = SITE_CONTENT.freelanceProjects.filter(p => p.status === "Completed");
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <!-- Hero Section -->
    <section class="py-16 px-6">
      <div class="text-center">
        <h1 class="fade-in-element text-4xl md:text-5xl font-serif font-bold text-white mb-6">
          freelance projects
        </h1>
        <p class="fade-in-element text-lg text-neutral/80 mb-12">
          Freelancing is my window to bringing creative visions to life through custom design solutions
        </p>
        
        {/* GitHub Contribution Graph */}
        <div class="fade-in-element">
          <div class="flex items-center justify-center mb-6">
            <a href="https://github.com/shiiifa" target="_blank" class="flex items-center gap-3 hover:text-primary transition-colors">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium text-lg">@shiiifa</span>
            </a>
          </div>
          
          <div>
            <img 
              src="https://ghchart.rshah.org/E1AD01/shiiifa" 
              alt="GitHub contribution graph for shiiifa"
              class="w-full h-auto max-w-full"
              loading="lazy"
              onerror="this.setAttribute('src', 'https://ghchart.rshah.org/shiiifa')"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-8 px-6">
      <div>
        <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">recent work</h2>
        
        <div class="relative">
          {/* Navigation Buttons */}
          {completedProjects.length > 1 && (
            <>
              <button 
                id="prevProjectBtn" 
                class="absolute left-2 top-1/2 z-20 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 text-primary hover:bg-primary/30 transition-all duration-200 backdrop-blur-sm border border-primary/10"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              
              <button 
                id="nextProjectBtn" 
                class="absolute right-2 top-1/2 z-20 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 text-primary hover:bg-primary/30 transition-all duration-200 backdrop-blur-sm border border-primary/10"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </>
          )}

          {/* Projects Container */}
          <div id="projectsCarousel" class="relative overflow-hidden rounded-lg">
            {completedProjects.map((project, index) => (
              <div 
                class={`project-tile ${index === 0 ? 'active' : 'hidden'}`}
                data-index={index}
              >
                <div class="fade-in-element overflow-hidden rounded-lg border border-neutral/20 shadow-lg mb-4">
                  <iframe 
                    src={project.linkSource} 
                    class="w-full h-[400px]"
                    loading="lazy"
                    title={`${project.name} Preview`}
                    sandbox="allow-scripts allow-same-origin"
                  ></iframe>
                </div>
                
                {/* View Full Site Button */}
                {project.linkSource && (
                  <div class="flex justify-center">
                    <a 
                      href={project.linkSource} 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 bg-primary text-black px-6 py-2 rounded-full text-sm font-medium hover:bg-primary/90 transition-colors"
                    >
                      View Full Site
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-8 px-6">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          {/* Left Column - Heading */}
          <div class="lg:col-span-1">
            <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">in their words</h2>
          </div>
          
          {/* Right Column - Testimonial Carousel */}
          <div class="lg:col-span-2 relative">
            {/* Navigation Buttons */}
            <button 
              id="prevTestimonialBtn" 
              class="absolute left-2 top-1/2 z-20 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 text-primary hover:bg-primary/30 transition-all duration-200 backdrop-blur-sm border border-primary/10"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            
            <button 
              id="nextTestimonialBtn" 
              class="absolute right-2 top-1/2 z-20 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 text-primary hover:bg-primary/30 transition-all duration-200 backdrop-blur-sm border border-primary/10"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>

            {/* Testimonial Carousel Container */}
            <div id="testimonialCarousel" class="relative overflow-hidden rounded-lg">
              {/* Testimonial Slide 1 - Obed Part 1 */}
              <div class="testimonial-slide active bg-[#1c232d]/85 border border-neutral/20 rounded-lg p-6 relative min-h-[250px]">
                <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
                <div class="relative z-10">
                  <svg class="w-6 h-6 text-primary/60 mb-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                  </svg>
                  <blockquote class="text-sm text-neutral/80 leading-relaxed mb-6 italic">
                    "Shifa is a dynamic blend of intelligence, professionalism, and creativity. At a time when I was dissatisfied with my own portfolio site but lacked the time to improve it, I was relieved to discover her skill. Despite still being a student, she worked with the pace and quality of a full-time professional. The site speaks for itself."
                  </blockquote>
                  <div class="border-t border-neutral/20 pt-4">
                    <div class="font-medium text-white text-sm">Obed Allotey Babington</div>
                  </div>
                </div>
              </div>

              {/* Testimonial Slide 2 - Obed Part 2 */}
              <div class="testimonial-slide hidden bg-[#1c232d]/85 border border-neutral/20 rounded-lg p-6 relative min-h-[250px]">
                <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
                <div class="relative z-10">
                  <svg class="w-6 h-6 text-primary/60 mb-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                  </svg>
                  <blockquote class="text-sm text-neutral/80 leading-relaxed mb-6 italic">
                    "She transformed my site from merely informative to genuinely classy. It achieved the goal of being a digital encapsulation of what I do – and in that regard, expectations were exceeded! Her ability to understand my vision, preferences, and feedback for the site, even with limited interaction, and to deliver quick, high-quality revisions was impressive."
                  </blockquote>
                  <div class="border-t border-neutral/20 pt-4">
                    <div class="font-medium text-white text-sm">Obed Allotey Babington</div>
                  </div>
                </div>
              </div>

              {/* Testimonial Slide 3 - Elmir Part 1 */}
              <div class="testimonial-slide hidden bg-[#1c232d]/85 border border-neutral/20 rounded-lg p-6 relative min-h-[250px]">
                <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
                <div class="relative z-10">
                  <svg class="w-6 h-6 text-primary/60 mb-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                  </svg>
                  <blockquote class="text-sm text-neutral/80 leading-relaxed mb-6 italic">
                    "Shifa is an exceptionally professional and reliable individual. She consistently met deadlines and communicated through channels that fit my schedule, making the entire collaboration seamless. Her time consciousness and commitment to maintaining a high standard of work were truly impressive."
                  </blockquote>
                  <div class="border-t border-neutral/20 pt-4">
                    <div class="font-medium text-white text-sm">Elmir</div>
                  </div>
                </div>
              </div>

              {/* Testimonial Slide 4 - Elmir Part 2 */}
              <div class="testimonial-slide hidden bg-[#1c232d]/85 border border-neutral/20 rounded-lg p-6 relative min-h-[250px]">
                <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
                <div class="relative z-10">
                  <svg class="w-6 h-6 text-primary/60 mb-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                  </svg>
                  <blockquote class="text-sm text-neutral/80 leading-relaxed mb-6 italic">
                    "What stood out most was her flexibility; she was always willing to make adjustments to ensure the final result perfectly matched my vision. I would highly recommend Shifa for any project requiring strong web design skills and a professional touch. I loved how clean and well-structured the website was. The design was simple, elegant, and perfectly aligned with what I needed. The responsiveness was top-notch across all devices, and I encountered no issues with timelines or delivery. Everything was handled with a high level of professionalism from start to finish."
                  </blockquote>
                  <div class="border-t border-neutral/20 pt-4">
                    <div class="font-medium text-white text-sm">Elmir</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="py-8 px-6">
      <div class="text-center">
        <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-4">wanna collab?</h2>
        <p class="fade-in-element text-lg text-neutral/80 mb-6">
          Let's work together to bring your portfolio vision to life. I specialise in creating modern, responsive portfolio websites that showcase your work effectively.
        </p>
        
        <a 
          href="https://forms.gle/sqDJL1oFx2auLvkm9" 
          target="_blank"
          class="fade-in-element bg-primary text-black px-6 py-3 rounded-full text-sm font-medium hover:bg-primary/90 transition-colors inline-flex"
        >
          Get In Touch
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Projects Carousel
    const projectTiles = document.querySelectorAll('.project-tile');
    const prevProjectBtn = document.getElementById('prevProjectBtn');
    const nextProjectBtn = document.getElementById('nextProjectBtn');
    let currentProjectIndex = 0;

    if (projectTiles.length > 1) {
      function showProject(index: number) {
        projectTiles.forEach((tile, i) => {
          if (i === index) {
            tile.classList.remove('hidden');
            tile.classList.add('active');
          } else {
            tile.classList.add('hidden');
            tile.classList.remove('active');
          }
        });

        if (prevProjectBtn) {
          prevProjectBtn.style.opacity = index === 0 ? '0.5' : '1';
          prevProjectBtn.style.pointerEvents = index === 0 ? 'none' : 'auto';
        }
        if (nextProjectBtn) {
          nextProjectBtn.style.opacity = index === projectTiles.length - 1 ? '0.5' : '1';
          nextProjectBtn.style.pointerEvents = index === projectTiles.length - 1 ? 'none' : 'auto';
        }
      }

      if (prevProjectBtn) {
        prevProjectBtn.addEventListener('click', () => {
          if (currentProjectIndex > 0) {
            currentProjectIndex--;
            showProject(currentProjectIndex);
          }
        });
      }

      if (nextProjectBtn) {
        nextProjectBtn.addEventListener('click', () => {
          if (currentProjectIndex < projectTiles.length - 1) {
            currentProjectIndex++;
            showProject(currentProjectIndex);
          }
        });
      }

      showProject(0);
    } else {
      if (prevProjectBtn) prevProjectBtn.style.display = 'none';
      if (nextProjectBtn) nextProjectBtn.style.display = 'none';
    }

    // Testimonials Carousel
    const testimonialSlides = document.querySelectorAll('.testimonial-slide');
    const prevTestimonialBtn = document.getElementById('prevTestimonialBtn');
    const nextTestimonialBtn = document.getElementById('nextTestimonialBtn');
    let currentTestimonialIndex = 0;

    function showTestimonial(index: number) {
      testimonialSlides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('hidden');
          slide.classList.add('active');
        } else {
          slide.classList.add('hidden');
          slide.classList.remove('active');
        }
      });

      if (prevTestimonialBtn) {
        prevTestimonialBtn.style.opacity = index === 0 ? '0.5' : '1';
        prevTestimonialBtn.style.pointerEvents = index === 0 ? 'none' : 'auto';
      }
      if (nextTestimonialBtn) {
        nextTestimonialBtn.style.opacity = index === testimonialSlides.length - 1 ? '0.5' : '1';
        nextTestimonialBtn.style.pointerEvents = index === testimonialSlides.length - 1 ? 'none' : 'auto';
      }
    }

    if (prevTestimonialBtn) {
      prevTestimonialBtn.addEventListener('click', () => {
        if (currentTestimonialIndex > 0) {
          currentTestimonialIndex--;
          showTestimonial(currentTestimonialIndex);
        }
      });
    }

    if (nextTestimonialBtn) {
      nextTestimonialBtn.addEventListener('click', () => {
        if (currentTestimonialIndex < testimonialSlides.length - 1) {
          currentTestimonialIndex++;
          showTestimonial(currentTestimonialIndex);
        }
      });
    }

    showTestimonial(0);
  });
</script>
