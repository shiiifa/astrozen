---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <!-- Hero Section -->
    <section class="py-16 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="fade-in-element text-4xl md:text-5xl font-serif font-bold text-white mb-6">
          freelance projects
        </h1>
        <p class="fade-in-element text-lg text-neutral/80 max-w-2xl mx-auto mb-12">
          Freelancing is my window to bringing creative visions to life through custom design solutions
        </p>
        
        {/* GitHub Contribution Graph */}
        <div class="fade-in-element max-w-4xl mx-auto">
          <div class="flex items-center justify-center mb-6">
            <a href="https://github.com/shiiifa" target="_blank" class="flex items-center gap-3 hover:text-primary transition-colors">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium text-lg">@shiiifa</span>
            </a>
          </div>
          
          <div>
            <img 
              src="https://ghchart.rshah.org/E1AD01/shiiifa" 
              alt="GitHub contribution graph for shiiifa"
              class="w-full h-auto max-w-full"
              loading="lazy"
              onerror="this.src='https://ghchart.rshah.org/shiiifa'"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Project -->
    <section class="py-8 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          {/* Left Column - Heading and Description */}
          <div class="lg:col-span-1">
            <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">recent work</h2>
            
            <div class="fade-in-element text-xs text-neutral/70 leading-relaxed mb-6">
              <p class="mb-4">
                Built a modern and responsive portfolio website with Next.js and Tailwind CSS for a prospective grad student. 
                Features included optimised performance, smooth animations, and a clean, academia and research-oriented design that showcases work effectively.
              </p>
            </div>
          </div>
          
          {/* Right Column - Website Preview */}
          <div class="lg:col-span-2">
            <div class="fade-in-element overflow-hidden rounded-lg border border-neutral/20 shadow-lg mb-4">
              <iframe 
                src="https://obedbabington.vercel.app" 
                class="w-full h-[300px]"
                loading="lazy"
                title="Obed Babington Portfolio Preview"
                sandbox="allow-scripts allow-same-origin"
              ></iframe>
            </div>
            
            {/* Technologies and Visit Live Site */}
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <h4 class="text-xs font-medium text-neutral/60">technologies used:</h4>
                <div class="flex gap-2">
                  {/* Next.js Icon */}
                  <div class="w-6 h-6 bg-black rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M11.572 0c-.176 0-.31.001-.358.007a6.03 6.03 0 0 0-.71.093c-.036.01-.07.02-.1.033a6.094 6.094 0 0 0-1.108.57c-.27.16-.515.342-.735.545a5.933 5.933 0 0 0-.622.806 6.017 6.017 0 0 0-.454 1.006 5.922 5.922 0 0 0-.2.59c-.01.04-.02.08-.028.12a5.956 5.956 0 0 0-.08.65c-.002.05-.003.1-.003.15v11.2c0 .05.001.1.003.15.002.22.01.44.03.65.01.04.02.08.03.12.02.2.05.4.09.59.01.04.02.08.03.12.05.2.11.4.18.59.01.04.03.08.04.12.08.19.17.38.27.56.01.02.03.04.04.06.1.17.22.34.35.5.01.02.03.04.04.06.13.16.27.31.43.45.01.02.03.04.05.06.16.14.33.27.51.38.01.01.03.03.05.04.18.11.37.21.57.29.01.01.03.02.04.03.2.08.41.14.63.18.01 0 .03.01.04.01.22.04.45.06.68.06h.01c.23 0 .46-.02.68-.06.01 0 .03-.01.04-.01.22-.04.43-.1.63-.18.01-.01.03-.02.04-.03.2-.08.39-.18.57-.29.02-.01.04-.03.05-.04.18-.11.35-.24.51-.38.02-.02.04-.04.05-.06.16-.14.3-.29.43-.45.01-.02.03-.04.04-.06.13-.16.25-.33.35-.5.01-.02.03-.04.04-.06.1-.18.19-.37.27-.56.01-.04.03-.08.04-.12.07-.19.13-.39.18-.59.01-.04.02-.08.03-.12.04-.19.07-.39.09-.59.01-.04.02-.08.03-.12.02-.21.03-.43.03-.65.002-.05.003-.1.003-.15V2.4c0-.05-.001-.1-.003-.15a5.956 5.956 0 0 0-.08-.65c-.008-.04-.018-.08-.028-.12a5.922 5.922 0 0 0-.2-.59 6.017 6.017 0 0 0-.454-1.006 5.933 5.933 0 0 0-.622-.806 5.933 5.933 0 0 0-.735-.545 6.094 6.094 0 0 0-1.108-.57c-.03-.013-.064-.023-.1-.033a6.03 6.03 0 0 0-.71-.093C11.882.001 11.748 0 11.572 0zm5.033 4.24c.23 0 .44.02.65.07.2.05.4.11.58.19.18.08.35.18.51.29.16.11.31.24.45.38.14.14.26.29.37.45.11.16.2.33.28.51.08.18.14.37.19.57.05.2.07.41.07.63v8.23c0 .22-.02.43-.07.63-.05.2-.11.39-.19.57-.08.18-.17.35-.28.51-.11.16-.23.31-.37.45-.14.14-.29.27-.45.38-.16.11-.33.21-.51.29-.18.08-.38.14-.58.19-.21.05-.42.07-.65.07H9.182c-.22 0-.43-.02-.63-.07-.2-.05-.39-.11-.57-.19-.18-.08-.35-.18-.51-.29-.16-.11-.31-.24-.45-.38-.14-.14-.26-.29-.37-.45-.11-.16-.2-.33-.28-.51-.08-.18-.14-.37-.19-.57-.05-.2-.07-.41-.07-.63V6.44c0-.22.02-.43.07-.63.05-.2.11-.39.19-.57.08-.18.17-.35.28-.51.11-.16.23-.31.37-.45.14-.14.29-.27.45-.38.16-.11.33-.21.51-.29.18-.08.38-.14.58-.19.21-.05.42-.07.65-.07h7.423z"/>
                    </svg>
                  </div>
                  
                  {/* Tailwind CSS Icon */}
                  <div class="w-6 h-6 bg-cyan-500 rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z"/>
                    </svg>
                  </div>
                  
                  {/* TypeScript Icon */}
                  <div class="w-6 h-6 bg-blue-600 rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.104.156.252.304.443.444s.423.276.696.41c.273.135.582.274.926.416.47.197.892.407 1.266.628.374.222.695.473.963.753.268.279.472.598.614.957.142.359.214.776.214 1.253 0 .657-.125 1.21-.373 1.656a3.033 3.033 0 0 1-1.012 1.085 4.38 4.38 0 0 1-1.487.596c-.566.12-1.163.18-1.79.18a9.916 9.916 0 0 1-1.84-.164 5.544 5.544 0 0 1-1.512-.493v-2.63a5.033 5.033 0 0 0 3.237 1.2c.333 0 .624-.03.872-.09.249-.06.456-.144.623-.25.166-.108.29-.234.373-.38a1.023 1.023 0 0 0-.074-1.089 2.12 2.12 0 0 0-.537-.5 5.597 5.597 0 0 0-.807-.444 27.72 27.72 0 0 0-1.007-.436c-.918-.383-1.602-.852-2.053-1.405-.45-.553-.676-1.222-.676-2.005 0-.614.123-1.141.369-1.582.246-.441.58-.804 1.004-1.089a4.494 4.494 0 0 1 1.47-.629 7.536 7.536 0 0 1 1.77-.201zm-15.113.188h9.563v2.166H9.506v9.646H6.789v-9.646H3.375z"/>
                    </svg>
                  </div>
                  
                  {/* Vercel Icon */}
                  <div class="w-6 h-6 bg-black rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M24 22.525H0l12-21.05 12 21.05z"/>
                    </svg>
                  </div>
                </div>
              </div>
              
              <a 
                href="https://obedbabington.vercel.app" 
                target="_blank"
                class="inline-flex items-center gap-1 bg-primary text-black px-3 py-1 rounded text-xs font-medium hover:bg-primary/90 transition-colors"
              >
                Visit Live Site
                <svg class="w-2 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-8 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          {/* Left Column - Heading */}
          <div class="lg:col-span-1">
            <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-6">in their words</h2>
          </div>
          
          {/* Right Column - Testimonial Content */}
          <div class="lg:col-span-2">
            <div class="fade-in-element bg-[#1c232d]/85 border border-neutral/20 rounded-lg p-6 relative overflow-y-auto h-[200px] scrollbar-thin scrollbar-thumb-neutral/40 scrollbar-track-transparent">
              {/* Background pattern */}
              <div class="absolute inset-0 opacity-[3%] bg-[url(/raja.png)] bg-[length:128px] bg-repeat"></div>
              
              {/* Quote icon */}
              <div class="relative z-10 mb-4">
                <svg class="w-6 h-6 text-primary/60" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                </svg>
              </div>
              
              {/* Testimonial content */}
              <div class="relative z-10">
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-4 italic">
                  "Shifa is a dynamic blend of intelligence, professionalism, and creativity. At a time when I was dissatisfied with my own portfolio site but lacked the time to improve it, I was relieved to discover her skill. Despite still being a student, she worked with the pace and quality of a full-time professional. The site speaks for itself."
                </blockquote>
                
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-4 italic">
                  "She transformed my site from merely informative to genuinely classy. It achieved the goal of being a digital encapsulation of what I do – and in that regard, expectations were exceeded!"
                </blockquote>
                
                <blockquote class="text-xs text-neutral/80 leading-relaxed mb-6 italic">
                  "Her ability to understand my vision, preferences, and feedback for the site, even with limited interaction, and to deliver quick, high-quality revisions was impressive."
                </blockquote>
                
                {/* Client name */}
                <div class="border-t border-neutral/20 pt-4">
                  <div class="font-medium text-white text-xs">Obed Allotey Babington</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="py-8 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="fade-in-element text-2xl font-serif font-bold text-primary mb-4">wanna collab?</h2>
        <p class="fade-in-element text-lg text-neutral/80 mb-6 max-w-2xl mx-auto">
          Let's work together to bring your portfolio vision to life. I specialise in creating modern, responsive portfolio websites that showcase your work effectively.
        </p>
        
        <a 
          href="https://forms.gle/sqDJL1oFx2auLvkm9" 
          target="_blank"
          class="fade-in-element bg-primary text-black px-6 py-3 rounded-full text-sm font-medium hover:bg-primary/90 transition-colors inline-flex"
        >
          Get In Touch
        </a>
      </div>
    </section>
  </main>
</Layout>
