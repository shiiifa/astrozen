---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Freelance Work - Shifa Amankwa-Gabbey">
  <main class="min-h-screen bg-black text-white">
    <!-- Hero Section with Collage Background -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
      {/* Background Collage */}
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        <div class="absolute inset-0 opacity-20">
          <div class="absolute top-10 left-10 w-32 h-32 bg-primary/10 rounded-full blur-xl"></div>
          <div class="absolute top-1/3 right-20 w-24 h-24 bg-green-500/10 rounded-full blur-lg"></div>
          <div class="absolute bottom-20 left-1/4 w-40 h-40 bg-blue-500/10 rounded-full blur-2xl"></div>
          <div class="absolute bottom-1/3 right-1/3 w-28 h-28 bg-yellow-500/10 rounded-full blur-lg"></div>
        </div>
      </div>
      
      {/* Content */}
      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <div class="mb-8">
          <div class="inline-flex items-center gap-3 bg-slate-800/50 backdrop-blur-sm rounded-full px-6 py-3 border border-slate-700/50 mb-8">
            <div class="w-3 h-3 bg-primary rounded-full"></div>
            <span class="text-white text-sm font-medium">obedbabington.vercel.app</span>
            <a href="https://obedbabington.vercel.app" target="_blank" class="text-white hover:text-primary transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
          Hi, I am <span class="text-primary">Obed</span>, a research assistant at Ashesi University, blending ideas from hardware, software, and artificial intelligence to build future-ready systems.
        </h1>
        
        <div class="bg-green-600 rounded-2xl p-6 mb-8 max-w-2xl mx-auto">
          <div class="flex items-center justify-center gap-4">
            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center">
              <span class="text-green-600 font-bold text-xl">O</span>
            </div>
            <span class="text-white text-xl font-semibold">Welcome To My World!</span>
          </div>
        </div>
        
        <div class="text-white/80 text-sm mb-4">©2025 | Obed Allotey Babington</div>
        
        <div class="flex items-center justify-center gap-6">
          <a href="https://linkedin.com/in/obed-babington" target="_blank" class="text-white hover:text-primary transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:obed@example.com" class="text-white hover:text-primary transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Project Section -->
    <section class="py-20 px-6 bg-slate-900/50">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-primary mb-4">Portfolio Website Development</h2>
          <p class="text-white/80 text-lg max-w-2xl mx-auto">
            A modern, responsive portfolio website built with Next.js and Tailwind CSS. Features include optimized performance, 
            smooth animations, and a clean, professional design that showcases work effectively.
          </p>
        </div>
        
        <div class="mb-8">
          <h3 class="text-white text-lg mb-4">Technologies Used:</h3>
          <div class="flex flex-wrap gap-3 justify-center">
            <span class="px-4 py-2 bg-primary text-black rounded-full font-medium">Next.js</span>
            <span class="px-4 py-2 bg-primary text-black rounded-full font-medium">Tailwind CSS</span>
            <span class="px-4 py-2 bg-primary text-black rounded-full font-medium">TypeScript</span>
            <span class="px-4 py-2 bg-primary text-black rounded-full font-medium">Vercel</span>
          </div>
        </div>
        
        <div class="text-center">
          <a 
            href="https://obedbabington.vercel.app" 
            target="_blank"
            class="inline-flex items-center gap-2 bg-primary text-black px-8 py-4 rounded-full font-semibold hover:bg-primary/90 transition-colors text-lg"
          >
            Visit Live Site
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- GitHub Activity -->
    <section class="py-16 px-6 bg-slate-800/30">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-primary mb-4">Development Activity</h2>
          <p class="text-white/70">My GitHub contributions and coding activity</p>
        </div>
        
        <div class="bg-slate-900/50 rounded-2xl p-8 border border-slate-700/50">
          <div class="flex items-center justify-center mb-6">
            <a href="https://github.com/shiiifa" target="_blank" class="flex items-center gap-3 hover:text-primary transition-colors">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium text-lg">@shiiifa</span>
            </a>
          </div>
          
          {/* Contribution Activity */}
          <div class="mb-8">
            <h3 class="text-lg font-medium text-white mb-4 text-center">Contribution Activity</h3>
            <div class="overflow-hidden rounded-lg">
              <img 
                src="https://ghchart.rshah.org/E1AD01/shiiifa" 
                alt="GitHub contribution graph for shiiifa"
                class="w-full h-auto"
                loading="lazy"
                onerror="this.src='https://ghchart.rshah.org/shiiifa'"
              />
            </div>
          </div>
          
          {/* Legend */}
          <div class="flex items-center justify-between text-sm text-white/60">
            <span>Less</span>
            <div class="flex gap-2">
              <div class="w-4 h-4 bg-white/20 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/20 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/40 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary/60 rounded-sm"></div>
              <div class="w-4 h-4 bg-primary rounded-sm"></div>
            </div>
            <span>More</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration CTA -->
    <section class="py-16 px-6 bg-slate-900/30">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-slate-800/50 rounded-2xl p-12 border border-slate-700/50">
          <h2 class="text-4xl font-bold text-primary mb-6">Wanna Collab?</h2>
          <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
            Let's work together to bring your ideas to life. Whether it's a portfolio, business website, or custom web application, I'm here to help.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a 
              href="mailto:shifa.gabbey@ashesi.edu.gh" 
              class="bg-primary text-black px-8 py-4 rounded-full font-semibold hover:bg-primary/90 transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Get In Touch
            </a>
            
            <a 
              href="https://github.com/shiiifa" 
              target="_blank"
              class="border border-primary text-primary px-8 py-4 rounded-full font-semibold hover:bg-primary/10 transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
