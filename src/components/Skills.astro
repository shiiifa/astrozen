---
import Section from "./Section.astro";
import type { SkillProps } from "@types";

interface Props {
  skills: SkillProps[];
}

const { skills } = Astro.props;
---

<Section text="skills" href="skills">
  <div class="skills-layout grid grid-cols-1 justify-items-center gap-16 px-4 md:grid-cols-3 md:gap-8">
    {skills.map((skill) => (
      <details class="skill-orbit">
        <summary class="skill-orbit__trigger">
          <span>{skill.category}</span>
        </summary>
        <div class="skill-orbit__popup" role="region" aria-label={`${skill.category} details`}>
          {skill.tools.split('\n').map((tool) => {
            const [label, ...details] = tool.split(":");
            return (
              <p class="skill-orbit__item">
                <strong>{details.length ? `${label}: ` : ""}</strong>{details.length ? details.join(":") : label}
              </p>
            );
          })}
        </div>
      </details>
    ))}
  </div>
</Section>

<style>
  .skill-orbit {
    position: relative;
    z-index: 0;
  }

  .skills-layout {
    position: relative;
    z-index: 1;
    padding-bottom: 8rem;
  }

  .skill-orbit:hover,
  .skill-orbit:focus-within,
  .skill-orbit[open] {
    z-index: 50;
  }

  .skill-orbit__trigger {
    display: grid;
    width: clamp(7.5rem, 12vw, 9rem);
    aspect-ratio: 1;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--color-primary);
    border-radius: 9999px;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    list-style: none;
    text-align: center;
    transition: border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  .skill-orbit__trigger::-webkit-details-marker {
    display: none;
  }

  .skill-orbit__trigger::marker {
    content: "";
  }

  .skill-orbit:hover .skill-orbit__trigger,
  .skill-orbit:focus-within .skill-orbit__trigger,
  .skill-orbit[open] .skill-orbit__trigger {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    background: transparent;
    box-shadow: 0 0 16px rgb(225 173 1 / 48%), 0 0 42px rgb(225 173 1 / 24%);
  }

  .skill-orbit__popup {
    position: absolute;
    z-index: 60;
    top: calc(100% + 1rem);
    left: 50%;
    width: min(20rem, 88vw);
    padding: 1rem 1.25rem;
    border: 1px solid rgb(225 173 1 / 40%);
    border-radius: 1rem;
    background: rgb(28 35 45 / 98%);
    box-shadow: 0 18px 48px rgb(0 0 0 / 40%);
    color: var(--color-neutral);
    font-size: 0.9375rem;
    line-height: 1.45;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.25rem);
    transition: opacity 160ms ease, transform 160ms ease;
    visibility: hidden;
  }

  .skill-orbit:hover .skill-orbit__popup,
  .skill-orbit:focus-within .skill-orbit__popup,
  .skill-orbit[open] .skill-orbit__popup {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
    visibility: visible;
  }

  .skill-orbit__item {
    opacity: 1;
    transform: none;
  }

  .skill-orbit__item + .skill-orbit__item {
    margin-top: 0.65rem;
  }

  .skill-orbit__item strong {
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-orbit__trigger,
    .skill-orbit__popup {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".skill-orbit").forEach((orbit) => {
    orbit.addEventListener("pointerenter", () => {
      orbit.open = true;
    });

    orbit.addEventListener("pointerleave", () => {
      if (!orbit.matches(":focus-within")) orbit.open = false;
    });

    orbit.addEventListener("focusin", () => {
      orbit.open = true;
    });

    orbit.addEventListener("focusout", (event) => {
      if (!orbit.contains(event.relatedTarget as Node | null)) orbit.open = false;
    });
  });
</script>
