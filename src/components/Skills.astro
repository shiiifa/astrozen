---
import Section from "./Section.astro";
import type { SkillProps } from "@types";

interface Props {
  skills: SkillProps[];
}

const { skills } = Astro.props;
---

<Section text="skills" href="skills">
  <div class="skills-layout grid grid-cols-3 justify-items-center gap-2 px-1 md:gap-8">
    {skills.map((skill, index) => (
      <div class="skill-orbit" data-skill-orbit>
        <button
          class="skill-orbit__trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls={`skill-dialog-${index}`}
          data-skill-trigger
        >
          {skill.category}
        </button>
        <dialog
          id={`skill-dialog-${index}`}
          class="skill-orbit__popup"
          aria-labelledby={`skill-heading-${index}`}
          data-skill-dialog
        >
          <div class="skill-orbit__header">
            <h3 id={`skill-heading-${index}`} class="skill-orbit__title">{skill.category}</h3>
            <button
              class="skill-orbit__close"
              type="button"
              aria-label={`Close ${skill.category} details`}
              data-close-dialog
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <div class="skill-orbit__items">
            {skill.tools.split("\n").map((tool) => <p class="skill-orbit__item">{tool}</p>)}
          </div>
        </dialog>
      </div>
    ))}
  </div>
</Section>

<style>
  .skills-layout {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
  }

  .skill-orbit {
    display: grid;
    place-items: center;
  }

  .skill-orbit__trigger {
    display: grid;
    width: clamp(5.25rem, 22vw, 9rem);
    aspect-ratio: 1;
    place-items: center;
    padding: 0.65rem;
    border: 1px solid var(--color-primary);
    border-radius: 9999px;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(0.75rem, 2.5vw, 1.125rem);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .skill-orbit__trigger:focus-visible,
  .skill-orbit__trigger:active {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: 0 0 16px rgb(225 173 1 / 48%), 0 0 42px rgb(225 173 1 / 24%);
  }

  .skill-orbit__trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .skill-orbit__trigger:hover {
      transform: translateY(-2px);
      border-color: var(--color-primary);
      box-shadow: 0 0 16px rgb(225 173 1 / 48%), 0 0 42px rgb(225 173 1 / 24%);
    }
  }

  .skill-orbit__popup {
    position: fixed;
    inset: 0;
    width: min(30rem, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    max-height: min(80dvh, 36rem);
    margin: auto;
    overflow-y: auto;
    padding: 1.25rem;
    border: 1px solid rgb(225 173 1 / 45%);
    border-radius: 1rem;
    background: var(--color-background);
    box-shadow: 0 22px 64px rgb(0 0 0 / 55%);
    color: var(--color-neutral);
  }

  .skill-orbit__popup::backdrop {
    background: rgb(0 0 0 / 68%);
    backdrop-filter: blur(3px);
  }

  .skill-orbit__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .skill-orbit__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 5vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .skill-orbit__close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    place-items: center;
    border: 1px solid rgb(225 173 1 / 38%);
    border-radius: 9999px;
    background: rgb(255 255 255 / 5%);
    color: var(--color-primary);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .skill-orbit__close:hover,
  .skill-orbit__close:focus-visible {
    background: var(--color-primary);
    color: var(--color-background);
  }

  .skill-orbit__close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .skill-orbit__items {
    overflow-wrap: anywhere;
  }

  .skill-orbit__item {
    margin: 0;
    color: var(--color-neutral);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .skill-orbit__item + .skill-orbit__item {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  @media (max-width: 480px) {
    .skill-orbit__popup {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-orbit__trigger,
    .skill-orbit__close {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-skill-orbit]").forEach((orbit) => {
    const trigger = orbit.querySelector<HTMLButtonElement>("[data-skill-trigger]");
    const dialog = orbit.querySelector<HTMLDialogElement>("[data-skill-dialog]");
    const closeButton = orbit.querySelector<HTMLButtonElement>("[data-close-dialog]");

    if (!trigger || !dialog || !closeButton) return;

    trigger.addEventListener("click", () => {
      if (!dialog.open) dialog.showModal();
    });

    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
