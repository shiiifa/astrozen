---
import Section from "./Section.astro";
import type { SkillProps } from "@types";

interface Props {
  skills: SkillProps[];
}

const { skills } = Astro.props;

// Vector icons for each skill category (using emojis as placeholders)
const skillIcons: Record<string, string> = {
  "Technical Skills": "⚙",    // Gear icon for technical skills
  "Design & Creative Skills": "🖌",       // Art palette icon for design skills  
  "Professional & Collaboration Skills": "𓂫"  // Handshake icon for professional skills
};
---

<Section text="skills" href="skills">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
    {skills.map((skill) => (
      <div class="text-center">
        {/* Icon */}
        <div class="text-4xl mb-4 text-white">{skillIcons[skill.category]}</div>
        
        {/* Category Title */}
        <h3 class="font-serif text-xl font-semibold text-primary mb-4">
          {skill.category}
        </h3>
        
        {/* Skills List - Justified text */}
        <div class="text-neutral text-sm leading-relaxed text-justify">
          {skill.tools.split('\n').map((tool) => (
            <div class="mb-2" set:html={tool.replace(/^([^:]+):/, '<strong>$1:</strong>')} />
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>