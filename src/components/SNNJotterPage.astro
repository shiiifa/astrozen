---
const sections = [
  { number: "1", label: "everyday story", href: "/projects/snnjotter/everyday-story" },
  { number: "2", label: "engineering puzzle", href: "/projects/snnjotter/engineering-puzzle" },
  { number: "3", label: "pipeline", href: "/projects/snnjotter/pipeline" },
  { number: "4", label: "glossary", href: "/projects/snnjotter/glossary" },
  { number: "5", label: "roadmap", href: "/projects/snnjotter/roadmap" },
];
---

<article class="mx-auto max-w-3xl py-10 sm:py-14">
  <div class="overflow-hidden rounded-[1.5rem] bg-surface" aria-hidden="true">
    <video
      class="aspect-[5.12/1] w-full object-cover"
      data-snnjotter-banner
      muted
      loop
      playsinline
      preload="metadata"
      tabindex="-1"
    >
      <source src="/snnjotter-banner.mp4" type="video/mp4" />
    </video>
  </div>
  <header class="px-2 py-7 text-center sm:py-9">
    <h1 class="font-serif text-4xl font-bold leading-tight text-white sm:text-5xl">SNNJotter</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-white/60 sm:text-base">
      Friendly notebook for my capstone: <span class="font-medium text-white/75">FPGA-Accelerated Spiking Neural Networks for Real-Time Biomedical Signal Inference.</span>
    </p>
  </header>

  <section class="mt-8 rounded-2xl border border-white/10 bg-white/[0.035] p-5 sm:p-6" aria-labelledby="preface-title">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Preface</p>
    <h2 id="preface-title" class="mt-2 font-serif text-xl font-bold text-white">Why I opened the notebook</h2>
    <p class="mt-3 text-sm leading-relaxed text-white/75">If you’re building technology for people, they should be able to understand what you’re doing for them. When people ask what I’m working on for my capstone, I often catch myself dishing out acronyms and long explanations. SNNJotter is a peek into my notebook so everyday people can grasp the big picture: a clearer window into my work on Spiking Neural Networks</p>
  </section>

  <section class="mt-8" aria-labelledby="contents-title">
    <h2 id="contents-title" class="font-serif text-2xl font-bold lowercase text-white sm:text-3xl">table of contents</h2>
    <nav class="mt-4" aria-label="table of contents">
      <ol class="divide-y divide-white/10 border-y border-white/10">
        {sections.map((section) => (
          <li>
            <a
              href={section.href}
              class="group flex items-center gap-4 py-4 text-base font-medium text-primary transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-full border border-primary/45 bg-primary/10 text-sm font-semibold text-primary" aria-hidden="true">{section.number}</span>
              <span class="underline decoration-primary/40 underline-offset-4">{section.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

</article>

<script>
  const bannerVideo = document.querySelector<HTMLVideoElement>("[data-snnjotter-banner]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const syncBannerPlayback = () => {
    if (!bannerVideo) return;
    if (prefersReducedMotion.matches) {
      bannerVideo.pause();
      return;
    }
    void bannerVideo.play().catch(() => {});
  };

  syncBannerPlayback();
  prefersReducedMotion.addEventListener("change", syncBannerPlayback);
</script>
