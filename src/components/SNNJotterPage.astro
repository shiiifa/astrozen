---
import SNNJotterEverydayStory from "./SNNJotterEverydayStory.astro";
import SNNJotterEngineeringPuzzle from "./SNNJotterEngineeringPuzzle.astro";
import SNNJotterPipeline from "./SNNJotterPipeline.astro";
import SNNJotterGlossary from "./SNNJotterGlossary.astro";
import SNNJotterRoadmap from "./SNNJotterRoadmap.astro";
import SNNJotterFAQs from "./SNNJotterFAQs.astro";

const sections = [
  { number: "1", label: "everyday story", component: SNNJotterEverydayStory },
  { number: "2", label: "engineering puzzle", component: SNNJotterEngineeringPuzzle },
  { number: "3", label: "pipeline", component: SNNJotterPipeline },
  { number: "4", label: "glossary", component: SNNJotterGlossary },
  { number: "5", label: "roadmap", component: SNNJotterRoadmap },
  { number: "6", label: "faqs", component: SNNJotterFAQs },
];
---

<article class="mx-auto max-w-3xl py-10 sm:py-14">
  <div class="overflow-hidden rounded-[1.5rem] bg-surface" aria-hidden="true">
    <video
      class="aspect-[5.12/1] w-full object-cover"
      data-snnjotter-banner
      muted
      loop
      playsinline
      preload="metadata"
      tabindex="-1"
    >
      <source src="/snnjotter-banner.mp4" type="video/mp4" />
    </video>
  </div>
  <header class="px-2 py-7 text-center sm:py-9">
    <h1 class="snnjotter-subtitle mx-auto max-w-2xl text-white/60">
      Friendly notebook for my capstone: <span class="font-medium text-white/75">FPGA-Accelerated Spiking Neural Networks for Real-Time Biomedical Signal Inference.</span>
    </h1>
  </header>

  <section class="mt-8" aria-labelledby="notebook-intro-title">
    <h2 id="notebook-intro-title" class="font-serif text-xl font-bold text-white">why the notebook?</h2>
    <p class="mt-3 text-sm leading-relaxed text-white/75">If you’re building technology for people, they should be able to understand what you’re doing for them. When people ask what I’m working on for my capstone, I often catch myself dishing out acronyms and long explanations. SNNJotter is a peek into my notebook so everyday people can grasp the bigger picture. It&apos;s a clearer window into my work on Spiking Neural Networks.</p>
  </section>

  <section class="mt-8" aria-label="notebook sections">
    <ol class="divide-y divide-white/10 border-y border-white/10">
      {sections.map((section) => {
        const SectionContent = section.component;
        return (
          <li>
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center gap-4 py-4 text-base font-medium text-primary transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                <span class="grid size-10 shrink-0 place-items-center rounded-full border border-primary/45 bg-transparent text-sm font-semibold text-primary" aria-hidden="true">{section.number}</span>
                <span>{section.label}</span>
                <svg class="ml-auto size-5 text-primary transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="pb-5 pl-14 pr-1">
                <SectionContent />
              </div>
            </details>
          </li>
        );
      })}
    </ol>
  </section>

</article>

<script>
  const bannerVideo = document.querySelector<HTMLVideoElement>("[data-snnjotter-banner]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const syncBannerPlayback = () => {
    if (!bannerVideo) return;
    if (prefersReducedMotion.matches) {
      bannerVideo.pause();
      return;
    }
    void bannerVideo.play().catch(() => {});
  };

  syncBannerPlayback();
  prefersReducedMotion.addEventListener("change", syncBannerPlayback);
</script>

<style>
  .snnjotter-subtitle {
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
