const glossary = [
  {
    term: "ECG",
    label: "Electrocardiogram",
    definition: "A recording of the heart’s electrical activity. Its repeating waves reflect the timing of a heartbeat.",
  },
  {
    term: "Spike",
    label: "A brief signal pulse",
    definition: "A short event that carries information. In this project, spikes are how the network receives meaningful changes in the ECG signal.",
  },
  {
    term: "SNN",
    label: "Spiking Neural Network",
    definition: "A neural network whose units communicate with brief pulses, rather than continuously passing values at every moment.",
  },
  {
    term: "Level-Crossing (LC)",
    label: "A threshold-based encoder",
    definition: "A way to create events when the signal crosses selected levels, so quiet stretches need not produce a spike for every sample.",
  },
  {
    term: "Synaptic delay",
    label: "A timed pause",
    definition: "A small wait before a signal reaches the next neuron. Think of it as a waiting room that helps different parts of a wave line up.",
  },
  {
    term: "SLIF neuron",
    label: "Simplified Leaky Integrate-and-Fire",
    definition: "A lightweight neuron model that adds incoming pulses, lets the running total fade over time, and fires when it passes a threshold—without relying on heavy multiplication for every step.",
  },
  {
    term: "FPGA / Basys 3",
    label: "Reconfigurable hardware",
    definition: "An FPGA is a chip whose logic can be configured for a task. The Basys 3 is a Digilent development board built around an Artix-7 FPGA.",
  },
  {
    term: "AAMI classes",
    label: "Five beat categories",
    definition: "A common grouping for heartbeat-beat classification: N (normal), S (supraventricular ectopic), V (ventricular ectopic), F (fusion), and Q (unknown or unclassifiable). These labels describe dataset categories, not a diagnosis for a person.",
  },
];

const classes = [
  { code: "N", name: "Normal", detail: "A beat in the normal category." },
  { code: "S", name: "Supraventricular ectopic", detail: "A beat that starts above the ventricles." },
  { code: "V", name: "Ventricular ectopic", detail: "A beat that starts in the ventricles." },
  { code: "F", name: "Fusion", detail: "A beat combining normal and ventricular activity." },
  { code: "Q", name: "Unknown / unclassifiable", detail: "A beat that does not fit the other listed groups." },
];
