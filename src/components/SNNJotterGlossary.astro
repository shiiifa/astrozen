---
const glossary = [
  { term: "ECG", label: "Electrocardiogram", definition: "A recording of the heart’s electrical activity. Its repeating waves reflect the timing of a heartbeat." },
  { term: "Spike", label: "A brief signal pulse", definition: "A short event that carries information. In this project, spikes are how the network receives meaningful changes in the ECG signal." },
  { term: "SNN", label: "Spiking Neural Network", definition: "A neural network whose units communicate with brief pulses, rather than continuously passing values at every moment." },
  { term: "Level-Crossing (LC)", label: "A threshold-based encoder", definition: "A way to create events when the signal crosses selected levels, so quiet stretches need not produce a spike for every sample." },
  { term: "Synaptic delay", label: "A timed pause", definition: "A small wait before a signal reaches the next neuron. Think of it as a waiting room that helps different parts of a wave line up." },
  { term: "SLIF neuron", label: "Simplified Leaky Integrate-and-Fire", definition: "A lightweight neuron model that adds incoming pulses, lets the running total fade over time, and fires when it passes a threshold—without relying on heavy multiplication for every step." },
  { term: "FPGA / Basys 3", label: "Reconfigurable hardware", definition: "An FPGA is a chip whose logic can be configured for a task. The Basys 3 is a Digilent development board built around an Artix-7 FPGA." },
  { term: "AAMI classes", label: "Five beat categories", definition: "A common grouping for heartbeat-beat classification: N (normal), S (supraventricular ectopic), V (ventricular ectopic), F (fusion), and Q (unknown or unclassifiable). These labels describe dataset categories, not a diagnosis for a person." },
];
---

<section class="mt-7" aria-label="Notebook glossary">
  <div class="glossary-table-container overflow-x-auto rounded-2xl border border-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" role="region" aria-label="Glossary table" tabindex="0">
    <table class="glossary-table w-full min-w-0 table-fixed border-collapse text-left">
      <caption class="sr-only">Glossary of signal, neuron, and hardware terms</caption>
      <thead class="bg-white/[0.035] text-xs uppercase tracking-[0.1em] text-primary">
        <tr>
          <th class="px-4 py-3 font-semibold sm:px-5" scope="col">Term</th>
          <th class="px-4 py-3 font-semibold sm:px-5" scope="col">In other words</th>
          <th class="px-4 py-3 font-semibold sm:px-5" scope="col">Meaning</th>
        </tr>
      </thead>
      <tbody>
        {glossary.map((item) => (
          <tr class="border-t border-white/10 align-top">
            <th class="px-4 py-4 text-sm font-semibold text-white sm:px-5" scope="row">{item.term}</th>
            <td class="px-4 py-4 text-sm font-medium text-primary sm:px-5" data-label="In other words">{item.label}</td>
            <td class="px-4 py-4 text-sm leading-relaxed text-white/75 sm:px-5" data-label="Meaning">{item.definition}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .glossary-table {
    table-layout: fixed;
  }

  .glossary-table :is(th, td):nth-child(1) {
    width: 18%;
  }

  .glossary-table :is(th, td):nth-child(2) {
    width: 29%;
  }

  .glossary-table :is(th, td):nth-child(3) {
    width: 53%;
  }

  @media (max-width: 639px) {
    .glossary-table-container {
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    .glossary-table,
    .glossary-table tbody {
      display: block;
      width: 100%;
    }

    .glossary-table thead {
      display: none;
    }

    .glossary-table tr {
      display: grid;
      gap: 0.75rem;
      padding: 1rem;
      border: 1px solid rgb(255 255 255 / 14%);
      border-radius: 1rem;
      background: rgb(255 255 255 / 2%);
    }

    .glossary-table tr + tr {
      margin-top: 0.75rem;
    }

    .glossary-table :is(th, td):nth-child(n) {
      width: auto;
    }

    .glossary-table th,
    .glossary-table td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }

    .glossary-table td::before {
      display: block;
      margin-bottom: 0.25rem;
      color: var(--color-primary);
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      content: attr(data-label);
    }
  }
</style>
