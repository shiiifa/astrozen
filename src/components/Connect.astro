---
import Section from "./Section.astro";
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "socialLinks">;

const { socialLinks } = Astro.props;
---

<Section text="Let's Connect!" href="connect">
  <div class="text-center">
    <p class="mb-8 text-base text-neutral">
      Feel free to reach out for collaborations or just a friendly hello!
    </p>
    
    <ul class="flex flex-wrap justify-center gap-6 text-sm">
      {
        socialLinks.map(({ text, href }) => (
          <li>
            <a
              href={href}
              target="_blank"
              class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-6 py-3 text-primary transition-colors hover:bg-primary/20 hover:text-white"
            >
              {text}
              <span class="inline-block h-4 w-4 content-[url(/external.svg)]" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>