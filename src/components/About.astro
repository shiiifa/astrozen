---
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { image, name } = Astro.props;
---

<div class="flex flex-col items-center gap-12 md:flex-row md:items-start md:gap-12">
  <div class="w-full text-base text-neutral md:w-2/3 md:pr-8">

    <p class="fade-in-element mb-4">
      I’m a Computer Engineering student at Ashesi University interested in building systems that combine software, hardware, and thoughtful user experience design. My work focuses on creating clear and structured digital solutions that make complex technical ideas more accessible and usable.
    </p>

    <p class="fade-in-element mb-4">
      From coursework to team-based projects, I’ve gained hands-on experience in engineering fundamentals and modern development tools, building the ability to translate complex systems into practical implementations.
    </p>

    <p class="fade-in-element mb-4">
      Through ongoing projects, research, and exploration of new technologies, I am developing both technical depth and an appreciation for user experience and design as part of building effective engineering solutions.
    </p>

  </div>

  <div class="flex-shrink-0">
    <Image
      class="fade-in-image h-[32rem] w-[26rem] object-cover object-top rounded-lg"
      src={image}
      width="480"
      height="580"
      alt={name}
    />
  </div>
</div>