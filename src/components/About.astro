---
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { image, name } = Astro.props;
---

<div class="flex min-w-0 flex-col items-center gap-8 lg:flex-row lg:items-center lg:gap-8">
  <div class="w-full min-w-0 text-[1.0625rem] leading-[1.65] text-neutral lg:w-[58%] lg:shrink-0">

    <p class="fade-in-element mb-4">
      I’m a Computer Engineering senior at Ashesi University, passionate about turning complex technical ideas into clear, structured and usable solutions. I enjoy building human-centered systems that merge software, hardware and thoughtful user experience design.
    </p>

    <p class="fade-in-element mb-4">
      Through coursework, team-based projects, research and exploration of new technologies, I'm developing technical depth and hands-on experience in engineering fundamentals and modern development tools to build my ability to translate complex systems into practical implementations.
    </p>

  </div>

  <div class="hidden w-full justify-center lg:flex lg:w-[42%] lg:justify-end">
    <Image
      class="fade-in-image h-80 w-full max-w-[20rem] rounded-lg object-cover object-top sm:h-[24rem] lg:h-[28rem] lg:max-w-[22rem]"
      src={image}
      width="420"
      height="500"
      alt={name}
    />
  </div>
</div>
