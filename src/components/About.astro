---
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { image, name } = Astro.props;
---

<div class="flex flex-col items-center gap-12 md:flex-row md:gap-12">
  <div class="w-full text-base text-neutral md:w-2/3 md:pr-8">

    <p class="fade-in-element mb-4">
      I’m a Computer Engineering student at Ashesi University with a strong interest in visual design and systems thinking. My work sits at the intersection of engineering and design, where I focus on building clarity, structure, and impact into digital experiences.
    </p>

    <p class="fade-in-element mb-4">
      From coursework to team-based projects, I’ve gained hands-on experience in both engineering fundamentals and modern digital tools, developing the ability to translate complex technical ideas into clear and accessible outputs.
    </p>

    <p class="fade-in-element mb-4">
      Through ongoing projects and exploration of new technologies, I am building both technical depth and a design mindset grounded in problem-solving, clarity, and thoughtful execution.
    </p>

  </div>

  <div class="flex-shrink-0">
    <Image
      class="fade-in-image h-96 w-80 object-cover rounded-lg"
      src={image}
      width="400"
      height="480"
      alt={name}
    />
  </div>
</div>