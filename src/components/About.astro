---
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;

// Convert the description string into paragraphs by splitting on double newlines
const paragraphs = description.split('\n\n').filter(p => p.trim());
---

<div class="flex flex-col items-center gap-12 md:flex-row md:gap-12">
  <div class="w-auto text-base text-neutral md:pr-8">
    {paragraphs.map(paragraph => (
      <p class="mb-4">{paragraph}</p>
    ))}
  </div>
  <div class="flex-shrink-0">
    <Image
      class="h-96 w-80 object-cover rounded-lg"
      src={image}
      width="400"
      height="480"
      alt={name}
    />
  </div>
</div>