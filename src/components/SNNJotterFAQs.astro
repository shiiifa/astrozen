---
const faqs = [
  {
    question: 'What are "spikes" in this project?',
    answer: "Instead of measuring every tiny moment nonstop, a spiking neural network reacts to brief pulses (\"spikes\") when meaningful voltage changes happen. This is inspired by how real neurons communicate.",
  },
  {
    question: "Are you testing on real people or live patients?",
    answer: "No. The project uses established, open-access ECG heartbeat datasets (like MIT-BIH) rather than live patient testing, focusing on how efficiently a compact model can classify beat patterns on hardware.",
  },
  {
    question: "Why use an FPGA chip instead of a regular computer or phone?",
    answer: "An FPGA is a flexible chip whose internal logic can be tailored for low-power, real-time tasks—helping explore how energy-smart event-driven models can fit onto tight hardware limits.",
  },
  {
    question: "What do the heartbeat categories (N, S, V, F, Q) mean in plain English?",
    answer: "They are standard clinical beat groupings (such as normal rhythms versus different kinds of irregular or unclassifiable beats) used to test whether a lightweight model can tell heartbeat shapes apart reliably.",
  },
];
---

<section class="mt-7" aria-label="Frequently asked questions">
  <div
    class="mt-5 grid grid-cols-[2.25rem_minmax(0,1fr)_2.25rem] items-stretch gap-2 sm:grid-cols-[4rem_minmax(0,1fr)_4rem] sm:gap-3"
  >
    <div
      class="flex flex-col items-center justify-around gap-12 py-4"
      aria-hidden="true"
    >
      <img
        class="size-8 rotate-[-12deg] object-contain opacity-80 mix-blend-screen sm:size-16"
        src="/snnjotter-doodle-star.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <img
        class="size-7 rotate-[-8deg] object-contain opacity-75 mix-blend-screen sm:size-14"
        src="/snnjotter-doodle-lavender.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <dl class="divide-y divide-white/10">
      {
        faqs.map((faq) => (
          <div class="py-4">
            <dt class="font-semibold text-white">{faq.question}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-white/70">
              {faq.answer}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="flex items-center justify-center" aria-hidden="true">
      <img
        class="size-8 rotate-12 object-contain opacity-75 mix-blend-screen sm:size-16"
        src="/snnjotter-doodle-gold.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
