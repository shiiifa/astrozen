---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="experience" href="experience">
  {
    experience.map(({ company, position, startDate, endDate, summary }) => (
      <details class="experience-item fade-in-element mb-5">
        <summary class="cursor-pointer list-none py-4 marker:content-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
          <span class="flex flex-col items-start gap-0.5 pr-6">
            <span class="font-serif text-base font-semibold text-white sm:text-lg">{company}</span>
            <span class="font-serif text-sm font-medium text-primary sm:text-base">{position}</span>
            <span class="text-xs text-white/70">{startDate} — {endDate}</span>
          </span>
          <span aria-hidden="true" class="experience-item__chevron">⌄</span>
        </summary>
        <div class="px-4 pb-4 sm:px-5 sm:pb-5">
          {Array.isArray(summary) ? (
            <ul class="list-none">
              {summary.map((log) => (
                <li class="relative mb-2 pl-6 text-sm text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                  {log}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-neutral">{summary}</p>
          )}
        </div>
      </details>
    ))
  }
</Section>

<style>
  .experience-item > summary {
    position: relative;
  }

  .experience-item > summary::-webkit-details-marker {
    display: none;
  }

  .experience-item__chevron {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    color: var(--color-white);
    font-size: 1.5rem;
    line-height: 1;
    transform: translateY(-50%);
    transition: transform 180ms ease;
  }

  .experience-item[open] .experience-item__chevron {
    transform: translateY(-50%) rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-item,
    .experience-item__chevron {
      transition: none;
    }
  }
</style>
