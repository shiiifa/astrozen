---
const pipeline = [
  { number: "01", title: "Start with heartbeat recordings", shortTitle: "Data", term: "MIT-BIH Arrhythmia Database", text: "The project uses established, open-access ECG recordings with beat labels. This is benchmark data, not a live-patient test." },
  { number: "02", title: "Turn the wave into events", shortTitle: "Events", term: "Preprocessing + Level-Crossing encoding", text: "The signal is normalized, then a spike is produced when the waveform crosses a meaningful threshold. That gives the network a more event-focused view than sending every sample as a constant stream." },
  { number: "03", title: "Choose the little building blocks", shortTitle: "Model", term: "SNN architecture", text: "A network of simplified neurons processes those spikes. The SLIF model keeps the neuron math lightweight, while synaptic delays give signals time to arrive in useful order." },
  { number: "04", title: "Teach the model from examples", shortTitle: "Train", term: "Training", text: "The network learns patterns from labeled heartbeat examples in the dataset. Training is a development step; it does not make the result a medical diagnostic tool." },
  { number: "05", title: "Make the design smaller", shortTitle: "Shrink", term: "Compression", text: "The model is reduced to fit the board’s limited memory and logic. The trade-off matters: making a model smaller can also remove useful detail, so the fit and the classification quality need to be checked together." },
  { number: "06", title: "Map it onto a configurable chip", shortTitle: "FPGA", term: "FPGA synthesis", text: "The design is prepared for the Digilent Basys 3 board, which uses an Artix-7 FPGA. Vivado/HLS tools help translate the design into hardware logic; synthesis is a step toward testing on the board, not a performance result by itself." },
  { number: "07", title: "Compare the practical trade-offs", shortTitle: "Review", term: "Evaluation", text: "The planned checks include classification accuracy, power, latency (how long an answer takes), and board resources such as LUTs, BRAM, and DSPs. No measurements or accuracy claims are reported here yet." },
];
---

<section class="pipeline relative mt-7" aria-label="How the pipeline works">
  <ol class="pipeline__track">
    {pipeline.map((step, index) => (
      <li class="pipeline__step" data-pipeline-step>
        <button
          class="pipeline__trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls={`pipeline-dialog-${index}`}
          aria-label={`Step ${step.number}: ${step.title}`}
          data-pipeline-trigger
        >
          {step.number}
        </button>
        {index < pipeline.length - 1 && <span class="pipeline__connector" aria-hidden="true"></span>}
        <h2 class="pipeline__label">
          <span class="pipeline__label-short">{step.shortTitle}</span>
          <span class="pipeline__label-full">{step.title}</span>
        </h2>
        <dialog
          id={`pipeline-dialog-${index}`}
          class="pipeline__dialog"
          aria-labelledby={`pipeline-heading-${index}`}
          data-pipeline-dialog
        >
          <div class="pipeline__dialog-header">
            <p class="pipeline__step-number">STEP {step.number}</p>
            <img
              class="pipeline__doodle"
              style="transform: rotate(-12deg) scaleY(-1)"
              src="/snnjotter-doodle-gold.png"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <button
              class="pipeline__close"
              type="button"
              aria-label={`Close ${step.title} details`}
              data-pipeline-close
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <h3 id={`pipeline-heading-${index}`} class="pipeline__dialog-title">{step.title}</h3>
          <p class="pipeline__term">{step.term}</p>
          <p class="pipeline__text">{step.text}</p>
        </dialog>
      </li>
    ))}
  </ol>
</section>

<style>
  .pipeline__track {
    --pipeline-node-size: clamp(1.5rem, 5.2vw, 3rem);
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    align-items: start;
    margin: 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  .pipeline__step {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pipeline__trigger {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--pipeline-node-size);
    height: var(--pipeline-node-size);
    min-height: var(--pipeline-node-size);
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-white);
    border-radius: 9999px;
    background: var(--color-background);
    color: var(--color-primary);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(0.55rem, 1.3vw, 0.875rem);
    font-weight: 700;
    line-height: 1;
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .pipeline__trigger:focus-visible,
  .pipeline__trigger:active {
    transform: translateY(-2px);
    border-color: var(--color-white);
    box-shadow: 0 0 16px rgb(225 173 1 / 48%), 0 0 42px rgb(225 173 1 / 24%);
  }

  .pipeline__trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .pipeline__trigger:hover {
      transform: translateY(-2px);
      border-color: var(--color-white);
      box-shadow: 0 0 16px rgb(225 173 1 / 48%), 0 0 42px rgb(225 173 1 / 24%);
    }
  }

  .pipeline__connector {
    position: absolute;
    z-index: 0;
    top: calc(0.5rem + var(--pipeline-node-size) / 2);
    left: calc(50% + var(--pipeline-node-size) / 2);
    width: calc(100% - var(--pipeline-node-size));
    border-top: 1px solid var(--color-primary);
    opacity: 0.8;
  }

  .pipeline__connector::after {
    position: absolute;
    top: -0.25rem;
    right: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-top: 1px solid var(--color-primary);
    border-right: 1px solid var(--color-primary);
    content: "";
    transform: rotate(45deg);
  }

  .pipeline__label {
    max-width: 100%;
    margin: 0.65rem 0 0;
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: clamp(0.65rem, 1.25vw, 0.875rem);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .pipeline__label-short {
    display: block;
  }

  .pipeline__label-full {
    display: none;
  }

  .pipeline__dialog {
    position: fixed;
    inset: 0;
    width: min(30rem, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    max-height: min(80dvh, 36rem);
    margin: auto;
    overflow-y: auto;
    padding: 1.25rem;
    border: 0;
    border-radius: 1rem;
    background: var(--color-background);
    box-shadow: 0 22px 64px rgb(0 0 0 / 55%);
    color: var(--color-neutral);
  }

  .pipeline__dialog[open] {
    animation: pipeline-popup-enter 220ms ease-out both;
  }

  .pipeline__dialog::backdrop {
    background: rgb(0 0 0 / 72%);
    animation: pipeline-popup-backdrop-enter 220ms ease-out both;
  }

  @keyframes pipeline-popup-enter {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pipeline-popup-backdrop-enter {
    from {
      background: rgb(0 0 0 / 0%);
    }

    to {
      background: rgb(0 0 0 / 72%);
    }
  }

  .pipeline__dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .pipeline__step-number {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .pipeline__doodle {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    opacity: 0.8;
  }

  .pipeline__close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-neutral);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  .pipeline__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .pipeline__dialog-title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 5vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .pipeline__term {
    margin: 0.75rem 0 0;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pipeline__text {
    margin: 0.75rem 0 0;
    color: var(--color-neutral);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    .pipeline__label-short {
      display: none;
    }

    .pipeline__label-full {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .pipeline__dialog {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipeline__trigger {
      transition: none;
    }

    .pipeline__dialog[open],
    .pipeline__dialog::backdrop {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-pipeline-step]").forEach((step) => {
    const trigger = step.querySelector<HTMLButtonElement>("[data-pipeline-trigger]");
    const dialog = step.querySelector<HTMLDialogElement>("[data-pipeline-dialog]");
    const closeButton = step.querySelector<HTMLButtonElement>("[data-pipeline-close]");

    if (!trigger || !dialog || !closeButton) return;

    trigger.addEventListener("click", () => {
      if (!dialog.open) dialog.showModal();
    });

    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
