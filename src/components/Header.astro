---
import Menu from "@icons/Menu.astro";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { navLinks } = Astro.props;

const functionName = "shifa_amankwa_gabbey();";
---

<header
  class="sticky top-0 z-50 mx-auto flex max-w-5xl animate-slide-in justify-between bg-[#240C2C] px-5 py-6"
>
  {/* Function syntax with real typing effect */}
  <a href="/" aria-label="Home link" class="typing-header-name text-2xl font-bold tracking-tight">
    <span id="typing-text"></span>
  </a>

  <button
    type="button"
    id="menu-button"
    class="px-1.5 text-neutral sm:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <Menu />
  </button>

  <nav
    class="absolute top-20 right-5 hidden rounded-xl border border-neutral/40 bg-[#240C2C] px-4 py-5 text-neutral sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
    id="main-menu"
  >
    <ul class="gap-2 sm:flex">
      {
        navLinks.map((link) => (
          <li class="relative">
            <a
              class={`nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white`}
              href={link.href}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

<style>
  /* Programming/coding font style with yellow color */
  .typing-header-name {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'monospace';
    font-weight: bold;
    color: #E1AD01;
    text-decoration: none;
    font-size: 1.5rem;
    letter-spacing: -0.5px;
    display: inline-block;
    min-height: 1.5rem; /* Prevent layout shift */
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const typingElement = document.getElementById('typing-text');
    if (!typingElement) return;

    const fullText = "shifa_amankwa_gabbey();";
    let currentState = 'typing';
    let currentIndex = 0;
    let lastUpdateTime = 0;
    const typeSpeed = 100; // ms per character
    const eraseSpeed = 80; // ms per character (slightly faster)
    const pauseDuration = 3000; // 3 seconds pause

    function updateTyping(timestamp) {
      if (!lastUpdateTime) lastUpdateTime = timestamp;
      
      const elapsed = timestamp - lastUpdateTime;
      const requiredTime = currentState === 'typing' ? typeSpeed : eraseSpeed;

      if (elapsed >= requiredTime) {
        lastUpdateTime = timestamp;

        if (currentState === 'typing') {
          if (currentIndex <= fullText.length) {
            typingElement.textContent = fullText.slice(0, currentIndex);
            currentIndex++;
          } else {
            currentState = 'pausing';
            lastUpdateTime = timestamp;
          }
        } 
        else if (currentState === 'pausing') {
          if (elapsed >= pauseDuration) {
            currentState = 'erasing';
            lastUpdateTime = timestamp;
          }
        }
        else if (currentState === 'erasing') {
          if (currentIndex > 0) {
            currentIndex--;
            typingElement.textContent = fullText.slice(0, currentIndex);
          } else {
            currentState = 'final-pause';
            lastUpdateTime = timestamp;
          }
        }
        else if (currentState === 'final-pause') {
          if (elapsed >= pauseDuration) {
            currentState = 'typing';
            lastUpdateTime = timestamp;
          }
        }
      }

      requestAnimationFrame(updateTyping);
    }

    // Start the animation
    requestAnimationFrame(updateTyping);
  });

  // Toggle mobile menu
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", toggleMenu);
  });

  // Update navigation based on scroll position with Intersection Observer
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("href") === `#${entry.target.id}`) {
              item.classList.add("text-white", "md:after:opacity-100");
            } else {
              item.classList.remove("text-white", "md:after:opacity-100");
            }
          });
        }
      });
    },
    { threshold: 0.5 },
  );

  document.querySelectorAll("section").forEach((section) => {
    observer.observe(section);
  });

  // Cleanup observer
  document.onvisibilitychange = () => {
    if (document.visibilityState === "hidden") {
      observer.disconnect();
    } else {
      document.querySelectorAll("section").forEach((section) => {
        observer.observe(section);
      });
    }
  };
</script>

<style>
  header {
    animation-timeline: scroll();
    animation-range: 0 650px;
  }
</style>
</header>