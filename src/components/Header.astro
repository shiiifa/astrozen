---
import Menu from "@icons/Menu.astro";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { navLinks } = Astro.props;

// Check if we're on the homepage
const isHomepage = Astro.url.pathname === '/';
---

<header
  class="sticky top-0 z-50 mx-auto flex max-w-5xl animate-slide-in justify-between bg-[#240C2C] px-5 py-6"
>
  {/* Function syntax with yellow color and classic typing effect */}
  <a href="/" aria-label="Home link" class="typing-header-name text-2xl font-bold tracking-tight">
    <span class="typing-container">shifa_amankwa_gabbey();</span>
  </a>

  <button
    type="button"
    id="menu-button"
    class="px-1.5 text-neutral sm:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <Menu />
  </button>

  <nav
    class="absolute top-20 right-5 hidden rounded-xl border border-neutral/40 bg-[#240C2C] px-4 py-5 text-neutral sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
    id="main-menu"
  >
    <ul class="gap-2 sm:flex">
      {
        navLinks.map((link) => {
          // Use hash links on homepage, full URLs on other pages
          const href = isHomepage ? link.href.replace('/', '') : link.href;
          
          // Special handling for projects dropdown
          if (link.text === "projects") {
            return (
              <li class="relative group">
                <a
                  class={`nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white`}
                  href={href}
                >
                  {link.text}
                  <svg class="inline-block w-3 h-3 ml-1 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                
                {/* Dropdown Menu */}
                <div class="absolute top-full left-0 mt-2 w-48 bg-[#240C2C] border border-neutral/40 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="py-2">
                    <a
                      href="/projects/academic"
                      class="block px-4 py-2 text-sm text-neutral hover:text-white hover:bg-primary/10 transition-colors"
                    >
                      academic projects
                    </a>
                    <a
                      href="/projects/freelance"
                      class="block px-4 py-2 text-sm text-neutral hover:text-white hover:bg-primary/10 transition-colors"
                    >
                      freelance projects
                    </a>
                  </div>
                </div>
              </li>
            );
          }
          
          return (
            <li class="relative">
              <a
                class={`nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white`}
                href={href}
              >
                {link.text}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

<style>
  /* Programming/coding font style with yellow color */
  .typing-header-name {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'monospace';
    font-weight: bold;
    color: #E1AD01;
    text-decoration: none;
    font-size: 1.5rem;
    letter-spacing: -0.5px;
    display: inline-block;
  }

  /* Typing container */
  .typing-container {
    display: inline-block;
    position: relative;
  }

  /* Create classic typewriter effect */
  .typing-container::before {
    content: 'shifa_amankwa_gabbey();';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    color: #E1AD01;
    background: #240C2C;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid #E1AD01;
    animation: typing 9s steps(22, end) infinite;
  }

  /* Make original text invisible - only pseudo-element shows */
  .typing-container {
    color: transparent;
  }

  @keyframes typing {
    /* Type for 3s (0% to 33.3%) */
    0% {
      width: 0;
      border-right-color: #E1AD01;
    }
    22.2% {
      width: 100%;
      border-right-color: #E1AD01;
    }
    /* Pause with cursor blinking for 3s (33.3% to 66.6%) */
    33.3% {
      width: 100%;
      border-right-color: #E1AD01;
    }
    44.4%, 50% {
      border-right-color: transparent;
    }
    55.6% {
      border-right-color: #E1AD01;
    }
    66.6% {
      width: 100%;
      border-right-color: #E1AD01;
    }
    /* Erase for 3s (66.6% to 100%) */
    77.8% {
      width: 100%;
      border-right-color: #E1AD01;
    }
    100% {
      width: 0;
      border-right-color: #E1AD01;
    }
  }

  /* Cursor blink animation during pause */
  @keyframes blink {
    0%, 100% { border-right-color: #E1AD01; }
    50% { border-right-color: transparent; }
  }
</style>

<script>
  // Toggle mobile menu
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", toggleMenu);
  });

  // Update navigation based on scroll position with Intersection Observer
  // Only run on homepage where sections exist
  if (window.location.pathname === '/') {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navItems.forEach((item) => {
              const href = item.getAttribute("href");
              const sectionId = entry.target.id;
              // Check for both hash links and full URLs
              if (href === `#${sectionId}` || href === `/#${sectionId}`) {
                item.classList.add("text-white", "md:after:opacity-100");
              } else {
                item.classList.remove("text-white", "md:after:opacity-100");
              }
            });
          }
        });
      },
      { threshold: 0.5 },
    );

    document.querySelectorAll("section").forEach((section) => {
      observer.observe(section);
    });

    // Cleanup observer
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        document.querySelectorAll("section").forEach((section) => {
          observer.observe(section);
        });
      }
    };
  } else {
    // Handle projects pages - highlight projects nav item
    const currentPath = window.location.pathname;
    if (currentPath.startsWith('/projects')) {
      navItems.forEach((item) => {
        const href = item.getAttribute("href");
        if (href === '#projects' || href === '/#projects' || href === '/projects') {
          item.classList.add("text-white", "md:after:opacity-100");
        } else {
          item.classList.remove("text-white", "md:after:opacity-100");
        }
      });
    }
  }
</script>

<style>
  header {
    animation-timeline: scroll();
    animation-range: 0 650px;
  }
</style>
</header>