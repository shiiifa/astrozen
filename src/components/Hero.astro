---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty } = Astro.props;
---

<section class="py-24 md:py-32 text-center relative overflow-hidden" id="#hero">
  {/* Animated Circuit Background */}
  <div class="absolute inset-0 z-0 opacity-20">
    <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path class="animate-circuit-path" d="M10,10 L90,10 L90,90 L10,90 Z" 
            stroke="#E1AD01" stroke-width="0.2" fill="none" />
      <path class="animate-circuit-path" d="M30,30 L70,30 L70,70 L30,70 Z" 
            stroke="#E1AD01" stroke-width="0.1" fill="none" style="animation-delay: 1s" />
      <path class="animate-circuit-path" d="M40,40 L60,40 L60,60 L40,60 Z" 
            stroke="#E1AD01" stroke-width="0.05" fill="none" style="animation-delay: 2s" />
    </svg>
  </div>

  {/* Flickering Name */}
  <h1
    class="mb-9 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:text-8xl relative z-10 flicker-text"
    id="animated-name"
  >
    {name}
  </h1>
  
  {/* Specialty Text */}
  <p
    class="font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl relative z-10"
  >
    {specialty}
  </p>
</section>

<style>
  /* Circuit Board Animation */
  .animate-circuit-path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw-circuit 6s ease-in-out infinite;
  }

  @keyframes draw-circuit {
    to { stroke-dashoffset: 0; }
  }

  /* Light Bulb Flicker Effect */
  .flicker-text {
    opacity: 0;
    animation: lightbulb-flicker 2.5s ease-out forwards;
  }

  @keyframes lightbulb-flicker {
    0% {
      opacity: 0;
      text-shadow: 0 0 0px #E1AD01;
      filter: brightness(0);
    }
    5% {
      opacity: 0.1;
      text-shadow: 0 0 2px #E1AD01;
      filter: brightness(0.2);
    }
    10% {
      opacity: 0;
      text-shadow: 0 0 0px #E1AD01;
      filter: brightness(0);
    }
    15% {
      opacity: 0.3;
      text-shadow: 0 0 5px #E1AD01;
      filter: brightness(0.4);
    }
    20% {
      opacity: 0.1;
      text-shadow: 0 0 2px #E1AD01;
      filter: brightness(0.2);
    }
    25% {
      opacity: 0.5;
      text-shadow: 0 0 8px #E1AD01, 0 0 16px #E1AD0140;
      filter: brightness(0.7);
    }
    30% {
      opacity: 0.2;
      text-shadow: 0 0 3px #E1AD01;
      filter: brightness(0.3);
    }
    35% {
      opacity: 0.7;
      text-shadow: 0 0 12px #E1AD01, 0 0 24px #E1AD0160;
      filter: brightness(0.9);
    }
    40% {
      opacity: 0.4;
      text-shadow: 0 0 6px #E1AD01;
      filter: brightness(0.5);
    }
    45% {
      opacity: 0.9;
      text-shadow: 0 0 15px #E1AD01, 0 0 30px #E1AD0180;
      filter: brightness(1.1);
    }
    50% {
      opacity: 0.6;
      text-shadow: 0 0 8px #E1AD01;
      filter: brightness(0.7);
    }
    55% {
      opacity: 1;
      text-shadow: 0 0 20px #E1AD01, 0 0 40px #E1AD01;
      filter: brightness(1.3);
    }
    60% {
      opacity: 0.8;
      text-shadow: 0 0 12px #E1AD01;
      filter: brightness(1);
    }
    65% {
      opacity: 1;
      text-shadow: 0 0 18px #E1AD01, 0 0 36px #E1AD01;
      filter: brightness(1.2);
    }
    70% {
      opacity: 0.9;
      text-shadow: 0 0 14px #E1AD01;
      filter: brightness(1);
    }
    75% {
      opacity: 1;
      text-shadow: 0 0 16px #E1AD01, 0 0 32px #E1AD01;
      filter: brightness(1.1);
    }
    80% {
      opacity: 1;
      text-shadow: 0 0 15px #E1AD01, 0 0 30px #E1AD01;
      filter: brightness(1);
    }
    85% {
      opacity: 1;
      text-shadow: 0 0 14px #E1AD01, 0 0 28px #E1AD01;
      filter: brightness(1);
    }
    90% {
      opacity: 1;
      text-shadow: 0 0 12px #E1AD01, 0 0 24px #E1AD01;
      filter: brightness(1);
    }
    95% {
      opacity: 1;
      text-shadow: 0 0 10px #E1AD01, 0 0 20px #E1AD01;
      filter: brightness(1);
    }
    100% {
      opacity: 1;
      text-shadow: 0 0 8px #E1AD01, 0 0 16px #E1AD01;
      filter: brightness(1);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nameElement = document.getElementById('animated-name');
    if (!nameElement) return;
    
    // Check if already animated (using sessionStorage)
    if (sessionStorage.getItem('nameAnimated')) {
      nameElement.style.animation = 'none';
      nameElement.style.opacity = '1';
      nameElement.style.textShadow = '0 0 8px #E1AD01, 0 0 16px #E1AD01';
      nameElement.style.filter = 'brightness(1)';
      return;
    }
    
    sessionStorage.setItem('nameAnimated', 'true');
  });
</script>