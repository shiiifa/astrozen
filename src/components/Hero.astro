---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty } = Astro.props;
---

<section class="py-24 md:py-32 text-center relative" id="#hero">
  {/* Flickering Name */}
  <h1
    class="mb-9 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:text-8xl flicker-text"
    id="animated-name"
  >
    {name}
  </h1>
  
  {/* Specialty Text with Typing Effect */}
  <p
    class="font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl typing-container"
    id="specialty-text"
  >
    <span class="typing-text"></span>
    <span class="typing-cursor">|</span>
  </p>
</section>

<style>
  /* Light Bulb Flicker Effect */
  .flicker-text {
    opacity: 0;
    animation: lightbulb-flicker 2.5s ease-out forwards;
  }

  @keyframes lightbulb-flicker {
    0% {
      opacity: 0;
      text-shadow: 0 0 0px #E1AD01;
      filter: brightness(0);
    }
    5% {
      opacity: 0.1;
      text-shadow: 0 0 2px #E1AD01;
      filter: brightness(0.2);
    }
    10% {
      opacity: 0;
      text-shadow: 0 0 0px #E1AD01;
      filter: brightness(0);
    }
    15% {
      opacity: 0.3;
      text-shadow: 0 0 5px #E1AD01;
      filter: brightness(0.4);
    }
    20% {
      opacity: 0.1;
      text-shadow: 0 0 2px #E1AD01;
      filter: brightness(0.2);
    }
    25% {
      opacity: 0.5;
      text-shadow: 0 0 8px #E1AD01, 0 0 16px #E1AD0140;
      filter: brightness(0.7);
    }
    30% {
      opacity: 0.2;
      text-shadow: 0 0 3px #E1AD01;
      filter: brightness(0.3);
    }
    35% {
      opacity: 0.7;
      text-shadow: 0 0 12px #E1AD01, 0 0 24px #E1AD0160;
      filter: brightness(0.9);
    }
    40% {
      opacity: 0.4;
      text-shadow: 0 0 6px #E1AD01;
      filter: brightness(0.5);
    }
    45% {
      opacity: 0.9;
      text-shadow: 0 0 15px #E1AD01, 0 0 30px #E1AD0180;
      filter: brightness(1.1);
    }
    50% {
      opacity: 0.6;
      text-shadow: 0 0 8px #E1AD01;
      filter: brightness(0.7);
    }
    55% {
      opacity: 1;
      text-shadow: 0 0 20px #E1AD01, 0 0 40px #E1AD01;
      filter: brightness(1.3);
    }
    60% {
      opacity: 0.8;
      text-shadow: 0 0 12px #E1AD01;
      filter: brightness(1);
    }
    65% {
      opacity: 1;
      text-shadow: 0 0 18px #E1AD01, 0 0 36px #E1AD01;
      filter: brightness(1.2);
    }
    70% {
      opacity: 0.9;
      text-shadow: 0 0 14px #E1AD01;
      filter: brightness(1);
    }
    75% {
      opacity: 1;
      text-shadow: 0 0 16px #E1AD01, 0 0 32px #E1AD01;
      filter: brightness(1.1);
    }
    80% {
      opacity: 1;
      text-shadow: 0 0 15px #E1AD01, 0 0 30px #E1AD01;
      filter: brightness(1);
    }
    85% {
      opacity: 1;
      text-shadow: 0 0 14px #E1AD01, 0 0 28px #E1AD01;
      filter: brightness(1);
    }
    90% {
      opacity: 1;
      text-shadow: 0 0 12px #E1AD01, 0 0 24px #E1AD01;
      filter: brightness(1);
    }
    95% {
      opacity: 1;
      text-shadow: 0 0 10px #E1AD01, 0 0 20px #E1AD01;
      filter: brightness(1);
    }
    100% {
      opacity: 1;
      text-shadow: 0 0 8px #E1AD01, 0 0 16px #E1AD01;
      filter: brightness(1);
    }
  }

  /* Typing Effect */
  .typing-container {
    display: inline-block;
    position: relative;
  }

  .typing-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid #E1AD01;
    animation: typing 2s steps(30, end) 2.5s forwards, blink-cursor 0.75s step-end infinite 2.5s;
    width: 0;
  }

  .typing-cursor {
    opacity: 0;
    animation: blink-cursor 0.75s step-end infinite 2.5s;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 100%; border-right: none; }
  }

  @keyframes blink-cursor {
    from, to { opacity: 0; }
    50% { opacity: 1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nameElement = document.getElementById('animated-name');
    const specialtyElement = document.getElementById('specialty-text');
    const typingText = document.querySelector('.typing-text');
    
    if (!nameElement || !typingText) return;
    
    // Check if already animated (using sessionStorage)
    if (sessionStorage.getItem('nameAnimated')) {
      nameElement.style.animation = 'none';
      nameElement.style.opacity = '1';
      nameElement.style.textShadow = '0 0 8px #E1AD01, 0 0 16px #E1AD01';
      nameElement.style.filter = 'brightness(1)';
      
      // Set specialty text immediately
      typingText.textContent = 'Technology | Creativity';
      typingText.style.width = '100%';
      typingText.style.borderRight = 'none';
      return;
    }
    
    sessionStorage.setItem('nameAnimated', 'true');
    
    // Set the text to be typed
    typingText.textContent = 'Technology | Creativity';
  });
</script>