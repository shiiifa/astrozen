---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty } = Astro.props;
---

<section class="py-24 md:py-32 text-center" id="#hero">
  <!-- Animated Name -->
  <h1
    class="mb-1.5 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:mb-0 md:text-8xl"
    id="animated-name"
  >
    {name}
  </h1>
  
  <p
    class="mb-9 font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {specialty}
  </p>
  <!-- Summary text removed -->
</section>

<style>
  /* Typing animation */
  .typing-animation {
    overflow: hidden;
    border-right: 3px solid #E1AD01;
    white-space: nowrap;
    animation: typing 2.5s steps(30, end), blink-cursor 0.75s step-end infinite;
    width: 0;
  }

  .typing-complete {
    border-right: none; /* Remove cursor after typing */
    animation: none;
    width: 100%;
  }

  @keyframes typing {
    from { width: 0 }
    to { width: 100% }
  }

  @keyframes blink-cursor {
    from, to { border-color: transparent }
    50% { border-color: #E1AD01; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nameElement = document.getElementById('animated-name');
    if (!nameElement) return;
    
    // Check if already animated (using sessionStorage)
    if (sessionStorage.getItem('nameAnimated')) {
      return; // Skip animation if already done in this session
    }
    
    const fullName = nameElement.textContent;
    nameElement.textContent = '';
    nameElement.classList.add('typing-animation');
    
    let i = 0;
    const typeWriter = () => {
      if (i < fullName.length) {
        nameElement.textContent += fullName.charAt(i);
        i++;
        setTimeout(typeWriter, 80); // Faster typing speed
      } else {
        // Animation complete
        nameElement.classList.remove('typing-animation');
        nameElement.classList.add('typing-complete');
        sessionStorage.setItem('nameAnimated', 'true'); // Mark as animated
      }
    };
    
    // Start animation
    setTimeout(typeWriter, 300);
  });
</script>