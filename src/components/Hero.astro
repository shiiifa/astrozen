---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty } = Astro.props;
---

<section class="py-24 md:py-32 text-center relative overflow-hidden" id="#hero">
  {/* Animated Circuit Background */}
  <div class="absolute inset-0 z-0 opacity-20">
    <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path class="animate-circuit-path" d="M10,10 L90,10 L90,90 L10,90 Z" 
            stroke="#E1AD01" stroke-width="0.2" fill="none" />
      {/* Additional circuit paths */}
      <path class="animate-circuit-path" d="M30,30 L70,30 L70,70 L30,70 Z" 
            stroke="#E1AD01" stroke-width="0.1" fill="none" style="animation-delay: 1s" />
      <path class="animate-circuit-path" d="M40,40 L60,40 L60,60 L40,60 Z" 
            stroke="#E1AD01" stroke-width="0.05" fill="none" style="animation-delay: 2s" />
    </svg>
  </div>

  {/* Animated Name with Circuit Connection Points */}
  <h1
    class="mb-1.5 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:mb-0 md:text-8xl relative z-10"
    id="animated-name"
  >
    {name.split('').map((letter, index) => (
      <span class="circuit-letter" style={`--delay: ${index * 0.1}s`}>
        {letter}
      </span>
    ))}
  </h1>
  
  {/* Specialty with Animated Divider */}
  <div class="relative mb-9">
    <div class="circuit-divider"></div>
    <p
      class="font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl relative z-10"
    >
      {specialty}
    </p>
  </div>

  {/* Interactive Grid Background */}
  <div class="absolute inset-0 z-0 grid grid-cols-12 grid-rows-12 pointer-events-none">
    {Array.from({ length: 144 }).map((_, i) => (
      <div class="circuit-node group" style={`--index: ${i}`}>
        <div class="node-dot"></div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Circuit Board Animation */
  .animate-circuit-path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw-circuit 6s ease-in-out infinite;
  }

  @keyframes draw-circuit {
    to { stroke-dashoffset: 0; }
  }

  /* Letter-by-letter circuit animation */
  .circuit-letter {
    display: inline-block;
    opacity: 0;
    animation: circuit-glow 2s ease-out var(--delay) forwards;
  }

  @keyframes circuit-glow {
    0% { 
      opacity: 0;
      text-shadow: 0 0 20px #E1AD01;
    }
    100% { 
      opacity: 1;
      text-shadow: 0 0 10px #E1AD01, 0 0 20px #E1AD01;
    }
  }

  /* Animated circuit divider */
  .circuit-divider {
    width: 200px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #E1AD01, transparent);
    margin: 2rem auto;
    position: relative;
    overflow: hidden;
  }

  .circuit-divider::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #fff, transparent);
    animation: circuit-flow 3s ease-in-out infinite;
  }

  @keyframes circuit-flow {
    to { left: 100%; }
  }

  /* Interactive Grid Nodes */
  .circuit-node {
    position: relative;
    transition: all 0.3s ease;
  }

  .node-dot {
    width: 3px;
    height: 3px;
    background: #E1AD01;
    border-radius: 50%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.3s ease;
  }

  .circuit-node:hover .node-dot {
    width: 8px;
    height: 8px;
    box-shadow: 0 0 10px #E1AD01;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nameElement = document.getElementById('animated-name');
    if (!nameElement) return;
    
    // Check if already animated (using sessionStorage)
    if (sessionStorage.getItem('nameAnimated')) {
      return; // Skip animation if already done in this session
    }
    
    const fullName = nameElement.textContent;
    nameElement.textContent = '';
    
    let i = 0;
    const typeWriter = () => {
      if (i < fullName.length) {
        nameElement.textContent += fullName.charAt(i);
        i++;
        setTimeout(typeWriter, 80);
      } else {
        // Animation complete
        sessionStorage.setItem('nameAnimated', 'true');
      }
    };
    
    // Start animation
    setTimeout(typeWriter, 300);
  });
</script>