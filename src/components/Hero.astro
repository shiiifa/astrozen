---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name } = Astro.props;
---

<section class="py-24 md:py-32 text-center relative" id="#hero">
  {/* Continuous Flickering Name - Slower and Softer */}
  <h1
    class="mb-9 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:text-8xl continuous-flicker"
    id="animated-name"
  >
    {name}
  </h1>
</section>

<style>
  /* Continuous Flicker Effect with Softer White Glow */
  .continuous-flicker {
    animation: continuous-flicker 5s ease-in-out infinite; /* Slower frequency */
    text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff; /* Softer glow */
  }

  @keyframes continuous-flicker {
    0%, 100% {
      opacity: 1;
      filter: brightness(1.1);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    5% {
      opacity: 0.9;
      filter: brightness(0.95);
      text-shadow: 0 0 3px #ffffff, 0 0 6px #ffffff;
    }
    10% {
      opacity: 1;
      filter: brightness(1.15);
      text-shadow: 0 0 6px #ffffff, 0 0 12px #ffffff;
    }
    15% {
      opacity: 0.95;
      filter: brightness(1);
      text-shadow: 0 0 4px #ffffff, 0 0 8px #ffffff;
    }
    20% {
      opacity: 1;
      filter: brightness(1.08);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    25% {
      opacity: 0.98;
      filter: brightness(1.04);
      text-shadow: 0 0 4px #ffffff, 0 0 8px #ffffff;
    }
    50% {
      opacity: 1;
      filter: brightness(1.06);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    55% {
      opacity: 0.92;
      filter: brightness(0.97);
      text-shadow: 0 0 3px #ffffff, 0 0 6px #ffffff;
    }
    60% {
      opacity: 1;
      filter: brightness(1.18);
      text-shadow: 0 0 7px #ffffff, 0 0 14px #ffffff;
    }
    65% {
      opacity: 0.96;
      filter: brightness(1.03);
      text-shadow: 0 0 4px #ffffff, 0 0 8px #ffffff;
    }
    70% {
      opacity: 1;
      filter: brightness(1.12);
      text-shadow: 0 0 6px #ffffff, 0 0 12px #ffffff;
    }
    75% {
      opacity: 0.99;
      filter: brightness(1.05);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    80% {
      opacity: 1;
      filter: brightness(1.09);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    85% {
      opacity: 1;
      filter: brightness(1.07);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    90% {
      opacity: 1;
      filter: brightness(1.05);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
    95% {
      opacity: 1;
      filter: brightness(1.03);
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
  }
</style>