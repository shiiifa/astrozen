---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="projects and research" href="projects">
  <div class="space-y-12">
    {/* Academic Projects Section */}
    <div class="relative">
       {/* Academic Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">academic</h3>
       </div>

      {/* Navigation Arrows */}
      <button id="prevBtn" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button id="nextBtn" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Academic Projects Container */}
      <div id="projectsContainer" class="flex overflow-x-hidden scroll-smooth space-x-6 py-4 cursor-grab active:cursor-grabbing touch-pan-x select-none">
         {/* Academic Projects Preview */}
         {
           projects.map(({ name, summary, image }) => (
             <a
               href="#projects"
               class="group fade-in-tile relative flex-shrink-0 w-80 overflow-hidden rounded-2xl border border-neutral/20 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
             >
              {/* ORIGINAL ASH BACKGROUND RESTORED */}
              <div class="bg-difu absolute inset-0 z-0 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-['']"></div>
              
              {/* Content */}
              <div class="relative z-10 flex h-full flex-col p-6">
                {/* Image */}
                <div class="mb-6 overflow-hidden rounded-xl -mt-8">
                  <Image
                    class="fade-in-image h-48 w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    src={image}
                    alt={name}
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                </div>
                
                {/* Text Content */}
                <div class="flex flex-1 flex-col">
                  <h3 class="fade-in-element mb-3 font-serif text-xl font-medium text-primary transition-colors duration-300 group-hover:text-white">
                    {name}
                  </h3>
                  <p class="fade-in-element mb-4 flex-1 text-sm text-neutral group-hover:text-white/80 transition-colors duration-300">
                    {summary}
                  </p>
                  
                  {/* Links */}
                  <div class="fade-in-element flex gap-4 pt-4 text-xs text-white/70">
                    <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                      <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                      View Details
                    </span>
                  </div>
                </div>
              </div>
              
              {/* Hover overlay effect */}
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
            </a>
          ))
        }
      </div>
    </div>

    {/* Freelance Projects Section */}
    <div class="relative">
       {/* Freelance Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">freelance</h3>
       </div>

      {/* GitHub Contribution Graph */}
      <div class="flex flex-col items-center justify-center py-8">
        <div class="text-center mb-6">
          <h4 class="text-primary text-lg font-medium mb-2">GitHub Activity</h4>
          <p class="text-neutral/70 text-sm">Development contributions and project activity</p>
        </div>
        
        {/* GitHub Contribution Graph */}
        <div class="bg-[#1c232d]/85 rounded-2xl p-6 border border-neutral/20 w-full max-w-4xl">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="text-white font-medium">@shiiifa</span>
            </div>
            <div class="text-neutral/60 text-sm">
              <span id="totalContributions">Loading...</span> contributions in 2024
            </div>
          </div>
          
          {/* Contribution Graph Container */}
          <div class="overflow-x-auto">
            <div id="githubGraph" class="flex flex-col gap-1 min-w-[600px]">
              <!-- GitHub contribution graph will be loaded here -->
            </div>
          </div>
          
          {/* Legend */}
          <div class="flex items-center justify-between mt-4 text-xs text-neutral/60">
            <span>Less</span>
            <div class="flex gap-1">
              <div class="w-3 h-3 bg-neutral/20 rounded-sm"></div>
              <div class="w-3 h-3 bg-primary/20 rounded-sm"></div>
              <div class="w-3 h-3 bg-primary/40 rounded-sm"></div>
              <div class="w-3 h-3 bg-primary/60 rounded-sm"></div>
              <div class="w-3 h-3 bg-primary rounded-sm"></div>
            </div>
            <span>More</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Custom animations */
  .group {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  
  .group:hover {
    transform: translateY(-4px) scale(1.02);
  }
  
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, var(--color-primary)/10, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 1rem;
  }
  
  .group:hover::before {
    opacity: 1;
  }

  /* Hide scrollbar but keep functionality */
  #projectsContainer {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  #projectsContainer::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('projectsContainer');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const projectWidth = 320; // Width of each project card + gap

    if (!container || !prevBtn || !nextBtn) return;

    // Scroll to next project
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: projectWidth, behavior: 'smooth' });
    });

    // Scroll to previous project
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
    });

    // Hide arrows when at edges
    const checkArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;
      prevBtn.style.opacity = scrollLeft > 0 ? '1' : '0.5';
      nextBtn.style.opacity = scrollLeft < scrollWidth - clientWidth - 10 ? '1' : '0.5';
    };

    container.addEventListener('scroll', checkArrows);
    checkArrows(); // Initial check

    // Add keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        container.scrollBy({ left: projectWidth, behavior: 'smooth' });
      }
    });

    // Enhanced touch and mouse sliding functionality
    let startX: number;
    let scrollLeft: number;
    let isDown = false;
    let startTime: number;
    let velocity = 0;
    let lastX: number;
    let lastTime: number;
    let isScrolling = false;

    const snapToItem = () => {
      const currentScroll = container.scrollLeft;
      const targetIndex = Math.round(currentScroll / projectWidth);
      const targetScroll = targetIndex * projectWidth;
      
      container.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
    };

    const handleStart = (clientX: number) => {
      isDown = true;
      isScrolling = false;
      startX = clientX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
      startTime = Date.now();
      lastX = clientX;
      lastTime = startTime;
      velocity = 0;
      container.classList.add('active');
      container.style.scrollBehavior = 'auto';
    };

    const handleMove = (clientX: number) => {
      if (!isDown) return;
      
      isScrolling = true;
      const x = clientX - container.offsetLeft;
      const walk = (x - startX) * 1.2; // Reduced sensitivity for better control
      container.scrollLeft = scrollLeft - walk;
      
      // Calculate velocity for momentum
      const currentTime = Date.now();
      const deltaX = clientX - lastX;
      const deltaTime = currentTime - lastTime;
      
      if (deltaTime > 0) {
        velocity = deltaX / deltaTime;
      }
      
      lastX = clientX;
      lastTime = currentTime;
    };

    const handleEnd = () => {
      if (!isDown) return;
      
      isDown = false;
      container.classList.remove('active');
      container.style.scrollBehavior = 'smooth';
      
      // Only apply momentum if user was actually scrolling
      if (isScrolling && Math.abs(velocity) > 0.3) {
        const momentum = velocity * 150; // Reduced momentum for better control
        const currentScroll = container.scrollLeft;
        const targetScroll = currentScroll - momentum;
        
        container.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
        
        // Snap to item after momentum
        setTimeout(snapToItem, 250);
      } else if (isScrolling) {
        // Snap to nearest item
        snapToItem();
      }
    };

    // Mouse events
    container.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      handleStart(e.clientX);
    });

    container.addEventListener('mouseleave', handleEnd);
    container.addEventListener('mouseup', handleEnd);

    container.addEventListener('mousemove', (e: MouseEvent) => {
      e.preventDefault();
      handleMove(e.clientX);
    });

    // Touch events with improved mobile handling
    let touchStartTime: number;
    let touchStartX: number;
    let touchStartY: number;
    let isTouchScrolling = false;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const element = document.elementFromPoint(touch.clientX, touch.clientY);
        
        // If touching a link, don't interfere with the click
        if (element && element.closest('a')) {
          return;
        }
        
        touchStartTime = Date.now();
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        isTouchScrolling = false;
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const deltaX = Math.abs(touch.clientX - touchStartX);
        const deltaY = Math.abs(touch.clientY - touchStartY);
        
        // If horizontal movement is significant, treat as scroll
        if (deltaX > 10 || deltaY > 10) {
          isTouchScrolling = true;
          e.preventDefault();
          handleStart(touch.clientX);
          handleMove(touch.clientX);
        }
      }
    }, { passive: false });

    container.addEventListener('touchend', (e: TouchEvent) => {
      const touchDuration = Date.now() - touchStartTime;
      const deltaX = Math.abs(e.changedTouches[0].clientX - touchStartX);
      const deltaY = Math.abs(e.changedTouches[0].clientY - touchStartY);
      
      // If it was a quick tap with minimal movement, allow link clicks
      if (touchDuration < 200 && deltaX < 10 && deltaY < 10 && !isTouchScrolling) {
        const element = document.elementFromPoint(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
        if (element && element.closest('a')) {
          // Let the link handle the click
          return;
        }
      }
      
      if (isTouchScrolling) {
        e.preventDefault();
        handleEnd();
      }
     }, { passive: false });
   });

   // GitHub Contribution Graph
   async function loadGitHubContributions() {
     try {
       const username = 'shiiifa';
       const response = await fetch(`https://api.github.com/users/${username}/events/public`);
       const events = await response.json();
       
       // Process events to create contribution data
       const contributions: Record<string, number> = {};
       const currentYear = new Date().getFullYear();
       
       events.forEach((event: any) => {
         const date = new Date(event.created_at);
         if (date.getFullYear() === currentYear) {
           const dateStr = date.toISOString().split('T')[0];
           contributions[dateStr] = (contributions[dateStr] || 0) + 1;
         }
       });
       
       // Generate contribution graph
       const graphContainer = document.getElementById('githubGraph');
       const totalContributionsElement = document.getElementById('totalContributions');
       
       if (!graphContainer || !totalContributionsElement) {
         console.error('Required DOM elements not found');
         return;
       }
       
       const totalContributions = Object.values(contributions).reduce((sum: number, count: number) => sum + count, 0);
       
       totalContributionsElement.textContent = totalContributions.toString();
       
       // Create weeks
       const weeks: Array<Array<{ date: string; count: number }>> = [];
       const startDate = new Date(currentYear, 0, 1);
       const endDate = new Date(currentYear, 11, 31);
       
       let currentDate = new Date(startDate);
       while (currentDate <= endDate) {
         const week: Array<{ date: string; count: number }> = [];
         for (let i = 0; i < 7; i++) {
           const dateStr = currentDate.toISOString().split('T')[0];
           const count = contributions[dateStr] || 0;
           week.push({ date: dateStr, count });
           currentDate.setDate(currentDate.getDate() + 1);
         }
         weeks.push(week);
       }
       
       // Render graph
       weeks.forEach(week => {
         const weekElement = document.createElement('div');
         weekElement.className = 'flex gap-1';
         
         week.forEach(day => {
           const dayElement = document.createElement('div');
           dayElement.className = 'w-3 h-3 rounded-sm';
           
           // Set color based on contribution count
           if (day.count === 0) {
             dayElement.className += ' bg-neutral/20';
           } else if (day.count === 1) {
             dayElement.className += ' bg-primary/20';
           } else if (day.count === 2) {
             dayElement.className += ' bg-primary/40';
           } else if (day.count === 3) {
             dayElement.className += ' bg-primary/60';
           } else {
             dayElement.className += ' bg-primary';
           }
           
           // Add tooltip
           dayElement.title = `${day.date}: ${day.count} contributions`;
           weekElement.appendChild(dayElement);
         });
         
         graphContainer.appendChild(weekElement);
       });
       
     } catch (error) {
       console.error('Error loading GitHub contributions:', error);
       const totalContributionsElement = document.getElementById('totalContributions');
       if (totalContributionsElement) {
         totalContributionsElement.textContent = 'Error loading data';
       }
     }
   }
   
   // Load GitHub contributions when page loads
   loadGitHubContributions();
 </script>