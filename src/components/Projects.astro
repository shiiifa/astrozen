---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="projects and research" href="projects">
  <div class="space-y-12">
    {/* Academic Projects Section */}
    <div class="relative">
       {/* Academic Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">academic</h3>
       </div>

      {/* Navigation Arrows */}
      <button id="prevBtn" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button id="nextBtn" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Academic Projects Container */}
      <div id="projectsContainer" class="flex overflow-x-hidden scroll-smooth space-x-6 py-4 cursor-grab active:cursor-grabbing touch-pan-x select-none">
         {/* Academic Projects Preview */}
         {
           projects.map(({ name, summary, image }) => (
             <a
               href="#projects"
               class="group fade-in-tile relative flex-shrink-0 w-80 overflow-hidden rounded-2xl border border-neutral/20 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
             >
              {/* ORIGINAL ASH BACKGROUND RESTORED */}
              <div class="bg-difu absolute inset-0 z-0 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-['']"></div>
              
              {/* Content */}
              <div class="relative z-10 flex h-full flex-col p-6">
                {/* Image */}
                <div class="mb-6 overflow-hidden rounded-xl -mt-8">
                  <Image
                    class="fade-in-image h-48 w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    src={image}
                    alt={name}
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                </div>
                
                {/* Text Content */}
                <div class="flex flex-1 flex-col">
                  <h3 class="fade-in-element mb-3 font-serif text-xl font-medium text-primary transition-colors duration-300 group-hover:text-white">
                    {name}
                  </h3>
                  <p class="fade-in-element mb-4 flex-1 text-sm text-neutral group-hover:text-white/80 transition-colors duration-300">
                    {summary}
                  </p>
                  
                  {/* Links */}
                  <div class="fade-in-element flex gap-4 pt-4 text-xs text-white/70">
                    <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                      <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                      View Details
                    </span>
                  </div>
                </div>
              </div>
              
              {/* Hover overlay effect */}
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
            </a>
          ))
        }
      </div>
    </div>

    {/* Freelance Projects Section */}
    <div class="relative">
       {/* Freelance Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">freelance</h3>
       </div>

      {/* Freelance Projects Preview */}
      <div class="flex justify-center py-8">
        <a 
          href="/projects/freelance" 
          class="group w-full max-w-4xl bg-[#1c232d]/85 rounded-2xl border border-neutral/20 hover:border-primary/30 transition-all duration-500 overflow-hidden"
        >
          <div class="grid md:grid-cols-2 gap-0">
            {/* Thumbnail */}
            <div class="relative h-48 md:h-full min-h-[200px] overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-primary/5"></div>
              <iframe 
                src="https://obedbabington.vercel.app" 
                class="w-full h-full scale-50 origin-top-left"
                loading="lazy"
                title="Portfolio Preview"
                sandbox="allow-scripts allow-same-origin"
              ></iframe>
            </div>
            
            {/* Content */}
            <div class="p-8 flex flex-col justify-center">
              <div class="mb-4">
                <h4 class="text-primary text-lg font-medium mb-2">recent work</h4>
                <h3 class="text-xl font-serif font-bold text-white mb-3">Portfolio Optimisation</h3>
                <p class="text-neutral/80 text-sm leading-relaxed">
                  Currently building a modern and responsive portfolio website with Next.js and Tailwind CSS for a graduate student. Features include optimised performance and clean, academia-oriented design.
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-primary text-sm font-medium">
                <span>View Full Page</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Custom animations */
  .group {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  
  .group:hover {
    transform: translateY(-4px) scale(1.02);
  }
  
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, var(--color-primary)/10, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 1rem;
  }
  
  .group:hover::before {
    opacity: 1;
  }

  /* Hide scrollbar but keep functionality */
  #projectsContainer {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  #projectsContainer::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('projectsContainer');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const projectWidth = 320; // Width of each project card + gap

    if (!container || !prevBtn || !nextBtn) return;

    // Scroll to next project
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: projectWidth, behavior: 'smooth' });
    });

    // Scroll to previous project
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
    });

    // Hide arrows when at edges
    const checkArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;
      prevBtn.style.opacity = scrollLeft > 0 ? '1' : '0.5';
      nextBtn.style.opacity = scrollLeft < scrollWidth - clientWidth - 10 ? '1' : '0.5';
    };

    container.addEventListener('scroll', checkArrows);
    checkArrows(); // Initial check

    // Add keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        container.scrollBy({ left: projectWidth, behavior: 'smooth' });
      }
    });

    // Enhanced touch and mouse sliding functionality
    let startX: number;
    let scrollLeft: number;
    let isDown = false;
    let startTime: number;
    let velocity = 0;
    let lastX: number;
    let lastTime: number;
    let isScrolling = false;

    const snapToItem = () => {
      const currentScroll = container.scrollLeft;
      const targetIndex = Math.round(currentScroll / projectWidth);
      const targetScroll = targetIndex * projectWidth;
      
      container.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
    };

    const handleStart = (clientX: number) => {
      isDown = true;
      isScrolling = false;
      startX = clientX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
      startTime = Date.now();
      lastX = clientX;
      lastTime = startTime;
      velocity = 0;
      container.classList.add('active');
      container.style.scrollBehavior = 'auto';
    };

    const handleMove = (clientX: number) => {
      if (!isDown) return;
      
      isScrolling = true;
      const x = clientX - container.offsetLeft;
      const walk = (x - startX) * 1.2; // Reduced sensitivity for better control
      container.scrollLeft = scrollLeft - walk;
      
      // Calculate velocity for momentum
      const currentTime = Date.now();
      const deltaX = clientX - lastX;
      const deltaTime = currentTime - lastTime;
      
      if (deltaTime > 0) {
        velocity = deltaX / deltaTime;
      }
      
      lastX = clientX;
      lastTime = currentTime;
    };

    const handleEnd = () => {
      if (!isDown) return;
      
      isDown = false;
      container.classList.remove('active');
      container.style.scrollBehavior = 'smooth';
      
      // Only apply momentum if user was actually scrolling
      if (isScrolling && Math.abs(velocity) > 0.3) {
        const momentum = velocity * 150; // Reduced momentum for better control
        const currentScroll = container.scrollLeft;
        const targetScroll = currentScroll - momentum;
        
        container.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
        
        // Snap to item after momentum
        setTimeout(snapToItem, 250);
      } else if (isScrolling) {
        // Snap to nearest item
        snapToItem();
      }
    };

    // Mouse events
    container.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      handleStart(e.clientX);
    });

    container.addEventListener('mouseleave', handleEnd);
    container.addEventListener('mouseup', handleEnd);

    container.addEventListener('mousemove', (e: MouseEvent) => {
      e.preventDefault();
      handleMove(e.clientX);
    });

    // Touch events with improved mobile handling
    let touchStartTime: number;
    let touchStartX: number;
    let touchStartY: number;
    let isTouchScrolling = false;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const element = document.elementFromPoint(touch.clientX, touch.clientY);
        
        // If touching a link, don't interfere with the click
        if (element && element.closest('a')) {
          return;
        }
        
        touchStartTime = Date.now();
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        isTouchScrolling = false;
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        const touch = e.touches[0];
        const deltaX = Math.abs(touch.clientX - touchStartX);
        const deltaY = Math.abs(touch.clientY - touchStartY);
        
        // If horizontal movement is significant, treat as scroll
        if (deltaX > 10 || deltaY > 10) {
          isTouchScrolling = true;
          e.preventDefault();
          handleStart(touch.clientX);
          handleMove(touch.clientX);
        }
      }
    }, { passive: false });

    container.addEventListener('touchend', (e: TouchEvent) => {
      const touchDuration = Date.now() - touchStartTime;
      const deltaX = Math.abs(e.changedTouches[0].clientX - touchStartX);
      const deltaY = Math.abs(e.changedTouches[0].clientY - touchStartY);
      
      // If it was a quick tap with minimal movement, allow link clicks
      if (touchDuration < 200 && deltaX < 10 && deltaY < 10 && !isTouchScrolling) {
        const element = document.elementFromPoint(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
        if (element && element.closest('a')) {
          // Let the link handle the click
          return;
        }
      }
      
      if (isTouchScrolling) {
        e.preventDefault();
        handleEnd();
      }
     }, { passive: false });
   });

 </script>