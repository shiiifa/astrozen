---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="relative">
    {/* Navigation Arrows */}
    <button id="prevBtn" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors opacity-0 md:opacity-100">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    
    <button id="nextBtn" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-3 text-primary hover:bg-primary/30 transition-colors opacity-0 md:opacity-100">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    {/* Projects Container */}
    <div id="projectsContainer" class="flex overflow-x-auto scroll-smooth space-x-6 py-4 md:overflow-x-hidden">
      {
        projects.map(({ name, summary, image }) => (
          <a
            href={`/projects/${name.toLowerCase().replace(/\s+/g, '-')}`}
            class="group relative flex-shrink-0 w-80 overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/85 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20"
          >
            {/* Background pattern */}
            <div class="absolute inset-0 z-0 rounded-2xl bg-[url(/raja.png)] bg-[length:128px] bg-repeat opacity-[3%] group-hover:opacity-[5%] transition-opacity duration-500"></div>
            
            {/* Content */}
            <div class="relative z-10 flex h-full flex-col p-6">
              {/* Image */}
              <div class="mb-6 overflow-hidden rounded-xl">
                <Image
                  class="h-48 w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  src={image}
                  alt={name}
                  width={400}
                  height={300}
                  loading="lazy"
                />
              </div>
              
              {/* Text Content */}
              <div class="flex flex-1 flex-col">
                <h3 class="mb-3 font-serif text-xl font-medium text-primary transition-colors duration-300 group-hover:text-white">
                  {name}
                </h3>
                <p class="mb-4 flex-1 text-sm text-neutral group-hover:text-white/80 transition-colors duration-300">
                  {summary}
                </p>
                
                {/* Links */}
                <div class="flex gap-4 pt-4 text-xs text-white/70">
                  <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                    <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                    View Details
                  </span>
                </div>
              </div>
            </div>
            
            {/* Hover overlay effect */}
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
          </a>
        ))
      }
    </div>
  </div>
</Section>

<style>
  /* Custom animations */
  .group {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  
  .group:hover {
    transform: translateY(-4px) scale(1.02);
  }
  
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, var(--color-primary)/10, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 1rem;
  }
  
  .group:hover::before {
    opacity: 1;
  }

  /* Hide scrollbar but keep functionality */
  #projectsContainer {
    -ms-overflow-style: none;
    scrollbar-width: none;
    cursor: grab;
  }
  
  #projectsContainer::-webkit-scrollbar {
    display: none;
  }

  #projectsContainer:active {
    cursor: grabbing;
  }

  /* Show arrows on hover for desktop */
  @media (min-width: 768px) {
    .relative:hover #prevBtn,
    .relative:hover #nextBtn {
      opacity: 1 !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('projectsContainer');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const projectWidth = 320; // Width of each project card + gap

    if (!container || !prevBtn || !nextBtn) return;

    // Touch/swipe variables
    let startX;
    let scrollLeft;
    let isDragging = false;

    // Touch start event
    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
      container.style.cursor = 'grabbing';
      container.style.scrollBehavior = 'auto'; // Disable smooth scroll during drag
    });

    // Touch move event
    container.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.touches[0].pageX - container.offsetLeft;
      const walk = (x - startX) * 2; // Scroll speed multiplier
      container.scrollLeft = scrollLeft - walk;
    });

    // Touch end event
    container.addEventListener('touchend', () => {
      isDragging = false;
      container.style.cursor = 'grab';
      container.style.scrollBehavior = 'smooth';
    });

    // Mouse drag events for desktop touch devices
    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
      container.style.cursor = 'grabbing';
      container.style.scrollBehavior = 'auto';
    });

    container.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const walk = (x - startX) * 2;
      container.scrollLeft = scrollLeft - walk;
    });

    container.addEventListener('mouseup', () => {
      isDragging = false;
      container.style.cursor = 'grab';
      container.style.scrollBehavior = 'smooth';
    });

    container.addEventListener('mouseleave', () => {
      isDragging = false;
      container.style.cursor = 'grab';
      container.style.scrollBehavior = 'smooth';
    });

    // Scroll to next project
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: projectWidth, behavior: 'smooth' });
    });

    // Scroll to previous project
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
    });

    // Hide arrows when at edges
    const checkArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;
      prevBtn.style.opacity = scrollLeft > 0 ? '1' : '0.5';
      nextBtn.style.opacity = scrollLeft < scrollWidth - clientWidth - 10 ? '1' : '0.5';
    };

    container.addEventListener('scroll', checkArrows);
    checkArrows(); // Initial check

    // Add keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        container.scrollBy({ left: -projectWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        container.scrollBy({ left: projectWidth, behavior: 'smooth' });
      }
    });

    // Show arrows on container hover (desktop only)
    if (window.matchMedia('(min-width: 768px)').matches) {
      container.parentElement.addEventListener('mouseenter', () => {
        checkArrows();
      });
    }
  });
</script>