---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="projects and research" href="projects">
  <div class="space-y-12">
    {/* Academic Projects Section */}
    <div class="relative">
       {/* Academic Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">academic</h3>
       </div>

      {/* Navigation Arrows */}
      <button type="button" id="prevBtn" aria-label="Previous projects" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-opacity duration-200 touch-manipulation disabled:opacity-40 disabled:pointer-events-none" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button type="button" id="nextBtn" aria-label="Next projects" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 transform rounded-full bg-primary/20 p-2 sm:p-3 text-primary hover:bg-primary/30 transition-opacity duration-200 touch-manipulation disabled:opacity-40 disabled:pointer-events-none" style="touch-action: manipulation; -webkit-tap-highlight-color: transparent;">
        <svg class="h-4 w-4 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Academic Projects Container */}
      <div
        id="projectsContainer"
        class="flex overflow-x-auto space-x-6 py-4 cursor-grab active:cursor-grabbing select-none snap-x snap-mandatory"
        style="touch-action: pan-x; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none;"
      >
         {/* Academic Projects Preview */}
         {
           projects.map(({ name, summary, image, linkPreview }) => (
             <a
               href={linkPreview}
               class="group fade-in-tile relative flex-shrink-0 w-80 overflow-hidden rounded-2xl border border-neutral/20 transition-all duration-500 hover:scale-105 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/20 snap-start"
               draggable="false"
             >
              {/* ORIGINAL ASH BACKGROUND RESTORED */}
              <div class="bg-difu absolute inset-0 z-0 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-['']"></div>
              
              {/* Content */}
              <div class="relative z-10 flex h-full flex-col p-6">
                {/* Image */}
                <div class="mb-6 overflow-hidden rounded-xl -mt-8">
                  <Image
                    class="fade-in-image h-48 w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    src={image}
                    alt={name}
                    width={400}
                    height={300}
                    loading="lazy"
                    draggable="false"
                  />
                </div>
                
                {/* Text Content */}
                <div class="flex flex-1 flex-col">
                  <h3 class="fade-in-element mb-3 font-serif text-xl font-medium text-primary transition-colors duration-300 group-hover:text-white">
                    {name}
                  </h3>
                  <p class="fade-in-element mb-4 flex-1 text-sm text-neutral group-hover:text-white/80 transition-colors duration-300">
                    {summary}
                  </p>
                  
                  {/* Links */}
                  <div class="fade-in-element flex gap-4 pt-4 text-xs text-white/70">
                    <span class="flex items-center gap-1 transition-all duration-300 group-hover:text-primary">
                      <span class="inline-block h-3 w-3 content-[url(/external.svg)] opacity-70 group-hover:opacity-100 transition-opacity"></span>
                      View Details
                    </span>
                  </div>
                </div>
              </div>
              
              {/* Hover overlay effect */}
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-primary/5 to-primary/10 opacity-0 transition-all duration-500 group-hover:opacity-100"></div>
            </a>
          ))
        }
      </div>
    </div>

    {/* Freelance Projects Section */}
    <div class="relative">
       {/* Freelance Subtitle */}
       <div class="mb-6 text-center">
         <h3 class="text-primary text-xl font-bold opacity-80">freelance</h3>
       </div>

      {/* Freelance Projects Preview */}
      <div class="flex justify-center py-8">
        <a 
          href="/projects/freelance" 
          class="group w-full max-w-4xl bg-[#1c232d]/85 rounded-2xl border border-neutral/20 hover:border-primary/30 transition-all duration-500 overflow-hidden"
        >
          <div class="grid md:grid-cols-2 gap-0">
            {/* Thumbnail */}
            <div class="relative h-48 md:h-full min-h-[200px] overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-primary/5"></div>
              <iframe 
                src="https://obedbabington.vercel.app" 
                class="w-full h-full"
                loading="lazy"
                title="Portfolio Preview"
                sandbox="allow-scripts allow-same-origin"
              ></iframe>
            </div>
            
            {/* Content */}
            <div class="p-8 flex flex-col justify-center">
              <div class="mb-4">
                <h4 class="text-primary text-lg font-medium mb-2">recent work</h4>
                <h3 class="text-xl font-serif font-bold text-white mb-3">Portfolio Optimisation</h3>
                <p class="text-neutral/80 text-sm leading-relaxed">
                  Currently building a modern and responsive portfolio website with Next.js and Tailwind CSS for a graduate student. Features include optimised performance and clean, academia-oriented design.
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-primary text-sm font-medium">
                <span>View Full Page</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Custom animations */
  .group {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  
  .group:hover {
    transform: translateY(-4px) scale(1.02);
  }
  
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, var(--color-primary)/10, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 1rem;
  }
  
  .group:hover::before {
    opacity: 1;
  }

  #projectsContainer::-webkit-scrollbar {
    display: none;
  }

  #projectsContainer.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }

  #projectsContainer.is-dragging a {
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('projectsContainer');
    const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement | null;

    if (!container || !prevBtn || !nextBtn) return;

    let animating = false;
    let unlockTimer: ReturnType<typeof setTimeout> | null = null;

    const getStep = () => {
      const item = container.querySelector(':scope > *') as HTMLElement | null;
      if (!item) return 320;
      const styles = getComputedStyle(container);
      const gap = parseFloat(styles.columnGap || styles.gap) || 24;
      return item.offsetWidth + gap;
    };

    const updateArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;
      const maxScroll = Math.max(0, scrollWidth - clientWidth);
      prevBtn.disabled = scrollLeft <= 2;
      nextBtn.disabled = scrollLeft >= maxScroll - 2;
    };

    const scrollByStep = (direction: number) => {
      if (animating) return;
      const { scrollLeft, scrollWidth, clientWidth } = container;
      const maxScroll = Math.max(0, scrollWidth - clientWidth);
      const step = getStep();
      const target = Math.max(0, Math.min(maxScroll, scrollLeft + direction * step));
      if (Math.abs(target - scrollLeft) < 1) return;

      animating = true;
      container.scrollTo({ left: target, behavior: 'smooth' });

      const unlock = () => {
        animating = false;
        updateArrows();
        if (unlockTimer) clearTimeout(unlockTimer);
      };

      container.addEventListener('scrollend', unlock, { once: true });
      if (unlockTimer) clearTimeout(unlockTimer);
      unlockTimer = setTimeout(unlock, 450);
    };

    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollByStep(-1);
    });

    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollByStep(1);
    });

    let scrollRaf = 0;
    container.addEventListener('scroll', () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = 0;
        updateArrows();
      });
    }, { passive: true });

    updateArrows();
    window.addEventListener('resize', updateArrows, { passive: true });

    // Mouse / pen drag-to-slide — only activates after a real drag threshold
    // so simple clicks on project tiles still navigate.
    const DRAG_THRESHOLD = 8;
    let pointerActive = false;
    let dragging = false;
    let suppressClick = false;
    let startX = 0;
    let startScroll = 0;
    let pointerId: number | null = null;

    const snapToNearest = () => {
      const step = getStep();
      if (step <= 0) return;
      const index = Math.round(container.scrollLeft / step);
      const maxScroll = Math.max(0, container.scrollWidth - container.clientWidth);
      const target = Math.max(0, Math.min(maxScroll, index * step));
      container.scrollTo({ left: target, behavior: 'smooth' });
    };

    const beginDrag = (e: PointerEvent) => {
      dragging = true;
      suppressClick = true;
      container.classList.add('is-dragging');
      try {
        container.setPointerCapture(e.pointerId);
      } catch {
        // ignore capture failures
      }
    };

    const endPointer = () => {
      if (!pointerActive) return;
      const wasDragging = dragging;
      pointerActive = false;
      dragging = false;
      pointerId = null;
      container.classList.remove('is-dragging');
      if (wasDragging) snapToNearest();
      updateArrows();
    };

    container.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType === 'touch' || e.button !== 0) return;
      pointerActive = true;
      dragging = false;
      suppressClick = false;
      pointerId = e.pointerId;
      startX = e.clientX;
      startScroll = container.scrollLeft;
    });

    container.addEventListener('pointermove', (e: PointerEvent) => {
      if (!pointerActive || e.pointerId !== pointerId) return;
      const dx = e.clientX - startX;
      if (!dragging) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        beginDrag(e);
      }
      container.scrollLeft = startScroll - dx;
    });

    container.addEventListener('pointerup', endPointer);
    container.addEventListener('pointercancel', endPointer);
    container.addEventListener('lostpointercapture', () => {
      if (pointerActive) endPointer();
    });

    // Only block navigation after an actual drag, not a normal click
    container.addEventListener('click', (e: MouseEvent) => {
      if (!suppressClick) return;
      e.preventDefault();
      e.stopPropagation();
      suppressClick = false;
    }, true);
  });
</script>
